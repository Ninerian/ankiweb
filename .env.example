# Optional shared-secret to gate access to the web UI. Leave unset for no password.
ANKIWEB_PASSWORD=

# Optional API key required by AnkiConnect-compatible clients calling the AC HTTP API.
ANKIWEB_AC_KEY=

# DNS-rebinding guard allowlist for the web app's Host header. Set to "*" to disable
# the check entirely (only safe on trusted networks, e.g. behind your own firewall).
ANKIWEB_ALLOWED_HOSTS=

# UI language/locale override (e.g. "en", "de"). Leave unset to use the default.
ANKIWEB_LANG=

# "Source" link shown on /about. AGPL-3.0-or-later requires offering Corresponding
# Source to users interacting with this app over a network beyond pure local/single-
# user use — set this to your repository/fork URL when hosting for others.
ANKIWEB_SOURCE_URL=

# Enable development routes (/dev/components gallery and /dev/progress/* streams).
# ANKIWEB_DEV=1
