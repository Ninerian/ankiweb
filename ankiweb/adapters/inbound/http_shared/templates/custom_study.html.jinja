<div class="custom-study">
  <h3>{{ tr.actions_custom_study() }}</h3>
  <div class="avail">
    New available: {{ avail_new }} &nbsp; Review available: {{ avail_rev }}
  </div>
  <form id="cs" onsubmit="return false">
    {% for v, t in radios %}<div>
        <label><input
            type="radio"
            name="r"
            value="{{ v }}"
            {% if v == 1 %}
              checked
            {% endif %}
            onchange="onRadio()"
          > {{ t }}</label>
      </div>{% endfor %}
    <div class="spinrow" style="margin:8px 0;">
      <span id="spinlabel"></span>
      <input
        type="number"
        id="spin"
        value="{{ spin_default }}"
        style="width:6em;"
      >
      <span id="spinsuffix"></span>
    </div>
    <div id="cramblock" style="display:none;">
      <div>
        {{ tr.browsing_sidebar_card_state() }}
        <select id="cramkind">
          {% for k, t in kinds %}<option value="{{ k }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
      <div style="margin-top:6px;">
        {{ tr.custom_study_require_one_or_more_of_these() }}
        <br>
        <select id="inc" multiple size="4">
          {% for t in tags %}<option value="{{ t }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
      <div style="margin-top:6px;">
        {{ tr.custom_study_select_tags_to_exclude() }}
        <br>
        <select id="exc" multiple size="4">
          {% for t in tags %}<option value="{{ t }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
    </div>
    <div style="margin-top:10px;">
      <button type="button" id="go" data-on:click__prevent="const payload = buildCsPayload(); @post('/custom-study/submit', {payload: payload})">
        {{ tr.custom_study_ok() }}
      </button>
      <button type="button" data-on:click__prevent="@post('/custom-study/cancel')">
        {{ tr.actions_cancel() }}
      </button>
    </div>
    <div id="err" style="color:#c00;margin-top:8px;"></div>
  </form>
</div>
<script>
  var CFG = {{ cfg_json | safe }};

  function selectedRadio() {
      var els = document.getElementsByName('r');
      for (var i = 0; i < els.length; i++)
          if (els[i].checked) return parseInt(els[i].value);
      return 1;
  }

  function onRadio() {
      var r = selectedRadio();
      var c = CFG[r];
      document.getElementById('spinlabel').textContent = c[0];
      document.getElementById('spin').value = c[1];
      document.getElementById('spin').min = c[3];
      document.getElementById('spinsuffix').textContent = c[2];
      document.getElementById('cramblock').style.display = (r === 6) ? '' : 'none';
  }

  function multiVals(id) {
      var out = [],
          el = document.getElementById(id);
      for (var i = 0; i < el.options.length; i++)
          if (el.options[i].selected) out.push(el.options[i].value);
      return out;
  }

  function buildCsPayload() {
      document.getElementById('err').textContent = '';
      var r = selectedRadio();
      var payload = {
          radio: r,
          value: parseInt(document.getElementById('spin').value || '0')
      };
      if (r === 6) {
          payload.cram_kind = parseInt(document.getElementById('cramkind').value);
          payload.include = multiVals('inc');
          payload.exclude = multiVals('exc');
      }
      return payload;
  }
  onRadio();
</script>
