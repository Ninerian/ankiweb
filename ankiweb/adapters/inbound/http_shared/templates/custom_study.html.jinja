<div class="custom-study mx-auto px-4 py-3 max-w-xl">
  <h3 class="text-xl font-bold mb-2">{{ tr.actions_custom_study() }}</h3>
  <div class="avail text-base-content/60 text-sm mb-3">
    New available: {{ avail_new }} &nbsp; Review available: {{ avail_rev }}
  </div>
  {# cfg_json is pre-serialized JSON; HTML-escape it so translated apostrophes do not close this single-quoted attribute. #}
  <form id="cs" onsubmit="return false" data-signals='{"radio": 1, "spin": {{ spin_default }}, "cfg": {{ cfg_json | e }}}'>
    {# Datastar v1.0.3 bind values are signal keys; omit the $ prefix used in expressions. #}
    {# Keep translation HTML escaped, but leave apostrophes literal in this text node. #}
    <div class="space-y-2 mb-3">
      {% for v, t in radios %}
        <div class="flex items-center gap-2 cursor-pointer">
          <input
            class="radio radio-primary radio-sm"
            type="radio"
            name="r"
            id="cs_r_{{ v }}"
            value="{{ v }}"
            {% if v == 1 %}
              checked
            {% endif %}
            data-bind="radio"
            data-on:change="$spin = $cfg[$radio][1]"
          >
          <label class="cursor-pointer text-sm" for="cs_r_{{ v }}">{{ t | e | replace('&#39;' | safe, "'" | safe) | safe }}</label>
        </div>
      {% endfor %}
    </div>
    <div class="spinrow my-3 flex items-center gap-2">
      <span id="spinlabel" class="text-sm" data-text="$cfg[$radio][0]"></span>
      <input
        class="input input-sm w-24"
        type="number"
        id="spin"
        value="{{ spin_default }}"
        data-bind="spin"
        data-attr="{min: $cfg[$radio][3]}"
      >
      <span id="spinsuffix" class="text-sm" data-text="$cfg[$radio][2]"></span>
    </div>
    <div id="cramblock" class="space-y-3 mb-3" style="display:none;" data-show="$radio == 6">
      <div>
        <label for="cramkind" class="block text-sm font-medium mb-1">{{ tr.browsing_sidebar_card_state() }}</label>
        <select id="cramkind" class="select select-sm w-full">
          {% for k, t in kinds %}<option value="{{ k }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
      <div>
        <label for="inc" class="block text-sm font-medium mb-1">{{ tr.custom_study_require_one_or_more_of_these() }}</label>
        <select id="inc" class="select select-sm w-full h-auto" multiple size="4">
          {% for t in tags %}<option value="{{ t }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
      <div>
        <label for="exc" class="block text-sm font-medium mb-1">{{ tr.custom_study_select_tags_to_exclude() }}</label>
        <select id="exc" class="select select-sm w-full h-auto" multiple size="4">
          {% for t in tags %}<option value="{{ t }}">{{ t }}</option>{%
            endfor
          %}
        </select>
      </div>
    </div>
    <div class="mt-4 flex items-center gap-2">
      <button class="btn btn-primary btn-sm" type="button" id="go" data-on:click__prevent="const payload = {radio: parseInt($radio), value: parseInt($spin || '0')}; if (parseInt($radio) === 6) { payload.cram_kind = parseInt(document.getElementById('cramkind').value); payload.include = multiVals('inc'); payload.exclude = multiVals('exc'); }; document.getElementById('err').textContent = ''; @post('/custom-study/submit', {payload: payload})">
        {{ tr.custom_study_ok() }}
      </button>
      <button class="btn btn-neutral btn-sm" type="button" data-on:click__prevent="@post('/custom-study/cancel')">
        {{ tr.actions_cancel() }}
      </button>
    </div>
    <div id="err" class="text-error text-sm font-semibold mt-2"></div>
  </form>
</div>
<script>
  // Keep DOM reads for cramkind and the multi-selects; multi-select values have no scalar signal binding.
  function multiVals(id) {
      var out = [],
          el = document.getElementById(id);
      for (var i = 0; i < el.options.length; i++)
          if (el.options[i].selected) out.push(el.options[i].value);
      return out;
  }
</script>
