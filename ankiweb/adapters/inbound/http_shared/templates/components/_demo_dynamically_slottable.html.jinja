{% from "components/dynamically_slottable.html.jinja" import dynamically_slottable %}
{% from "components/item.html.jinja" import item %}
{% from "components/button_group_item.html.jinja" import button_group_item %}
{% from "components/button_group.html.jinja" import button_group %}

<div class="d-flex flex-column gap-4" id="demo-dynamically-slottable">
    <div class="card p-3">
        <h5 class="card-title">1. Static & Dynamic Slotted Items with Item Wrapper</h5>
        <p class="text-muted">Demonstrates default caller slot items alongside dynamically slotted items with detach (hidden) semantics.</p>
        <div class="border p-3 d-flex gap-2">
            {% call dynamically_slottable(
                items=[
                    {"id": "dyn-item-1", "content": '<span class="badge bg-primary p-2">Dynamic Item 1</span>'},
                    {"id": "dyn-item-detached", "detach": true, "content": '<span class="badge bg-danger p-2">Dynamic Detached</span>'},
                    {"id": "dyn-item-2", "content": '<span class="badge bg-success p-2">Dynamic Item 2</span>'}
                ],
                slot_host=item
            ) %}
                {% call item(id="static-item-1") %}
                    <span class="badge bg-secondary p-2">Static Slot Item</span>
                {% endcall %}
            {% endcall %}
        </div>
    </div>

    <div class="card p-3">
        <h5 class="card-title">2. Dynamically Slotted Toolbar inside ButtonGroup</h5>
        <p class="text-muted">Mirrors upstream Anki TemplateButtons: ButtonGroup hosting DynamicallySlottable with ButtonGroupItem.</p>
        {% call button_group() %}
            {% call dynamically_slottable(
                items=[
                    {"id": "btn-bold", "props": {"position": "start"}, "content": '<button type="button" class="btn btn-outline-secondary btn-sm">Bold</button>'},
                    {"id": "btn-italic", "props": {"position": "center"}, "content": '<button type="button" class="btn btn-outline-secondary btn-sm">Italic</button>'},
                    {"id": "btn-detached", "detach": true, "props": {"position": "center"}, "content": '<button type="button" class="btn btn-outline-danger btn-sm">Hidden Action</button>'},
                    {"id": "btn-underline", "props": {"position": "end"}, "content": '<button type="button" class="btn btn-outline-secondary btn-sm">Underline</button>'}
                ],
                slot_host=button_group_item
            ) %}
            {% endcall %}
        {% endcall %}
    </div>

    <div class="card p-3" data-signals="{ dynShowExtra: false, dynCount: 3 }">
        <h5 class="card-title">3. Interactive Add / Remove / Reorder with Datastar</h5>
        <p class="text-muted">Tests dynamic client-side item manipulation (add new item, remove item, reverse ordering, toggle detach) via Datastar reactivity.</p>
        
        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-sm btn-outline-primary" id="btn-dyn-add" data-on:click="$dynCount = Math.min(5, $dynCount + 1)">
                Add Item
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" id="btn-dyn-remove" data-on:click="$dynCount = Math.max(0, $dynCount - 1)">
                Remove Last
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-dyn-toggle" data-on:click="$dynShowExtra = !$dynShowExtra">
                Toggle Extra (Detach)
            </button>
        </div>

        <div class="border p-3 d-flex flex-wrap gap-2 align-items-center" id="dyn-items-container">
            {% call dynamically_slottable() %}
                <div class="item" data-show="$dynCount >= 1" id="dyn-slot-1">
                    <span class="badge bg-info p-2">Item 1 (Alpha)</span>
                </div>
                <div class="item" data-show="$dynCount >= 2" id="dyn-slot-2">
                    <span class="badge bg-info p-2">Item 2 (Beta)</span>
                </div>
                <div class="item" data-show="$dynCount >= 3" id="dyn-slot-3">
                    <span class="badge bg-info p-2">Item 3 (Gamma)</span>
                </div>
                <div class="item" data-show="$dynCount >= 4" style="display: none;" id="dyn-slot-4">
                    <span class="badge bg-info p-2">Item 4 (Delta)</span>
                </div>
                <div class="item" data-show="$dynCount >= 5" style="display: none;" id="dyn-slot-5">
                    <span class="badge bg-info p-2">Item 5 (Epsilon)</span>
                </div>
                <div class="item" data-show="$dynShowExtra" style="display: none;" id="dyn-slot-extra">
                    <span class="badge bg-warning text-dark p-2" id="dyn-extra-badge">Extra Dynamic Slotted Item</span>
                </div>
            {% endcall %}
        </div>
    </div>
</div>
