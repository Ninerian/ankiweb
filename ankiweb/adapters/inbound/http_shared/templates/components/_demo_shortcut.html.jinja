{% from "components/shortcut.html.jinja" import shortcut %}

<div class="card bg-base-100 border border-base-300 p-4" data-signals="{ shortcutTriggerCount: 0, lastShortcutKey: 'none', helperModalOpen: false }">
    <h5 class="card-title text-base-content font-bold mb-1">Shortcut Demonstrations</h5>
    <p class="text-base-content/60 text-sm mb-3">Global window keyboard shortcuts with Datastar reactive binders. Press the hotkeys below or test them via automation.</p>

    {# 1. Control+Enter (or Cmd+Enter on Mac) #}
    {{ shortcut(combination="Control+Enter", action="$shortcutTriggerCount++; $lastShortcutKey = 'Control+Enter'") }}

    {# 2. Single key 'j' #}
    {{ shortcut(combination="j", action="$shortcutTriggerCount++; $lastShortcutKey = 'j'") }}

    {# 3. Single key 'k' #}
    {{ shortcut(combination="k", action="$shortcutTriggerCount++; $lastShortcutKey = 'k'") }}

    {# 4. Escape #}
    {{ shortcut(combination="Escape", action="$lastShortcutKey = 'Escape'; $helperModalOpen = false") }}

    <div class="flex flex-wrap items-center gap-3 mt-2">
        <div class="border border-base-300 rounded-box p-2 bg-base-200">
            <span class="font-bold">Total triggers: </span>
            <span id="demo-shortcut-count" class="badge badge-primary" data-text="$shortcutTriggerCount">0</span>
        </div>
        <div class="border border-base-300 rounded-box p-2 bg-base-200">
            <span class="font-bold">Last key combination: </span>
            <span id="demo-shortcut-last" class="badge badge-neutral" data-text="$lastShortcutKey">none</span>
        </div>
    </div>

    <div class="mt-3 flex gap-2 flex-wrap">
        <span class="badge badge-info">Ctrl+Enter</span>
        <span class="badge badge-info">j</span>
        <span class="badge badge-info">k</span>
        <span class="badge badge-info">Escape</span>
    </div>
</div>
