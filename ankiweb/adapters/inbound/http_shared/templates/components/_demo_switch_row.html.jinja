{% from "components/switch_row.html.jinja" import switch_row %}

<div class="flex flex-col gap-3" style="max-width: 500px;" data-signals="{ swRow1: true, swRowDef: false }">
    <div class="border border-base-300 rounded-box p-2 bg-base-100">
        {% call switch_row(signal="$swRow1", signal_default="$swRowDef", default_value=false) %}
            <div>
                <strong>Show remaining due count</strong>
                <div class="text-base-content/60 text-sm">Displays the count during card review</div>
            </div>
        {% endcall %}
        <div class="mt-2 text-sm text-base-content/60">
            Switch state: <span class="badge badge-neutral" data-text="$swRow1 ? 'ON' : 'OFF'">ON</span>
            (Default is OFF; click revert button on the right to revert)
        </div>
    </div>

    <div class="border border-base-300 rounded-box p-2 bg-base-100">
        {% call switch_row(value=false, default_value=false) %}
            <div>
                <strong>Auto-play audio</strong>
                <div class="text-base-content/60 text-sm">Matching default value (revert button hidden)</div>
            </div>
        {% endcall %}
    </div>

    <div class="border border-base-300 rounded-box p-2 bg-base-100">
        {% call switch_row(value=true, default_value=true, disabled=true) %}
            <div>
                <strong>Hardware acceleration</strong>
                <div class="text-base-content/60 text-sm">Disabled switch row</div>
            </div>
        {% endcall %}
    </div>
</div>
