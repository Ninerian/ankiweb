{% macro backend_progress(
    progress_signal="progressRunning",
    label_signal="progressLabel",
    percent_signal="progressPercent",
    done_signal="progressDone",
    error_signal="progressError",
    night_mode=false,
    class_="",
    label="Loading..."
) %}
{#
  BackendProgressIndicator component: Ported from ts/lib/components/BackendProgressIndicator.svelte.
  Upstream markup:
  {#if !result}
    <div class="progress">
      <div class="spinner" class:nightMode={$pageTheme.isDark}>
        <div></div><div></div><div></div><div></div>
      </div>
      <div id="label">{label}</div>
    </div>
  {/if}

  In Jinja + Datastar:
  - Renders the spinner (loading.io CSS 4-segment ring) and the progress label.
  - Dynamically reactive via Datastar signals:
    - data-show: hides when task is completed or not running
    - data-text: displays live progress label string
  - Night mode class reactive to night_mode or dark theme.
#}
<div
    class="anki-backend-progress-container flex flex-col items-center justify-center gap-3 p-4 w-full {{ class_ }}"
    {% if progress_signal %}
    data-show="${{ progress_signal }}"
    {% endif %}
    {% for k, v in kwargs.items() %} {{ k }}="{{ v }}"{% endfor %}
>
    <div
        class="radial-progress text-primary font-bold text-sm"
        style="--size: 5rem; --thickness: 6px; --value: 0;"
        {% if percent_signal %}
        data-style:--value="${{ percent_signal }} || 0"
        data-attr:aria-valuenow="${{ percent_signal }} || 0"
        {% else %}
        data-style:--value="0"
        data-attr:aria-valuenow="0"
        {% endif %}
        role="progressbar"
    >
        {% if percent_signal %}
        <span data-show="(${{ percent_signal }} || 0) > 0" data-text="'' + (${{ percent_signal }} || 0) + '%'">0%</span>
        <span class="loading loading-spinner loading-md text-primary" data-show="!${{ percent_signal }} || (${{ percent_signal }} || 0) === 0"></span>
        {% else %}
        <span class="loading loading-spinner loading-md text-primary"></span>
        {% endif %}
    </div>
    <div id="label" class="progress-label text-sm text-base-content/80 text-center font-medium"
         {% if label_signal %}
         data-text="${{ label_signal }}"
         {% endif %}
    >{{ label }}</div>
</div>
{% endmacro %}
