{# Modal component ported from ts/lib/components/Modal.svelte #}
{#
  Modal wraps Bootstrap 5 Modal dialog.
  Slots:
    header: rendered inside .modal-content
    body: rendered inside .modal-content
    footer: rendered inside .modal-content
    default: rendered directly inside .modal-content if no named slot callers

  Props:
    modal_key / id: Unique DOM identifier for modal (default random/generated)
    dialog_class: Extra class for .modal-dialog (e.g. "modal-lg", "modal-dialog-centered")
    class_: Extra class on root .modal
    backdrop: Backdrop option (true, false, "static") - default true
    keyboard: Allow escape key closing - default false upstream
#}
{% macro modal(
    modal_key="",
    dialog_class="",
    class_="",
    backdrop=true,
    keyboard=false,
    id=""
) -%}
{% set mid = id or modal_key or ("modal_" ~ range(1000, 999999)|random) %}
<div
    class="modal fade{% if class_ %} {{ class_ }}{% endif %}"
    id="{{ mid }}"
    tabindex="-1"
    aria-labelledby="{{ mid }}Label"
    aria-hidden="true"
    {% if not keyboard %}data-bs-keyboard="false"{% endif %}
    {% if backdrop == 'static' %}data-bs-backdrop="static"{% elif not backdrop %}data-bs-backdrop="false"{% endif %}
    {% for k, v in kwargs.items() %}{{ k|replace('_', '-') }}="{{ v }}" {% endfor %}
>
    <div class="modal-dialog{% if dialog_class %} {{ dialog_class }}{% endif %}">
        <div class="modal-content">
            {{ caller() if caller else '' }}
        </div>
    </div>
</div>
{%- endmacro %}
