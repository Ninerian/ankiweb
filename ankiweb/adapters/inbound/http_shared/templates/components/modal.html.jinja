{# Modal component ported from ts/lib/components/Modal.svelte #}
{#
  Modal wraps daisyUI 5 <dialog class="modal">.
  Slots:
    header: rendered inside .modal-box
    body: rendered inside .modal-box
    footer: rendered inside .modal-box
    default: rendered directly inside .modal-box if no named slot callers

  Props:
    modal_key / id: Unique DOM identifier for modal (default random/generated)
    dialog_class: Extra class for modal container / box (e.g. "max-w-3xl", "modal-bottom sm:modal-middle")
    class_: Extra class on root <dialog class="modal">
    backdrop: Backdrop option (true, false, "static") - default true
    keyboard: Allow escape key closing - default false upstream
#}
{% macro modal(
    modal_key="",
    dialog_class="",
    class_="",
    backdrop=true,
    keyboard=false,
    id=""
) -%}
{% set mid = id or modal_key or ("modal_" ~ range(1000, 999999)|random) %}
<dialog
    class="modal{% if class_ %} {{ class_ }}{% endif %}"
    id="{{ mid }}"
    aria-labelledby="{{ mid }}Label"
    {% if not keyboard %}
    oncancel="event.preventDefault()"
    {% endif %}
    {% for k, v in kwargs.items() %}{{ k|replace('_', '-') }}="{{ v }}" {% endfor %}
>
    <div class="modal-box modal-content{% if dialog_class %} {{ dialog_class }}{% endif %}">
        {{ caller() if caller else '' }}
    </div>
    {% if backdrop and backdrop != 'static' %}
    <form method="dialog" class="modal-backdrop">
        <button type="submit" aria-label="Close">close</button>
    </form>
    {% endif %}
</dialog>
{%- endmacro %}
