{% from "components/col.html.jinja" import col %}

<div class="border border-base-300 p-2 mb-2 rounded-box" style="--cols: 3; --col-size: 1;">
    <p class="text-base-content/60 text-sm mb-1">Col breakpoint="xs":</p>
    {% call col(breakpoint="xs", class_="bg-info/20 p-2 rounded") %}
        <span>Col XS (1/3)</span>
    {% endcall %}
</div>

<div class="border border-base-300 p-2 mb-2 rounded-box" style="--cols: 2; --col-size: 1;">
    <p class="text-base-content/60 text-sm mb-1">Col breakpoint="md":</p>
    {% call col(breakpoint="md", class_="bg-warning/20 p-2 rounded") %}
        <span>Col MD (1/2 at md+)</span>
    {% endcall %}
</div>
