{% from "components/portal.html.jinja" import portal %}

<div class="flex flex-col gap-4" data-signals="{ demoPortalCount: 0, demoPortalOpen: false }">
    <div class="card bg-base-100 border border-base-300 p-4">
        <h5 class="card-title text-base-content font-bold mb-1">1. Teleported Element to Target Container</h5>
        <p class="text-base-content/60 text-sm mb-3">
            Demonstrates teleporting a node to <code>#portal-destination-box</code>.
            Datastar reactivity (counter and toggle) is verified to continue working after teleportation.
        </p>
        
        <div class="border-2 border-primary rounded-box p-3 mb-3 bg-base-200" id="portal-destination-box">
            <strong>Target Destination Box (#portal-destination-box):</strong>
            <div class="text-base-content/60 text-xs">Teleported content will appear below this line:</div>
        </div>

        <div class="border border-dashed border-base-300 p-3 rounded-box" id="portal-declaration-origin">
            <strong>Declaration Origin Container:</strong>
            <p class="text-xs text-base-content/60 mb-2">The portal macro is declared right here inside this dashed box.</p>
            
            {% call portal(target="#portal-destination-box", id="teleported-portal-demo", class_="alert alert-success mt-2 mb-0 shadow-sm") %}
                <div class="flex items-center justify-between w-full">
                    <div>
                        <strong>Teleported Node:</strong> I live in <code>#portal-destination-box</code>!
                        <div class="mt-1">
                            Counter: <strong data-text="$demoPortalCount">0</strong>
                        </div>
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-primary"
                                id="btn-portal-increment"
                                data-on:click="$demoPortalCount++">
                            Increment from inside portal
                        </button>
                    </div>
                </div>
            {% endcall %}
        </div>
    </div>

    <div class="card bg-base-100 border border-base-300 p-4">
        <h5 class="card-title text-base-content font-bold mb-1">2. Inline Fallback (target=none)</h5>
        <p class="text-base-content/60 text-sm mb-3">When <code>target=none</code>, content renders inline without teleporting:</p>
        {% call portal(target=none) %}
            <div class="alert alert-info mb-0">
                This content remains directly inline at its declared location.
            </div>
        {% endcall %}
    </div>
</div>
