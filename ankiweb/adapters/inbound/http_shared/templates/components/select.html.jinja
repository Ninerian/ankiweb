{# Select component ported from ts/lib/components/Select.svelte #}
{#
  Select contract:
  - list: list of items/options, each either a string or dict { "content": ..., "value": ..., "disabled": ... }
  - value: current value (bound to Datastar signal)
  - signal: Datastar signal expression (e.g. "$mySelectValue" or "mySelectValue")
  - label: display text when selected (or empty/none to derive from list)
  - disabled: boolean (disabled select button)
  - tooltip: tooltip string
  - rtl: boolean for right-to-left layout
  - id: DOM element id
  - class_: extra class on root select container
  
  Accessible ARIA combobox pattern with listbox popover:
  - Supports keyboard navigation: ArrowUp/ArrowDown, Home/End, Enter/Space to select, Escape to close.
  - Value changes update the Datastar signal.
#}
{% from "components/with_floating.html.jinja" import with_floating %}
{% from "components/popover.html.jinja" import popover %}
{% from "components/select_option.html.jinja" import select_option %}
{% from "components/icon_constrain.html.jinja" import icon_constrain %}
{% from "components/icon.html.jinja" import icon %}

{% macro select(
    list=[],
    value=none,
    signal="",
    label="",
    disabled=false,
    tooltip="",
    rtl=false,
    id=none,
    class_=""
) %}
{% set sel_id = id or ("sel_" ~ range(100000, 999999)|random) %}
{% set sig_name = signal|replace('$', '') %}
{% set open_sig = sel_id ~ "_open" %}
{% set focused_sig = sel_id ~ "_focused" %}

<div
    class="select-root-wrapper"
    style="display: inline-block; min-width: 140px; position: relative;"
    id="{{ sel_id }}_wrapper"
    data-signals="{ {{ open_sig }}: false, {{ focused_sig }}: 0 }"
    {% for k, v in kwargs.items() %}{{ k|replace('_', '-') }}="{{ v }}" {% endfor %}
>
    {# Custom combobox button matching upstream Select.svelte #}
    <div
        id="{{ sel_id }}"
        class="select-container{% if class_ %} {{ class_ }}{% endif %}{% if rtl %} rtl{% endif %}{% if disabled %} disabled{% endif %}"
        {% if tooltip %}title="{{ tooltip }}"{% endif %}
        tabindex="{{ -1 if disabled else 0 }}"
        role="combobox"
        aria-controls="{{ sel_id }}_popover"
        data-attr:aria-expanded="${{ open_sig }} ? 'true' : 'false'"
        aria-activedescendant="{{ sel_id }}_focused"
        {% if not disabled %}
        data-on:click="${{ open_sig }} = !${{ open_sig }}"
        data-on:keydown="
            if (evt.key === 'ArrowDown') {
                evt.preventDefault();
                if (!${{ open_sig }}) {
                    ${{ open_sig }} = true;
                } else {
                    ${{ focused_sig }} = Math.min({{ list|length - 1 }}, ${{ focused_sig }} + 1);
                }
            } else if (evt.key === 'ArrowUp') {
                evt.preventDefault();
                if (!${{ open_sig }}) {
                    ${{ open_sig }} = true;
                } else {
                    ${{ focused_sig }} = Math.max(0, ${{ focused_sig }} - 1);
                }
            } else if (evt.key === 'Home') {
                evt.preventDefault();
                ${{ focused_sig }} = 0;
            } else if (evt.key === 'End') {
                evt.preventDefault();
                ${{ focused_sig }} = {{ list|length - 1 }};
            } else if (evt.key === 'Enter' || evt.key === ' ') {
                evt.preventDefault();
                if (${{ open_sig }}) {
                    const opts = el.parentElement.querySelectorAll('.select-option-item');
                    const targetOpt = opts[${{ focused_sig }}];
                    if (targetOpt && !targetOpt.hasAttribute('disabled')) {
                        targetOpt.click();
                    } else {
                        ${{ open_sig }} = false;
                    }
                } else {
                    ${{ open_sig }} = true;
                }
            } else if (evt.key === 'Escape') {
                evt.preventDefault();
                ${{ open_sig }} = false;
            }
        "
        {% endif %}
    >
        <div class="inner">
            <div class="label" id="{{ sel_id }}_label">
                {% if label %}
                    {{ label }}
                {% elif sig_name %}
                    <span data-text="${{ sig_name }}">{{ value }}</span>
                {% else %}
                    {{ value }}
                {% endif %}
            </div>
        </div>
        <div class="chevron">
            {% call icon_constrain(icon_size=80) %}
                {{ icon(name="chevronDown") }}
            {% endcall %}
        </div>
    </div>

    {# Popover listbox #}
    <div
        class="floating select-popover-floating"
        id="{{ sel_id }}_popover_container"
        data-class="{'show': ${{ open_sig }}}"
        data-show="${{ open_sig }}"
        data-on:click__window="!el.contains(evt.target) && !document.getElementById('{{ sel_id }}').contains(evt.target) && (${{ open_sig }} = false)"
        data-on:keydown__window="evt.key === 'Escape' && (${{ open_sig }} = false)"
        style="position: absolute; top: 100%; left: 0; min-width: 100%; z-index: 890; margin-top: 2px;"
    >
        {% call popover(id=sel_id ~ "_popover", scrollable=true, placement="bottom", class_="w-full") %}
            {% for item in list %}
                {% set item_val = item.value if item is mapping else item %}
                {% set item_lbl = item.content if item is mapping else item %}
                {% set item_dis = item.disabled if item is mapping and item.disabled is defined else false %}
                {% set item_idx = loop.index0 %}
                
                <button
                    type="button"
                    role="option"
                    tabindex="-1"
                    class="select-option-item dropdown-item{% if rtl %} rtl{% endif %}"
                    {% if item_dis %}disabled{% endif %}
                    data-class="{'active': ${{ sig_name }} === '{{ item_val }}', 'focus': ${{ focused_sig }} === {{ item_idx }}}"
                    {% if not item_dis %}
                    onclick="
                        const wrapper = this.closest('.select-root-wrapper');
                        const sel = wrapper.querySelector('[role=combobox]');
                        const pop = wrapper.querySelector('.select-popover-floating');
                        const label = wrapper.querySelector('.label');
                        if (label) label.textContent = '{{ item_lbl|e }}';
                        sel.setAttribute('aria-expanded', 'false');
                        pop.classList.remove('show');
                        wrapper.querySelectorAll('.select-option-item').forEach(o => o.classList.remove('active', 'focus'));
                        this.classList.add('active');
                        const sigMirror = document.querySelector('[data-signals*=\'{{ sig_name }}\'] [data-text=\'${{ sig_name }}\']');
                        if (sigMirror) sigMirror.textContent = '{{ item_val }}';
                    "
                    {% endif %}
                    data-on:click="{% if not item_dis %}${{ sig_name }} = '{{ item_val }}'; ${{ focused_sig }} = {{ item_idx }}; ${{ open_sig }} = false; const lbl = document.getElementById('{{ sel_id }}_label'); if (lbl) lbl.textContent = '{{ item_lbl|replace('\'', '\\\'') }}';{% else %}void 0{% endif %}"
                    data-on:mouseenter="${{ focused_sig }} = {{ item_idx }}"
                >
                    {{ item_lbl }}
                </button>
            {% endfor %}
        {% endcall %}
</div>
{% endmacro %}
