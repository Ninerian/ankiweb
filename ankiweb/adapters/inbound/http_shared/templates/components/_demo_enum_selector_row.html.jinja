{% from "components/enum_selector_row.html.jinja" import enum_selector_row %}

<div class="d-flex flex-column gap-3" style="max-width: 600px;" data-signals="{ timerMode: 'custom', defaultTimerMode: 'standard' }">
    <div class="border p-2 rounded">
        {% call enum_selector_row(
            signal="$timerMode",
            signal_default="$defaultTimerMode",
            default_value="standard",
            choices=[
                {"value": "standard", "label": "Standard timer"},
                {"value": "custom", "label": "Custom duration"},
                {"value": "disabled", "label": "No timer"}
            ]
        ) %}
            <div>
                <strong>Timer Mode</strong>
                <div class="text-secondary small">Controls question review timer behavior</div>
            </div>
        {% endcall %}
        <div class="mt-2 small text-secondary">
            Selected: <code data-text="$timerMode">custom</code> (revert button visible because it differs from standard)
        </div>
    </div>

    <div class="border p-2 rounded">
        {% call enum_selector_row(
            value="asc",
            default_value="asc",
            choices=[
                {"value": "asc", "label": "Ascending order"},
                {"value": "desc", "label": "Descending order"}
            ]
        ) %}
            <div>
                <strong>Sort Order</strong>
                <div class="text-secondary small">Same as default (revert button hidden)</div>
            </div>
        {% endcall %}
    </div>

    <div class="border p-2 rounded">
        {% call enum_selector_row(
            value="locked",
            default_value="locked",
            disabled=true,
            choices=[{"value": "locked", "label": "Locked setting"}]
        ) %}
            <div>
                <strong>Locked setting</strong>
                <div class="text-secondary small">Disabled selector row</div>
            </div>
        {% endcall %}
    </div>
</div>
