{# IconButton: daisyUI icon-only button (btn btn-square). Replaces ts/lib/components/IconButton.svelte.
   - primary: filled btn-primary
   - active: pressed, primary-filled state (btn-primary btn-active); toggle both classes at runtime
   - size: daisyUI button size modifier (xs, sm, md, lg); xs is 1.5rem, the former 26px button
   - flip_x: mirror the icon horizontally
   - tooltip: rendered as title (shown by the daisyUI tooltip shim) #}
{% macro icon_button(
    id=none,
    class_="",
    tooltip=none,
    primary=false,
    active=false,
    disabled=false,
    tabbable=false,
    size="xs",
    flip_x=false
) %}
  <button
    {% if id %}id="{{ id }}"{% endif %}
    class="btn btn-square btn-{{ size }}{% if primary or active %} btn-primary{% endif %}{% if active %} btn-active{% endif %}{% if flip_x %} [&_svg]:-scale-x-100{% endif %}{% if class_ %} {{ class_ }}{% endif %}"
    {% if tooltip %}title="{{ tooltip }}"{% endif %}
    {% if disabled %}disabled{% endif %}
    tabindex="{% if tabbable %}0{% else %}-1{% endif %}"
    {% for k, v in kwargs.items() %}{{ k }}="{{ v }}" {% endfor %}
  >
    {% if caller %}{{ caller() }}{% endif %}
  </button>
{% endmacro %}
