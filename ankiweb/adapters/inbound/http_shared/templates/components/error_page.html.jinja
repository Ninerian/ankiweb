{% macro error_page(error=none, message="", class_="") -%}
{% set error_msg = message or (error.message if error is mapping or error is sequence or error is not string and error.message is defined else error)|string %}
<div class="error-box alert alert-error shadow-sm flex items-center justify-between gap-4{% if class_ %} {{ class_ }}{% endif %}"{% for k, v in kwargs.items() %} {{ k|replace('_', '-') }}="{{ v }}"{% endfor %}>
    <p class="error-text m-0 text-sm font-semibold">{{ error_msg }}</p>
    <button class="btn btn-sm btn-neutral" type="button" data-on:click="window.close ? window.close() : null">{{ tr.help_ok() }}</button>
</div>
{%- endmacro %}
