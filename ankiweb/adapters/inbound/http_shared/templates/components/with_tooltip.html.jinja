{# WithTooltip component ported from ts/lib/components/WithTooltip.svelte #}
{#
  WithTooltip wraps an element or slot with daisyUI 5 tooltip classes.
  Note: DaisyUI tooltips display plain text via CSS `attr(data-tip)`. If `html` is true
  or HTML content is passed, tags are safely stripped with striptags so raw markup is not rendered.
  Props:
    tooltip: Tooltip content string
    trigger: kept for signature compatibility
    placement: "auto" | "top" | "bottom" | "left" | "right" (default: "top")
    html: kept for signature compatibility (tags stripped safely if true)
    offset: kept for signature compatibility
    show_delay: kept for signature compatibility
    hide_delay: kept for signature compatibility
    as_element: wrapper tag ("span", "div", or empty string to attach to caller if caller is element)
    class_: extra class
#}
{% macro with_tooltip(
    tooltip="",
    trigger="hover focus",
    placement="top",
    html=true,
    offset="0,0",
    show_delay=0,
    hide_delay=0,
    as_element="span",
    class_=""
) -%}
{% set placement_class = "tooltip-top" if placement in ["top", "auto", ""] else ("tooltip-bottom" if placement == "bottom" else ("tooltip-left" if placement == "left" else "tooltip-right")) %}
{% set tip_text = (tooltip|striptags) if html else tooltip %}
{% if as_element %}
<{{ as_element }}
    class="tooltip {{ placement_class }}{% if class_ %} {{ class_ }}{% endif %}"
    data-tip="{{ tip_text }}"
    {% for k, v in kwargs.items() %}{{ k|replace('_', '-') }}="{{ v }}" {% endfor %}
>
    {{ caller() if caller else '' }}
</{{ as_element }}>
{% else %}
    {{ caller() if caller else '' }}
{% endif %}
{%- endmacro %}
