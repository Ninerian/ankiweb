{% from "components/enum_selector.html.jinja" import enum_selector %}

<div class="flex flex-col gap-3 max-w-xs" data-signals="{ selectedDeck: 'deck2' }">
    <div>
        <label class="label font-medium mb-1">Deck Selection (signal bound)</label>
        {{ enum_selector(
            signal="$selectedDeck",
            choices=[
                {"value": "deck1", "label": "Default Deck"},
                {"value": "deck2", "label": "Japanese Vocabulary"},
                {"value": "deck3", "label": "Anatomy & Physiology (Disabled)"}
            ],
            disabled_choices=["deck3"]
        ) }}
        <span class="text-base-content/60 text-xs block mt-1">Current signal value: <code data-text="$selectedDeck">deck2</code></span>
    </div>

    <div>
        <label class="label font-medium mb-1">Static Pre-selected (deck1)</label>
        {{ enum_selector(
            value="deck1",
            choices=[
                {"value": "deck1", "label": "Default Deck"},
                {"value": "deck2", "label": "Japanese Vocabulary"}
            ]
        ) }}
    </div>

    <div>
        <label class="label font-medium mb-1">Entirely Disabled Selector</label>
        {{ enum_selector(
            value="deck1",
            disabled=true,
            choices=[{"value": "deck1", "label": "Locked Option"}]
        ) }}
    </div>
</div>
