{% from "components/item_chooser.html.jinja" import item_chooser %}

{% set sample_items = [
    {"id": 1, "name": "Apple"},
    {"id": 2, "name": "Banana \"Special\" & 'Quoted' <Tag> \\Slash 日本語"},
    {"id": 3, "name": "Cherry"},
    {"id": 4, "name": "Date \"Delight\""},
    {"id": 5, "name": "Elderberry & Friends <cool>"},
    {"id": 6, "name": "Fig"},
    {"id": 7, "name": "Grape \\ Wine"}
] %}

<div class="border p-3 mb-4 rounded" data-signals="{{ ({'item_chooser_result': 2}|tojson).__str__() }}">
    <h5>1. Standard ItemChooser with Search & Keyboard Navigation</h5>
    <p class="text-muted small">
        Click to open modal, filter by typing in the search box, use Arrow keys + Enter to select, or Escape to close.
    </p>

    <div style="max-width: 300px;">
        {{ item_chooser(
            title="Choose Fruit",
            items=sample_items,
            selected_id=2,
            icon="mdiBookOutline",
            key_combination="Alt+F",
            tooltip="Choose Fruit (Alt+F)",
            id="demo_item_chooser",
            on_change="$item_chooser_result = evt.detail.id;"
        ) }}
    </div>

    <div class="mt-3 small">
        Selected Result (Signal): <strong id="demo_item_chooser_result_output" data-text="$item_chooser_result">2</strong>
        | Button text: <strong id="demo_item_chooser_button_text">{{ sample_items[1].name }}</strong>
    </div>
</div>
