{% from "components/popover.html.jinja" import popover %}
{% from "components/floating_arrow.html.jinja" import floating_arrow %}

<div class="border border-base-300 rounded-box p-4 mb-4 bg-base-100">
    <h5 class="font-bold text-lg mb-2">1. Popover with Placement Bottom and Floating Arrow (daisyUI Dropdown Card)</h5>
    <div class="dropdown dropdown-bottom dropdown-open">
        <div tabindex="0" role="button" class="btn btn-outline btn-primary mb-2" id="popoverAnchorBtn">
            Reference Target
        </div>
        <div tabindex="0" class="dropdown-content card card-sm bg-base-100 shadow-xl border border-base-300 z-50 w-64 text-base-content relative" id="demoPopoverBottom" role="listbox">
            {{ floating_arrow(style="position: absolute; top: -5px; left: 20px; transform: rotate(45deg);") }}
            <div class="card-body p-3">
                <strong id="demoPopoverBottomTitle" class="card-title text-base mb-0">Popover Title</strong>
                <p class="text-sm mb-0 mt-1" id="demoPopoverBottomText">Standard elevation-8 styled popover container.</p>
            </div>
        </div>
    </div>
</div>

<div class="border border-base-300 rounded-box p-4 bg-base-100">
    <h5 class="font-bold text-lg mb-2">2. Scrollable Popover with Custom Content</h5>
    <div class="dropdown dropdown-right dropdown-open">
        <div tabindex="0" role="button" class="btn btn-outline mb-2">
            Right Popover
        </div>
        <div tabindex="0" class="dropdown-content card card-sm bg-base-100 shadow-xl border border-base-300 z-50 w-64 text-base-content" id="demoPopoverScrollable">
            <div class="card-body p-3 max-h-60 overflow-y-auto" id="demoPopoverScrollableContent">
                <div class="font-bold mb-2">Scrollable List</div>
                <ul class="menu p-0">
                    {% for i in range(1, 15) %}
                        <li class="border-b border-base-300 text-sm"><a>Scroll item {{ i }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
