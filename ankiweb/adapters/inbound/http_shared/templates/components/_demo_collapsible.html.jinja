{% from "components/collapsible.html.jinja" import collapsible %}

<div class="flex flex-col gap-4" data-signals="{ demoCollapsible1: false, demoCollapsible2: true, demoCollapsibleDisplay: false }">
    <div class="card bg-base-100 border border-base-300 p-4">
        <h5 class="card-title text-base-content font-bold mb-2">1. Animated Collapsible (Expanded by default)</h5>
        <div class="mb-2">
            <button type="button" class="btn btn-outline btn-primary btn-sm"
                    id="btn-toggle-collapsible-1"
                    data-on:click="$demoCollapsible1 = !$demoCollapsible1">
                Toggle Collapse (<span data-text="$demoCollapsible1 ? 'Show' : 'Hide'">Hide</span>)
            </button>
        </div>
        {% call collapsible(collapse=false, animated=true, signal_name="demoCollapsible1", id="demo-collapsible-1") %}
            <div class="p-3 bg-base-200 border border-base-300 rounded-box">
                <p class="mb-0">This is collapsible content. It smoothly animates height when toggled using CSS grid-template-rows.</p>
                <span class="text-base-content/60 text-sm">Line 2 of collapsible content to provide realistic height.</span>
            </div>
        {% endcall %}
    </div>

    <div class="card bg-base-100 border border-base-300 p-4">
        <h5 class="card-title text-base-content font-bold mb-2">2. Animated Collapsible (Collapsed by default)</h5>
        <div class="mb-2">
            <button type="button" class="btn btn-outline btn-primary btn-sm"
                    id="btn-toggle-collapsible-2"
                    data-on:click="$demoCollapsible2 = !$demoCollapsible2">
                Toggle Collapse (<span data-text="$demoCollapsible2 ? 'Show' : 'Hide'">Show</span>)
            </button>
        </div>
        {% call collapsible(collapse=true, animated=true, signal_name="demoCollapsible2", id="demo-collapsible-2") %}
            <div class="p-3 bg-base-200 border border-base-300 rounded-box">
                <p class="mb-0">Initially hidden collapsible content now revealed!</p>
            </div>
        {% endcall %}
    </div>

    <div class="card bg-base-100 border border-base-300 p-4">
        <h5 class="card-title text-base-content font-bold mb-2">3. Collapsible with fullHide (toggleDisplay = true)</h5>
        <div class="mb-2">
            <button type="button" class="btn btn-outline btn-sm"
                    id="btn-toggle-collapsible-display"
                    data-on:click="$demoCollapsibleDisplay = !$demoCollapsibleDisplay">
                Toggle Display (<span data-text="$demoCollapsibleDisplay ? 'Show' : 'Hide'">Hide</span>)
            </button>
        </div>
        {% call collapsible(collapse=false, toggle_display=true, signal_name="demoCollapsibleDisplay", id="demo-collapsible-display") %}
            <div class="p-3 bg-base-200 border border-base-300 rounded-box">
                <p class="mb-0">When collapsed, this has <code>display: none</code> via the <code>.hidden</code> class.</p>
            </div>
        {% endcall %}
    </div>
</div>
