<div class="tools mx-auto px-4 py-3 max-w-xl">
    <h3 class="text-xl font-bold mb-4">{{ tr.qt_accel_tools() | tr_clean }}</h3>
    <section class="mb-4">
        <button class="btn btn-outline btn-sm" type='button' data-on:click__prevent="@post('/tools/checkdb')">{{ checkdb_label | tr_clean }}</button>
        <div id="res-db"></div>
    </section>
    <section class="mb-4">
        <button class="btn btn-outline btn-sm" type='button' data-on:click__prevent="@post('/tools/checkmedia')">{{ checkmedia_label | tr_clean }}</button>
        <div id="res-media"></div>
    </section>
    <section class="mb-4">
        <button class="btn btn-outline btn-sm" type='button' data-on:click__prevent="@post('/tools/emptycards')">{{ emptycards_label | tr_clean }}</button>
        <div id="res-empty"></div>
    </section>
    <p><a class="btn btn-outline btn-sm" href='/notetypes'>{{ notetypes_label | tr_clean }}</a></p>
</div>
