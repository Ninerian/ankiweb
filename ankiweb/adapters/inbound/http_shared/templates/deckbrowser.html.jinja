
{% set ns = namespace(total_due=0, row_idx=0, has_current=false) %}
{% for c in children %}
  {% set ns.total_due = ns.total_due + (c.new_count or 0) + (c.learn_count or 0) + (c.review_count or 0) %}
  {% if c.deck_id == current_id %}{% set ns.has_current = true %}{% endif %}
{% endfor %}

{% macro render_node(node, current_id) %}
  {% set ns.row_idx = ns.row_idx + 1 %}
  <div
    class="deck{{ ' current' if node.deck_id == current_id else '' }}"
    id="{{ node.deck_id }}"
    {% if ns.row_idx <= 12 %}style="--i: {{ ns.row_idx - 1 }};"{% endif %}
  >
    <div
      class="decktd{{ ' is-child' if node.level > 1 else '' }}"
      style="padding-inline-start: calc({{ node.level - 1 }} * 1.25rem);"
      data-on:click__prevent="@post('/deckbrowser/open/{{ node.deck_id }}')"
    >
      <div class="collapse-btn-wrap" onclick="event.stopPropagation()">
        {% if node.children %}
          <a
            class="collapse{{ ' is-collapsed' if node.collapsed else '' }}"
            href="#"
            role="button"
            aria-label="{{ tr.browsing_sidebar_expand() if node.collapsed else tr.browsing_sidebar_collapse() }}"
            aria-expanded="{{ 'false' if node.collapsed else 'true' }}"
            data-on:click__prevent="@post('/deckbrowser/collapse/{{ node.deck_id }}')"
          >
            <svg class="collapse-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
      <div class="deck-content">
        <div class="deck-title-line">
          <a
            class="deck{{ ' filtered' if node.filtered else '' }}"
            href="#"
            data-on:click__prevent="@post('/deckbrowser/open/{{ node.deck_id }}')"
          >{{ node.name }}</a>
        </div>
        <div class="deck-counts-row">
          <span class="count count-pill" data-label="{{ tr.actions_new() }}">
            <span class="count-pill-label">{{ tr.actions_new() }}</span>
            <span class="count-pill-value {{ 'new-count' if node.new_count else 'zero-count' }}">{{ node.new_count or 0 }}</span>
          </span>
          <span class="count count-pill" data-label="{{ tr.decks_learn_header() }}">
            <span class="count-pill-label">{{ tr.decks_learn_header() }}</span>
            <span class="count-pill-value {{ 'learn-count' if node.learn_count else 'zero-count' }}">{{ node.learn_count or 0 }}</span>
          </span>
          <span class="count count-pill" data-label="{{ tr.decks_review_header() }}">
            <span class="count-pill-label">{{ tr.decks_review_header() }}</span>
            <span class="count-pill-value {{ 'review-count' if node.review_count else 'zero-count' }}">{{ node.review_count or 0 }}</span>
          </span>
        </div>
      </div>
    </div>
    <div class="opts">
      <div class="dropdown dropdown-end">
        <button
          class="opts"
          type="button"
          tabindex="0"
          data-testid="deck-options-dropdown"
          aria-label="{{ tr.actions_options() }}"
        >
          <span class="kebab-dots" aria-hidden="true">&#8942;</span>
        </button>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow-lg z-50 w-44 p-1 border border-base-300">
          <li>
            <a href="#" onclick="this.closest('.dropdown')?.removeAttribute('open'); document.activeElement?.blur();" data-on:click__prevent="@post('/deckbrowser/opts/{{ node.deck_id }}')">
              {{ tr.actions_options() }}
            </a>
          </li>
          <li>
            <a href="#" onclick="this.closest('.dropdown')?.removeAttribute('open'); document.activeElement?.blur();" data-on:click__prevent='document.getElementById("err").textContent = ""; ankiwebPrompt("{{ tr.decks_new_deck_name() }}", {{ node.name | tojson }}).then(function(name) { if (name) @post(&#39;/deckbrowser/rename/{{ node.deck_id }}&#39;, {payload: {name: name}}); })'>
              {{ tr.actions_rename() }}
            </a>
          </li>
          <li>
            <a class="text-error" href="#" onclick="this.closest('.dropdown')?.removeAttribute('open'); document.activeElement?.blur();" data-on:click__prevent='document.getElementById("err").textContent = ""; ankiwebConfirm("{{ tr.decks_delete_deck() }}: " + {{ node.name | tojson }} + "?", {danger: true}).then(function(ok) { if (ok) @post(&#39;/deckbrowser/delete/{{ node.deck_id }}&#39;); })'>
              {{ tr.actions_delete() }}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  {% if not node.collapsed %}
    {% for child in node.children %}
      {{ render_node(child, current_id) }}
    {% endfor %}
  {% endif %}
{% endmacro %}

<div class="deckbrowser-page mx-auto max-w-2xl px-3 py-2 md:py-4">
  <!-- Header: Serif Due numeral & Continue button -->
  <header class="flex items-center justify-between gap-2 mb-3 pb-2 border-b border-base-300">
    <div class="flex items-baseline gap-2">
      <div class="deckbrowser-due-numeral">{{ ns.total_due }}</div>
      <div class="deckbrowser-due-label">{{ tr.statistics_due_count() }}</div>
    </div>
    {% if ns.total_due > 0 and current_id %}
      <div>
        <a
          class="btn btn-primary btn-sm md:btn-lg px-3 sm:px-4 inline-flex items-center justify-center gap-1 sm:gap-2"
          href="#"
          data-on:click__prevent="@post('/deckbrowser/open/{{ current_id }}')"
        >
          <span>{{ tr.studying_continue() }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </header>

  <!-- Deck rows list -->
  <main class="deck-list" role="region" aria-label="{{ tr.actions_decks() }}">
    {% for c in children %}
      {{ render_node(c, current_id) }}
    {% endfor %}
  </main>

  <div id="studiedToday" class="text-base-content/60 text-center mt-3"><span>{{ studied_today }}</span></div>
  <div id="err" class="text-error mt-2 text-center"></div>

  <!-- Floating Action Button with speed dial (daisyUI fab) -->
  <div class="fab deckbrowser-fab">
    <div tabindex="0" role="button" class="btn btn-lg btn-circle btn-primary" aria-label="{{ tr.actions_add() }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </div>

    <!-- Replaces the trigger while the speed dial is open -->
    <div class="fab-close">
      <span class="btn btn-lg btn-circle btn-error" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </span>
    </div>

    <div>
      {{ tr.decks_create_deck() }}
      <button
        class="btn btn-lg btn-circle"
        type="button"
        aria-label="{{ tr.decks_create_deck() }}"
        data-on:click__prevent="ankiwebPrompt('{{ tr.decks_new_deck_name() }}').then(function(name) { if (name) @post('/deckbrowser/create', {payload: {name: name}}); })"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M12 11v6"></path>
          <path d="M9 14h6"></path>
        </svg>
      </button>
    </div>

    <div>
      {{ tr.qt_misc_create_filtered_deck() }}
      <button
        class="btn btn-lg btn-circle"
        type="button"
        aria-label="{{ tr.qt_misc_create_filtered_deck() }}"
        data-on:click__prevent="@post('/deckbrowser/createfiltered')"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
        </svg>
      </button>
    </div>

    <div>
      {{ tr.actions_import() }}
      <button
        class="btn btn-lg btn-circle"
        type="button"
        aria-label="{{ tr.actions_import() }}"
        onclick="ankiwebImportFile();"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </button>
    </div>

    <div>
      {{ tr.actions_export() }}
      <a
        class="btn btn-lg btn-circle"
        href="/export"
        aria-label="{{ tr.actions_export() }}"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </a>
    </div>

    <div>
      {{ tr.notetypes_image_occlusion_name() }}
      <button
        class="btn btn-lg btn-circle"
        type="button"
        aria-label="{{ tr.notetypes_image_occlusion_name() }}"
        onclick="ankiwebImageOcclusion();"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      </button>

    </div>
  </div>

  {# Container for dynamically loaded import package modal #}
  <div id="deckbrowserImportModalContainer"></div>
</div>
