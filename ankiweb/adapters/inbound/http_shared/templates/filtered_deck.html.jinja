{% macro order_select(sel_id, selected, labels) %}
  <select id="{{ sel_id }}">
    {% for l in labels %}<option
        value="{{ loop.index0 }}"
        {% if loop.index0 == selected %}
          selected
        {% endif %}
      >
        {{ l }}
      </option>{% endfor %}
  </select>
{% endmacro %}
<div class="filtered-deck">
  <h3>{{ heading }}</h3>
  <form id="fd" onsubmit="return false">
    <input type="hidden" id="did" value="{{ did }}">
    <div>
      <label>
        {{ tr.deck_config_name_prompt() }}
        <input type="text" id="name" value="{{ name }}" size="30">
      </label>
    </div>
    <fieldset>
      <legend>{{ tr.actions_filter() }}</legend>
      <div>
        <label>
          {{ tr.actions_search() }}
          <input type="text" id="search1" value="{{ search1 }}" size="40">
        </label>
      </div>
      <div>
        <label>
          {{ tr.decks_limit_to() }}
          <input
            type="number"
            id="limit1"
            value="{{ limit1 }}"
            min="1"
            style="width:6em"
          >
        </label>
        &nbsp; {{ tr.scheduling_order() }} {{
          order_select('order1', order1, labels)
        }}
      </div>
    </fieldset>
    <div>
      <label><input
          type="checkbox"
          id="second"
          {% if has2 %}
            checked
          {% endif %}
          onchange="onSecond()"
        > {{ tr.decks_enable_second_filter() }}</label>
    </div>
    <fieldset id="filter2" {% if not has2 %}style="display:none;"{% endif %}>
      <legend>{{ tr.decks_filter_2() }}</legend>
      <div>
        <label>
          {{ tr.actions_search() }}
          <input type="text" id="search2" value="{{ search2 }}" size="40">
        </label>
      </div>
      <div>
        <label>
          {{ tr.decks_limit_to() }}
          <input
            type="number"
            id="limit2"
            value="{{ limit2 }}"
            min="1"
            style="width:6em"
          >
        </label>
        &nbsp; {{ tr.scheduling_order() }} {{
          order_select('order2', order2, labels)
        }}
      </div>
    </fieldset>
    <div style="margin-top:8px;">
      <label><input
          type="checkbox"
          id="resched"
          {% if resched %}
            checked
          {% endif %}
          onchange="onResched()"
        > {{ tr.decks_reschedule_cards_based_on_my_answers() }}</label>
    </div>
    <fieldset
      id="previewblock"
      {% if resched %}
        style="display:none;"
      {% endif %}
    >
      <legend>Preview delays (seconds)</legend>
      <label>
        {{ tr.studying_again() }}
        <input
          type="number"
          id="preview_again"
          value="{{ preview_again }}"
          min="0"
          style="width:6em"
        >
      </label>
      <label>
        {{ tr.studying_hard() }}
        <input
          type="number"
          id="preview_hard"
          value="{{ preview_hard }}"
          min="0"
          style="width:6em"
        >
      </label>
      <label>
        {{ tr.studying_good() }}
        <input
          type="number"
          id="preview_good"
          value="{{ preview_good }}"
          min="0"
          style="width:6em"
        >
      </label>
    </fieldset>
    <div style="margin-top:8px;">
      <label><input
          type="checkbox"
          id="allow_empty"
          {% if allow_empty %}
            checked
          {% endif %}
        > {{ tr.decks_create_even_if_empty() }}</label>
    </div>
    <div style="margin-top:10px;">
      <button type="button" id="go" data-on:click__prevent="const payload = buildFdPayload(); @post('/filtered-deck/submit', {payload: payload})">{{ oklabel }}</button>
      <button type="button" data-on:click__prevent="@post('/filtered-deck/cancel')">
        {{ tr.actions_cancel() }}
      </button>
    </div>
    <div id="err" style="color:#c00;margin-top:8px;"></div>
  </form>
</div>
<script>
  function chk(id) {
      return document.getElementById(id).checked;
  }

  function val(id) {
      return document.getElementById(id).value;
  }

  function num(id) {
      return parseInt(document.getElementById(id).value || '0');
  }

  function onSecond() {
      document.getElementById('filter2').style.display = chk('second') ? '' : 'none';
  }

  function onResched() {
      document.getElementById('previewblock').style.display = chk('resched') ? 'none' : '';
  }

  function buildFdPayload() {
      document.getElementById('err').textContent = '';
      return {
          id: parseInt(val('did')),
          name: val('name'),
          reschedule: chk('resched'),
          search1: val('search1'),
          limit1: num('limit1'),
          order1: parseInt(val('order1')),
          second: chk('second'),
          search2: val('search2'),
          limit2: num('limit2'),
          order2: parseInt(val('order2')),
          preview_again: num('preview_again'),
          preview_hard: num('preview_hard'),
          preview_good: num('preview_good'),
          allow_empty: chk('allow_empty')
      };
  }
</script>
