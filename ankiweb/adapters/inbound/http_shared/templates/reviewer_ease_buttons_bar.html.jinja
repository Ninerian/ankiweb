<div class="ease-row flex gap-1 sm:gap-2 justify-center p-2">
  {% for c in cells %}
    {% set color = 'btn-error btn-outline' if (c.i == 1) else ('btn-warning btn-outline' if (c.i == 2 and cells|length == 4) else ('btn-success btn-outline' if ((c.i == 3 and cells|length == 4) or (c.i == 2 and cells|length < 4 and c.i != cells|length)) else 'btn-primary btn-outline')) %}
    {% if c.i == cells|length and cells|length > 1 %}
      {% set color = 'btn-primary btn-outline' %}
    {% endif %}
    <button
      type="button"
      class="ease btn {{ color }} flex flex-col items-center justify-center flex-1 py-2 px-1 relative h-auto"
      style="min-height: 44px;"
      data-ease="{{ c.i }}"
      onclick="pycmd('ease{{ c.i }}')"
    >
      <div class="flex items-center gap-1">
        <span class="ease-label text-sm font-semibold">{{ c.name }}</span>
        <span class="badge badge-sm badge-ghost border border-base-300 opacity-75 py-0 px-1 font-mono text-[0.7rem]">{{ c.i }}</span>
      </div>
      <span class="ease-ivl text-xs opacity-75">{{ c.label }}</span>
    </button>
  {% endfor %}
</div>
