<div class="ease-row d-flex gap-1 gap-sm-2 justify-content-center p-2">
  {% for c in cells %}
    {% set color = 'btn-outline-danger' if (c.i == 1) else ('btn-outline-warning' if (c.i == 2 and cells|length == 4) else ('btn-outline-success' if ((c.i == 3 and cells|length == 4) or (c.i == 2 and cells|length < 4 and c.i != cells|length)) else 'btn-outline-primary')) %}
    {% if c.i == cells|length and cells|length > 1 %}
      {% set color = 'btn-outline-primary' %}
    {% endif %}
    <button
      type="button"
      class="ease btn {{ color }} d-flex flex-column align-items-center justify-content-center flex-fill py-2 px-1 position-relative"
      style="min-height: 44px;"
      data-ease="{{ c.i }}"
      onclick="pycmd('ease{{ c.i }}')"
    >
      <div class="d-flex align-items-center gap-1">
        <span class="ease-label small fw-semibold">{{ c.name }}</span>
        <span class="badge text-bg-light border opacity-75 py-0 px-1" style="font-size: 0.7rem; font-family: monospace;">{{ c.i }}</span>
      </div>
      <span class="ease-ivl small opacity-75" style="font-size: 0.75rem;">{{ c.label }}</span>
    </button>
  {% endfor %}
</div>
