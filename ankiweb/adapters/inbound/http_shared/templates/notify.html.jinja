<div class="container" style="max-width:760px;padding:8px 16px;">
  <h2>Push notifications</h2>
  {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
  <p class="text-muted">
    An ankiweb-original feature (not part of the Anki/AnkiConnect port). POSTs
    to your endpoint whenever a deck's new/learn/review counts change (any of
    the three). Configuration is live — saving applies without a restart.
  </p>
  <form method="post" action="/notify">
    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="checkbox"
        id="notify_enabled"
        name="enabled"
        {% if enabled_checked %}
          checked
        {% endif %}
      >
      <label class="form-check-label" for="notify_enabled">Enabled</label>
    </div>
    <div class="mb-3 row">
      <label class="col-sm-4 col-form-label" for="notify_url">POST URL</label>
      <div class="col-sm-8">
        <input
          class="form-control"
          type="text"
          id="notify_url"
          name="url"
          value="{{ url }}"
          placeholder="https://example.com/anki-hook"
        >
      </div>
    </div>
    <div class="mb-3 row">
      <label class="col-sm-4 col-form-label" for="notify_token">Token (Bearer)</label>
      <div class="col-sm-8">
        <input
          class="form-control"
          type="text"
          id="notify_token"
          name="token"
          value="{{ token }}"
          placeholder="(optional)"
        >
      </div>
    </div>
    <div class="mb-3 row">
      <label class="col-sm-4 col-form-label" for="notify_poll_sec">Poll interval (sec)</label>
      <div class="col-sm-8">
        <input
          class="form-control"
          type="number"
          id="notify_poll_sec"
          name="poll_sec"
          min="1"
          step="1"
          value="{{ poll_sec }}"
        >
      </div>
    </div>
    <div class="mb-3 row">
      <label class="col-sm-4 col-form-label" for="notify_retry_sec">Retry interval (sec)</label>
      <div class="col-sm-8">
        <input
          class="form-control"
          type="number"
          id="notify_retry_sec"
          name="retry_sec"
          min="1"
          step="1"
          value="{{ retry_sec }}"
        >
      </div>
    </div>
    <div class="mb-3 row">
      <label class="col-sm-4 col-form-label" for="notify_scope">Scope</label>
      <div class="col-sm-8">
        <select class="form-select" id="notify_scope" name="scope">
          <option value="leaf" {% if leaf_selected %}selected{% endif %}>
            Leaf only (last-level decks)
          </option>
          <option value="all" {% if all_selected %}selected{% endif %}>
            All levels (parents count subdecks)
          </option>
        </select>
      </div>
    </div>
    <p>
      <button class="btn btn-primary me-2" type="submit" name="action" value="save">{{ tr.actions_save() | tr_clean }}</button>
      <button
        class="btn btn-outline-primary"
        type="submit"
        name="action"
        value="resync"
        title="Re-push every currently-learnable deck now"
      >
        {{ tr.actions_save() | tr_clean }} &amp; re-push all
      </button>
    </p>
  </form>
  <h3>{{ tr.importing_status() | tr_clean }}</h3>
    <tr>
      <td>Active</td>
      <td>{{ "yes" if active else "no" }}</td>
    </tr>
    <tr>
      <td>Decks watched</td>
      <td>{{ watching }}</td>
    </tr>
    <tr>
      <td>Learnable now</td>
      <td>{{ learnable }}</td>
    </tr>
    <tr>
      <td>Pending (unacked)</td>
      <td>{{ pending }}</td>
    </tr>
    <tr>
      <td>Last attempt</td>
      <td>{{ last_attempt }}</td>
    </tr>
    <tr>
      <td>Last success</td>
      <td>{{ last_success }}</td>
    </tr>
    <tr>
      <td>Last error</td>
      <td>{{ last_error }}</td>
    </tr>
  </table>
  <h3>Request format</h3>
  <pre class="bg-body-secondary p-3 rounded">{{ schema_doc | safe }}</pre>
</div>
