<style>
  /* Override vendored overview.css rules that fight the Karteikasten theme */
  #study {
    background: var(--bs-primary) !important;
    border-color: var(--bs-primary) !important;
    color: #fff !important;
  }
  #study:hover, #study:focus {
    background: var(--bs-primary-text-emphasis, var(--bs-primary)) !important;
    border-color: var(--bs-primary-text-emphasis, var(--bs-primary)) !important;
    color: #fff !important;
  }
  /* Fix description padding from vendored .descfont { padding: 1em; } */
  .card-body .descfont.description {
    padding: 0.75rem 1rem !important;
    border-radius: var(--bs-border-radius);
    background-color: var(--bs-tertiary-bg, rgba(0, 0, 0, 0.03));
  }
  /* Make Study Now sticky above the bottom nav bar below md */
  @media (max-width: 767.98px) {
    .study-action-sticky {
      position: sticky;
      bottom: calc(var(--ankiweb-bottomnav-h) + 0.5rem);
      z-index: 1020;
      background: var(--bs-card-bg, #fff);
      padding: 0.5rem 0;
      border-radius: var(--bs-border-radius);
    }
  }
</style>

<div class="container py-3">
  <div class="card shadow-sm mx-auto mt-2 mt-md-4" style="max-width: 32rem;">
    <div class="card-body text-center p-3 p-md-4">
      <h3 class="card-title mb-3">{{ name }}</h3>
      {% if desc %}
        <div class="descfont description text-start mb-4">
          {{ desc | safe }}
        </div>
      {% endif %}
      <div class="row text-center g-2 mb-4">
        <div class="col-4">
          <div class="fs-2 fw-semibold new-count">{{ new }}</div>
          <div class="small text-body-secondary">{{ tr.statistics_counts_new_cards() | tr_clean }}</div>
        </div>
        <div class="col-4">
          <div class="fs-2 fw-semibold learn-count">{{ learn }}</div>
          <div class="small text-body-secondary">{{ tr.statistics_counts_learning_cards() | tr_clean }}</div>
        </div>
        <div class="col-4">
          <div class="fs-2 fw-semibold review-count">{{ review }}</div>
          <div class="small text-body-secondary">{{ tr.studying_to_review() | tr_clean }}</div>
        </div>
      </div>
      <div class="study-action-sticky d-grid mb-3">
        <button
          type="button"
          id="study"
          class="btn btn-primary btn-lg"
          autofocus
          data-on:click__prevent="@post('/overview/study')"
        >
          {{ tr.studying_study_now() | tr_clean }}
        </button>
      </div>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" type="button" data-on:click__prevent="@post('/overview/opts')">
          {{ tr.actions_options() | tr_clean }}
        </button>
        {% if is_dyn %}
          <button class="btn btn-outline-secondary btn-sm" type="button" data-on:click__prevent="@post('/overview/refresh')">
            {{ tr.actions_rebuild() | tr_clean }}
          </button>
          <button class="btn btn-outline-secondary btn-sm" type="button" data-on:click__prevent="@post('/overview/empty')">
            {{ tr.studying_empty() | tr_clean }}
          </button>
        {% else %}
          <button class="btn btn-outline-secondary btn-sm" type="button" data-on:click__prevent="@post('/overview/studymore')">
            {{ tr.actions_custom_study() | tr_clean }}
          </button>
        {% endif %}
        {% if have_buried %}
          <button class="btn btn-outline-secondary btn-sm" type="button" data-on:click__prevent="@post('/overview/unbury')">
            {{ tr.studying_unbury() | tr_clean }}
          </button>
        {% endif %}
        <button
          class="btn btn-outline-secondary btn-sm"
          type="button"
          onclick="document.getElementById('descedit').style.display = ''"
        >
          {% if tr.studying_edit() == 'Bearbeiten' %}{{ tr.fields_description() | tr_clean }} {{ tr.studying_edit() | tr_clean | lower }}{% else %}{{ tr.studying_edit() | tr_clean }} {{ tr.fields_description() | tr_clean }}{% endif %}
        </button>
      </div>
      <div id="descedit" class="mt-3 text-start" style="display:none;">
        <textarea id="descbox" class="form-control" rows="4" cols="50"
        >{{ raw_desc }}</textarea>
        <div class="form-check my-2">
          <input
            class="form-check-input"
            type="checkbox"
            id="descmd"
            {% if md_checked %}
              checked
            {% endif %}
          >
          <label class="form-check-label" for="descmd">{{ tr.deck_config_description_new_handling2() | tr_clean }}</label>
        </div>
        <div class="text-center">
          <button
            class="btn btn-primary btn-sm me-2"
            type="button"
            data-on:click__prevent="const d = document.getElementById('descbox').value; const m = document.getElementById('descmd').checked; @post('/overview/setdesc', {payload: {desc: d, md: m}})"
          >
            {{ tr.actions_save() | tr_clean }}
          </button>
          <button
            class="btn btn-secondary btn-sm"
            type="button"
            onclick="document.getElementById('descedit').style.display = 'none'"
          >
            {{ tr.actions_cancel() | tr_clean }}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
