{% macro field_row(field, sortf) %}
  <tr class="field-row row-hover" data-orig="{{ field.ord }}">
    <td>
      <label class="block mb-0">
        <span class="sr-only">{{ tr.actions_name() }}</span>
        <input type="text" class="fld-name input input-sm w-36" value="{{ field.name }}" size="16" placeholder="{{ tr.actions_name() }}">
      </label>
    </td>
    <td>
      <label class="block mb-0">
        <span class="sr-only">{{ tr.fields_editing_font() }}</span>
        <input type="text" class="fld-font input input-sm w-28" value="{{ field.font }}" size="10" placeholder="{{ tr.fields_editing_font() }}">
      </label>
    </td>
    <td>
      <label class="block mb-0">
        <span class="sr-only">{{ tr.fields_size() }}</span>
        <input
          type="number"
          class="fld-size input input-sm w-20"
          value="{{ field.size }}"
          min="1"
          placeholder="{{ tr.fields_size() }}"
        >
      </label>
    </td>
    <td>
      <label class="label cursor-pointer justify-start gap-2 py-0">
        <input
          type="checkbox"
          class="fld-rtl checkbox checkbox-sm checkbox-primary"
          id="rtl_{{ field.ord }}"
          {% if field.rtl %}
            checked
          {% endif %}
        >
        <span class="text-xs whitespace-nowrap">{{ tr.fields_reverse_text_direction_rtl() }}</span>
      </label>
    </td>
    <td>
      <label class="block mb-0">
        <span class="sr-only">{{ tr.fields_description() }}</span>
        <input
          type="text"
          class="fld-desc input input-sm w-36"
          value="{{ field.description }}"
          size="16"
          placeholder="{{ tr.fields_description() }}"
        >
      </label>
    </td>
    <td>
      <label class="label cursor-pointer justify-start gap-2 py-0">
        <input
          type="radio"
          name="sortf"
          id="sortf_{{ field.ord }}"
          class="fld-sort radio radio-sm radio-primary"
          {% if field.ord == sortf %}
            checked
          {% endif %}
        >
        <span class="text-xs whitespace-nowrap">{{ tr.browsing_sort_field() }}</span>
      </label>
    </td>
    <td>
      <div class="flex items-center gap-1">
        <div class="join">
          <button class="btn btn-sm btn-outline join-item" type="button" onclick="moveUp(this)">↑</button>
          <button class="btn btn-sm btn-outline join-item" type="button" onclick="moveDown(this)">↓</button>
        </div>
        <button class="btn btn-sm btn-outline btn-error" type="button" onclick="deleteRow(this)">
          {{ tr.actions_delete() }}
        </button>
      </div>
    </td>
  </tr>
{% endmacro %}
<div class="fields max-w-5xl mx-auto px-4 py-3">
  <h3 class="text-xl font-bold mb-3">Fields</h3>
  <form id="ff" onsubmit="return false" data-signals='{{ {"notetypeId": ntid} | tojson }}'>
    <div class="overflow-x-auto border border-base-300 rounded-box shadow-sm mb-3">
      <table id="fieldtbl" class="table table-sm">
        <tbody id="fieldrows">
          {% for f in fields %}{{ field_row(f, sortf) }}{% endfor %}
        </tbody>
      </table>
    </div>
    <div class="mt-2">
      <button class="btn btn-outline" type="button" id="addfield" onclick="addRow()">
        {{ add_label }}
      </button>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button class="btn btn-primary" type="button" id="save" data-on:click__prevent="const payload = buildFieldsPayload(); payload.notetypeId = $notetypeId; @post('/fields/savefields', {payload: payload})">
        {{ save_label }}
      </button>
      <button class="btn btn-neutral" type="button" data-on:click__prevent="@post('/fields/cancel')">
        {{ cancel_label }}
      </button>
    </div>
    <div id="err" class="text-error text-sm font-semibold mt-2"></div>
  </form>
</div>
<template id="blankrow">{{
  field_row({'ord': 'new', 'name': '', 'font': 'Arial', 'size': 20, 'rtl': False, 'description': ''}, -1)
}}</template>
<!-- Die Zeilen-Arrays werden bewusst per Vanilla-JS/DOM gelesen, da Datastar v1.0.3 kein Listen-Rendering für dynamisch geklonte Zeilen bietet. -->
<script>
  function addRow() {
      var tpl = document.getElementById('blankrow');
      var tr = tpl.content.firstElementChild.cloneNode(true);
      document.getElementById('fieldrows').appendChild(tr);
  }

  function deleteRow(btn) {
      var tr = btn.closest('tr');
      tr.parentNode.removeChild(tr);
  }

  function moveUp(btn) {
      var tr = btn.closest('tr');
      var prev = tr.previousElementSibling;
      if (prev) tr.parentNode.insertBefore(tr, prev);
  }

  function moveDown(btn) {
      var tr = btn.closest('tr');
      var next = tr.nextElementSibling;
      if (next) tr.parentNode.insertBefore(next, tr);
  }

  function buildFieldsPayload() {
      document.getElementById('err').textContent = '';
      var rows = Array.prototype.slice.call(
          document.querySelectorAll('#fieldrows .field-row'));
      var sortf = 0;
      var fields = rows.map(function(tr, i) {
          if (tr.querySelector('.fld-sort').checked) sortf = i;
          var orig = tr.getAttribute('data-orig');
          return {
              orig: (orig === 'new') ? null : parseInt(orig),
              name: tr.querySelector('.fld-name').value,
              font: tr.querySelector('.fld-font').value,
              size: parseInt(tr.querySelector('.fld-size').value || '20'),
              rtl: tr.querySelector('.fld-rtl').checked,
              description: tr.querySelector('.fld-desc').value
          };
      });
      return {
          sortf: sortf,
          fields: fields
      };
  }
</script>
