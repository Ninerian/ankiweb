{% macro field_row(field, sortf) %}
  <tr class="field-row" data-orig="{{ field.ord }}">
    <td>
      <label class="form-label mb-0">
        <span class="visually-hidden">{{ tr.actions_name() }}</span>
        <input type="text" class="fld-name form-control form-control-sm" value="{{ field.name }}" size="16" placeholder="{{ tr.actions_name() }}">
      </label>
    </td>
    <td>
      <label class="form-label mb-0">
        <span class="visually-hidden">{{ tr.fields_editing_font() }}</span>
        <input type="text" class="fld-font form-control form-control-sm" value="{{ field.font }}" size="10" placeholder="{{ tr.fields_editing_font() }}">
      </label>
    </td>
    <td>
      <label class="form-label mb-0">
        <span class="visually-hidden">{{ tr.fields_size() }}</span>
        <input
          type="number"
          class="fld-size form-control form-control-sm"
          value="{{ field.size }}"
          min="1"
          style="width:5em"
          placeholder="{{ tr.fields_size() }}"
        >
      </label>
    </td>
    <td>
      <div class="form-check form-check-inline mb-0">
        <input
          type="checkbox"
          class="fld-rtl form-check-input"
          id="rtl_{{ field.ord }}"
          {% if field.rtl %}
            checked
          {% endif %}
        >
        <label class="form-check-label" for="rtl_{{ field.ord }}">{{ tr.fields_reverse_text_direction_rtl() }}</label>
      </div>
    </td>
    <td>
      <label class="form-label mb-0">
        <span class="visually-hidden">{{ tr.fields_description() }}</span>
        <input
          type="text"
          class="fld-desc form-control form-control-sm"
          value="{{ field.description }}"
          size="16"
          placeholder="{{ tr.fields_description() }}"
        >
      </label>
    </td>
    <td>
      <div class="form-check form-check-inline mb-0">
        <input
          type="radio"
          name="sortf"
          id="sortf_{{ field.ord }}"
          class="fld-sort form-check-input"
          {% if field.ord == sortf %}
            checked
          {% endif %}
        >
        <label class="form-check-label" for="sortf_{{ field.ord }}">{{ tr.browsing_sort_field() }}</label>
      </div>
    </td>
    <td>
      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="moveUp(this)">↑</button>
      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="moveDown(this)">↓</button>
      <button class="btn btn-sm btn-outline-danger" type="button" onclick="deleteRow(this)">
        {{ tr.actions_delete() }}
      </button>
    </td>
  </tr>
{% endmacro %}
<div class="fields container-fluid">
  <h3>Fields</h3>
  <input type="hidden" id="ntid" value="{{ ntid }}">
  <form id="ff" onsubmit="return false">
    <table id="fieldtbl" class="table table-sm align-middle">
      <tbody id="fieldrows">
        {% for f in fields %}{{ field_row(f, sortf) }}{% endfor %}
      </tbody>
    </table>
    <div class="mt-2">
      <button class="btn btn-outline-secondary" type="button" id="addfield" onclick="addRow()">
        {{ add_label }}
      </button>
    </div>
    <div class="mt-3">
      <button class="btn btn-primary me-2" type="button" id="save" data-on:click__prevent="const payload = buildFieldsPayload(); @post('/fields/savefields', {payload: payload})">
        {{ save_label }}
      </button>
      <button class="btn btn-secondary" type="button" data-on:click__prevent="@post('/fields/cancel')">
        {{ cancel_label }}
      </button>
    </div>
    <div id="err" class="text-danger mt-2"></div>
  </form>
</div>
<template id="blankrow">{{
  field_row({'ord': 'new', 'name': '', 'font': 'Arial', 'size': 20, 'rtl': False, 'description': ''}, -1)
}}</template>
<script>
  function addRow() {
      var tpl = document.getElementById('blankrow');
      var tr = tpl.content.firstElementChild.cloneNode(true);
      document.getElementById('fieldrows').appendChild(tr);
  }

  function deleteRow(btn) {
      var tr = btn.closest('tr');
      tr.parentNode.removeChild(tr);
  }

  function moveUp(btn) {
      var tr = btn.closest('tr');
      var prev = tr.previousElementSibling;
      if (prev) tr.parentNode.insertBefore(tr, prev);
  }

  function moveDown(btn) {
      var tr = btn.closest('tr');
      var next = tr.nextElementSibling;
      if (next) tr.parentNode.insertBefore(next, tr);
  }

  function buildFieldsPayload() {
      document.getElementById('err').textContent = '';
      var rows = Array.prototype.slice.call(
          document.querySelectorAll('#fieldrows .field-row'));
      var sortf = 0;
      var fields = rows.map(function(tr, i) {
          if (tr.querySelector('.fld-sort').checked) sortf = i;
          var orig = tr.getAttribute('data-orig');
          return {
              orig: (orig === 'new') ? null : parseInt(orig),
              name: tr.querySelector('.fld-name').value,
              font: tr.querySelector('.fld-font').value,
              size: parseInt(tr.querySelector('.fld-size').value || '20'),
              rtl: tr.querySelector('.fld-rtl').checked,
              description: tr.querySelector('.fld-desc').value
          };
      });
      return {
          notetypeId: parseInt(document.getElementById('ntid').value),
          sortf: sortf,
          fields: fields
      };
  }
</script>
