{% if fatal_error %}
<div id="change-notetype-content" class="route-change-notetype p-3">
  <div class="alert alert-error py-2 px-3 mb-3 notetype-wrap-text" role="alert">
    {{ fatal_error }}
  </div>
  <a id="change-notetype-cancel-btn" class="btn btn-ghost btn-sm notetype-action" href="/browse">
    {{ tr.actions_cancel() }}
  </a>
</div>
{% else %}
{% macro alert_box(unused, is_field) %}
  {% set max_items = 3 %}
  {% set unused_count = unused | length %}
  {% set unused_msg = tr.change_notetype_will_discard_content() if is_field else tr.change_notetype_will_discard_cards() %}
  <div class="alert alert-warning block py-2 px-3 mb-3">
    {% if unused_count > max_items %}
      <div
        class="clickable-collapse flex items-center mb-1 cursor-pointer font-bold"
        data-on:click="{{ '$collapsed_' + ('fields' if is_field else 'templates') + ' = !$' + ('collapsed_' + ('fields' if is_field else 'templates')) }}"
        role="button"
        tabindex="0"
      >
        <span class="badge badge-neutral me-2 p-1 inline-flex items-center">
          <span data-show="{{ '$collapsed_' + ('fields' if is_field else 'templates') }}">
            +
          </span>
          <span data-show="{{ '!$' + ('collapsed_' + ('fields' if is_field else 'templates')) }}">
            &minus;
          </span>
        </span>
        <span data-show="{{ '$collapsed_' + ('fields' if is_field else 'templates') }}">
          {{ tr.change_notetype_expand() }}
        </span>
        <span data-show="{{ '!$' + ('collapsed_' + ('fields' if is_field else 'templates')) }}">
          {{ tr.change_notetype_collapse() }}
        </span>
      </div>
    {% endif %}
    <div>{{ unused_msg }}</div>
    <div data-show="{{ '$collapsed_' + ('fields' if is_field else 'templates') }}">
      {{ unused[:max_items] | join(', ') }}{% if unused_count > max_items %} ... (+{{ unused_count - max_items }}){% endif %}
    </div>
    {% if unused_count > max_items %}
      <div data-show="{{ '!$' + ('collapsed_' + ('fields' if is_field else 'templates')) }}">
        <ul class="mb-0 ps-4 mt-1 list-disc">
          {% for entry in unused %}
            <li>{{ entry }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
{% endmacro %}

<div id="change-notetype-content" class="route-change-notetype" data-signals="{{ initial_signals_json }}">
  <!-- Sticky Top Bar -->
  <div class="sticky-top-bar mb-3">
    <div class="notetype-selectors">
      <div class="notetype-select-group">
        <label for="source-notetype-select" class="notetype-select-label">
          {{ tr.change_notetype_current() }}
        </label>
        <select id="source-notetype-select" class="select select-sm w-full" disabled>
          <option selected>{{ old_notetype_name }}</option>
        </select>
      </div>
      <div class="arrow-container" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
        </svg>
      </div>
      <div class="notetype-select-group">
        <label for="target-notetype-select" class="notetype-select-label">
          {{ tr.change_notetype_new() }}
        </label>
        <select
          id="target-notetype-select"
          class="select select-sm w-full"
          data-bind="target_notetype_id"
          data-on:change="@post('/change-notetype/select-target')"
        >
          {% for nt in notetypes %}
            <option value="{{ nt.id }}" {% if nt.id == new_notetype_id %}selected{% endif %}>
              {{ nt.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>
    <div class="notetype-actions">
      <a
        id="change-notetype-cancel-btn"
        class="btn btn-ghost btn-sm notetype-action"
        href="/browse"
      >
        {{ tr.actions_cancel() }}
      </a>
      <button
        id="change-notetype-save-btn"
        type="button"
        class="btn btn-primary btn-sm notetype-action"
        title="Ctrl+Enter"
        data-on:click="@post('/change-notetype/save')"
      >
        {{ tr.actions_save() }}
      </button>
    </div>
  </div>

  <div id="change-notetype-alert-area">
    <!-- Feedback / Flash messages -->
    {% if error_msg %}
      <div class="alert alert-error py-2 px-3 mb-3 notetype-wrap-text">{{ error_msg }}</div>
    {% endif %}
    {% if info_msg %}
      <div class="alert alert-info py-2 px-3 mb-3 notetype-wrap-text">{{ info_msg }}</div>
    {% endif %}
  </div>


  <!-- Main Containers -->
  <div class="w-full min-w-0 px-1">
    <!-- Fields Container -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.change_notetype_fields() }}</h5>
      </div>
      <div class="card-body p-3 min-w-0">
        {% if unused_fields %}
          {{ alert_box(unused_fields, true) }}
        {% endif %}

        <div class="notetype-mapping-grid grid grid-cols-2 gap-2 mb-2 font-bold text-base-content/60 text-sm border-b border-base-300 pb-1">
          <div class="min-w-0 break-words">{{ tr.change_notetype_current() }}</div>
          <div class="min-w-0 break-words">{{ tr.change_notetype_new() }}</div>
        </div>

        {% for row in field_rows %}
          <div class="notetype-mapping-grid notetype-mapping-row grid grid-cols-2 gap-2 items-center mb-2">
            <div class="min-w-0">
              <select
                class="select select-sm w-full min-w-0"
                data-bind="field_map_{{ row.new_index }}"
                data-on:change="@post('/change-notetype/remap-field?new_index={{ row.new_index }}')"
              >
                {% for opt in old_field_options %}
                  <option value="{{ opt.value }}" {% if opt.value == row.selected_value %}selected{% endif %}>
                    {{ opt.label }}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="min-w-0 break-words notetype-mapping-name">
              <span class="text-sm">{{ row.new_name }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Templates Container -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.change_notetype_templates() }}</h5>
      </div>
      <div class="card-body p-3 min-w-0">
        {% if has_templates %}
          {% if unused_templates %}
            {{ alert_box(unused_templates, false) }}
          {% endif %}

          <div class="notetype-mapping-grid grid grid-cols-2 gap-2 mb-2 font-bold text-base-content/60 text-sm border-b border-base-300 pb-1">
            <div class="min-w-0 break-words">{{ tr.change_notetype_current() }}</div>
            <div class="min-w-0 break-words">{{ tr.change_notetype_new() }}</div>
          </div>

          {% for row in template_rows %}
            <div class="notetype-mapping-grid notetype-mapping-row grid grid-cols-2 gap-2 items-center mb-2">
              <div class="min-w-0">
                <select
                  class="select select-sm w-full min-w-0"
                  data-bind="template_map_{{ row.new_index }}"
                  data-on:change="@post('/change-notetype/remap-template?new_index={{ row.new_index }}')"
                >
                  {% for opt in old_template_options %}
                    <option value="{{ opt.value }}" {% if opt.value == row.selected_value %}selected{% endif %}>
                      {{ opt.label }}
                    </option>
                  {% endfor %}
                </select>
              </div>
              <div class="min-w-0 break-words notetype-mapping-name">
                <span class="text-sm">{{ row.new_name }}</span>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="text-base-content/60 text-sm">
            {{ tr.change_notetype_to_from_cloze() | replace('\n', '<br>') | safe }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}
