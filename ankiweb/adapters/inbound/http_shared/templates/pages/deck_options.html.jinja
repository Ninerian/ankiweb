{% from "components/titled_container.html.jinja" import titled_container %}
{% from "components/collapsible.html.jinja" import collapsible %}
{% from "components/help_modal.html.jinja" import help_modal %}
{% from "components/switch.html.jinja" import switch %}
{% from "components/enum_selector.html.jinja" import enum_selector %}
{% from "components/spin_box.html.jinja" import spin_box %}
<div class="route-deck-options max-w-7xl mx-auto px-4" data-signals="{{ signals | tojson | forceescape }}">
    <!-- Sticky Header -->
    <div class="deck-options-header flex justify-between items-center mb-3">
        <div class="preset-selector-row flex items-center gap-2">
            <span class="font-bold">{{ tr.card_stats_preset() }}:</span>
            <div id="presetSelectorWrap">
                <select id="presetSelector" class="select select-sm w-auto" data-bind="presetId" data-on:change="@post('/deck-options/change-preset')">
                    {% for p in all_configs %}
                        <option value="{{ p.id }}" {% if p.id == preset_id %}selected{% endif %}>
                            {{ p.name }}{% if p.use_count %} ({{ p.use_count }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Preset Action Dropdown -->
            <details class="dropdown">
                <summary class="btn btn-sm btn-outline">
                    ⚙️
                </summary>
                <ul class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-2 shadow border border-base-300">
                    <li><button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('addPresetModal').showModal()">{{ tr.deck_config_add_group() }}</button></li>
                    <li><button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('clonePresetModal').showModal()">{{ tr.deck_config_clone_group() }}</button></li>
                    <li><button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('renamePresetModal').showModal()">{{ tr.deck_config_rename_group() }}</button></li>
                    <li><button class="text-error" type="button" data-attr:disabled="$presetId == 1" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('deletePresetModal').showModal()">{{ tr.deck_config_remove_group() }}</button></li>
                    <li><hr class="border-base-300 my-1"></li>
                    <li><button type="button" onclick="this.closest('details')?.removeAttribute('open')" data-on:click="$applyToSubdecks = true; @post('/deck-options/save'); $applyToSubdecks = false;">{{ tr.deck_config_save_to_all_subdecks() }}</button></li>
                </ul>
            </details>

            <span class="badge badge-warning ms-2" data-show="$dirty">Unsaved changes</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
            <button class="btn btn-sm btn-outline" type="button" data-show="$dirty" data-on:click="@post('/deck-options/revert')">
                Revert
            </button>
            <button class="btn btn-sm btn-primary" type="button" data-on:click="$applyToSubdecks = false; @post('/deck-options/save')">
                {{ tr.deck_config_save_button() }}
            </button>
            <button class="btn btn-sm btn-outline" type="button" data-on:click="if (!$dirty || confirm('You have unsaved changes. Are you sure you want to close?')) { window.location.href = '/deckbrowser'; }">
                Close
            </button>
        </div>
    </div>

    <!-- Status / Warnings Area -->
    <div class="mb-3" data-show="$statusMessage && $statusMessage !== ''">
        <div class="alert alert-info py-2 px-3 mb-0" data-text="$statusMessage"></div>
    </div>
    <div class="mb-3" data-show="$warnings.length > 0">
        <div class="alert alert-warning py-2 px-3 mb-0">
            <template data-for="w in $warnings">
                <div data-text="w"></div>
            </template>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="tabs tabs-border deck-options-nav mb-4 overflow-x-auto flex-nowrap" role="tablist">
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'daily-limits'}" data-on:click="$activeTab = 'daily-limits'">
            {{ tr.deck_config_daily_limits() }}
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'new-cards'}" data-on:click="$activeTab = 'new-cards'">
            New Cards
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'lapses'}" data-on:click="$activeTab = 'lapses'">
            Lapses
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'display-order'}" data-on:click="$activeTab = 'display-order'">
            {{ tr.deck_config_ordering_title() }}
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'burying'}" data-on:click="$activeTab = 'burying'">
            {{ tr.deck_config_bury_title() }}
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'audio'}" data-on:click="$activeTab = 'audio'">
            {{ tr.deck_config_audio_title() }}
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'timer'}" data-on:click="$activeTab = 'timer'">
            {{ tr.deck_config_timer_title() }}
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'auto-advance'}" data-on:click="$activeTab = 'auto-advance'">
            Auto Advance
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'fsrs'}" data-on:click="$activeTab = 'fsrs'">
            FSRS
        </button>
        <button class="tab whitespace-nowrap" type="button" role="tab" data-class="{'tab-active': $activeTab == 'advanced'}" data-on:click="$activeTab = 'advanced'">
            {{ tr.deck_config_advanced_title() }}
        </button>
    </div>

    <!-- 1. Daily Limits Tab -->
    <div class="tab-pane" data-show="$activeTab == 'daily-limits'">
        <div class="section-card">
            <div class="flex justify-between items-center mb-3">
                <h5 class="mb-0 font-bold text-lg">{{ tr.deck_config_daily_limits() }}</h5>
                <span class="help-badge">
                    {% set m_limits = help_modals.get('Daily Limits', {}) %}
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        help_sections=m_limits.sections or []
                    ) }}
                </span>
            </div>

            <!-- Subtabs: Preset / This Deck / Today Only -->
            <div class="flex gap-2 mb-3">
                <button class="btn btn-sm" type="button" data-class="{'btn-primary': $activeLimitSubTab == 'preset', 'btn-outline': $activeLimitSubTab != 'preset'}" data-on:click="$activeLimitSubTab = 'preset'; $limitMode = 'preset'; $dirty = true;">
                    {{ tr.deck_config_shared_preset() }}
                </button>
                <button class="btn btn-sm" type="button" data-class="{'btn-primary': $activeLimitSubTab == 'deck', 'btn-outline': $activeLimitSubTab != 'deck'}" data-on:click="$activeLimitSubTab = 'deck'; $limitMode = 'deck'; $dirty = true;">
                    {{ tr.deck_config_deck_only() }}
                </button>
                <button class="btn btn-sm" type="button" data-class="{'btn-primary': $activeLimitSubTab == 'today', 'btn-outline': $activeLimitSubTab != 'today'}" data-on:click="$activeLimitSubTab = 'today'">
                    {{ tr.deck_config_today_only() }}
                </button>
            </div>
            <!-- Preset Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'preset'">
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="font-semibold">New cards/day</div>
                        {{ help_modal(
                            title=m_limits.title or "Daily Limits",
                            url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                            start_index=0,
                            help_sections=m_limits.sections or []
                        ) }}
                        <div class="text-base-content/60 text-xs">Maximum number of new cards to introduce each day.</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="cfg.new_per_day" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="font-semibold">Maximum reviews/day</div>
                        {{ help_modal(
                            title=m_limits.title or "Daily Limits",
                            url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                            start_index=1,
                            help_sections=m_limits.sections or []
                        ) }}
                        <div class="text-base-content/60 text-xs">Maximum number of review cards to show each day.</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="cfg.reviews_per_day" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <!-- Per-Deck Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'deck'">
                <div class="alert alert-info border border-base-300 text-xs py-2 px-3 mb-3">
                    Limits set here apply only to this specific deck (<strong>{{ deck_name }}</strong>), overriding preset limits.
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="font-semibold">Deck new cards/day</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="deckLimitNew" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="font-semibold">Deck maximum reviews/day</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="deckLimitRev" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <!-- Today-Only Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'today'">
                <div class="alert alert-info border border-base-300 text-xs py-2 px-3 mb-3">
                    Temporary limits for today only. They will automatically reset at the start of tomorrow.
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="cursor-pointer flex items-center justify-between gap-2 whitespace-normal" for="todayNewSwitch">
                            <span class="font-semibold">Enable today's new card limit</span>
                            <input class="toggle toggle-sm" type="checkbox" id="todayNewSwitch" data-bind="todayLimitNewActive" data-on:change="$dirty = true">
                        </label>
                    </div>
                    <div class="setting-input-col" data-show="$todayLimitNewActive">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="todayLimitNew" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="cursor-pointer flex items-center justify-between gap-2 whitespace-normal" for="todayRevSwitch">
                            <span class="font-semibold">Enable today's review card limit</span>
                            <input class="toggle toggle-sm" type="checkbox" id="todayRevSwitch" data-bind="todayLimitRevActive" data-on:change="$dirty = true">
                        </label>
                    </div>
                    <div class="setting-input-col" data-show="$todayLimitRevActive">
                        <input type="number" min="0" max="99999" class="input input-sm text-right w-24" data-bind="todayLimitRev" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <hr class="border-base-300 my-4">

            <!-- Global Limit Options -->
            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_new_cards_ignore_review_limit() }}</div>
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        start_index=2,
                        help_sections=m_limits.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_new_cards_ignore_review_limit_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input class="toggle toggle-sm" type="checkbox" data-bind="newCardsIgnoreReviewLimit" data-on:change="$dirty = true">
                </div>
            </div>
            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_apply_all_parent_limits() }}</div>
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        start_index=3,
                        help_sections=m_limits.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_apply_all_parent_limits_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input class="toggle toggle-sm" type="checkbox" data-bind="applyAllParentLimits" data-on:change="$dirty = true">
                </div>
            </div>
        </div>
    </div>

    <!-- 2. New Cards Tab -->
    <div class="tab-pane" data-show="$activeTab == 'new-cards'">
        <div class="section-card">
            <div class="flex justify-between items-center mb-3">
                <h5 class="mb-0 font-bold text-lg">New Cards</h5>
                <span class="help-badge">
                    {% set m_new = help_modals.get('New Cards', {}) %}
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        help_sections=m_new.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_learning_steps() }}</div>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=0,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_learning_steps_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="text" class="input input-sm text-right w-36" data-bind="learnStepsStr" data-on:input="$dirty = true" placeholder="1 10">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Graduating interval (days)</div>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=1,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_graduating_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="input input-sm text-right w-24" data-bind="cfg.graduating_interval_good" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Easy interval (days)</div>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=2,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_easy_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="input input-sm text-right w-24" data-bind="cfg.graduating_interval_easy" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_new_insertion_order() }}</div>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=3,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_new_insertion_order_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="select select-sm w-auto" data-bind="cfg.new_card_insert_order" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_new_insertion_order_sequential() }}</option>
                        <option value="1">{{ tr.deck_config_new_insertion_order_random() }}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Lapses Tab -->
    <div class="tab-pane" data-show="$activeTab == 'lapses'">
        <div class="section-card">
            <div class="flex justify-between items-center mb-3">
                <h5 class="mb-0 font-bold text-lg">Lapses</h5>
                <span class="help-badge">
                    {% set m_lapses = help_modals.get('Lapses', {}) %}
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        help_sections=m_lapses.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_relearning_steps() }}</div>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=0,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_relearning_steps_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="text" class="input input-sm text-right w-36" data-bind="relearnStepsStr" data-on:input="$dirty = true" placeholder="10">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Minimum interval (days)</div>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=1,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_minimum_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="input input-sm text-right w-24" data-bind="cfg.minimum_lapse_interval" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Leech threshold (lapses)</div>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=2,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_leech_threshold_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="0" max="999" class="input input-sm text-right w-24" data-bind="cfg.leech_threshold" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Leech action</div>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=3,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_leech_action_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="select select-sm w-auto" data-bind="cfg.leech_action" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_suspend_leeches() }}</option>
                        <option value="1">Tag Only</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Display Order Tab -->
    <div class="tab-pane" data-show="$activeTab == 'display-order'">
        <div class="section-card">
            <div class="flex justify-between items-center mb-3">
                <h5 class="mb-0 font-bold text-lg">{{ tr.deck_config_ordering_title() }}</h5>
                <span class="help-badge">
                    {% set m_order = help_modals.get('Display Order', {}) %}
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        help_sections=m_order.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_new_gather_priority() }}</div>
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        start_index=0,
                        help_sections=m_order.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_new_gather_priority_tooltip_2() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="select select-sm w-auto" data-bind="cfg.new_card_gather_priority" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_new_gather_priority_deck() }}</option>
                        <option value="5">{{ tr.deck_config_new_gather_priority_deck_then_random_notes() }}</option>
                        <option value="1">{{ tr.deck_config_new_gather_priority_position_lowest_first() }}</option>
                        <option value="2">{{ tr.deck_config_new_gather_priority_position_highest_first() }}</option>
                        <option value="3">{{ tr.deck_config_new_gather_priority_random_notes() }}</option>
                        <option value="4">{{ tr.deck_config_new_gather_priority_random_cards() }}</option>
                    </select>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_new_card_sort_order() }}</div>
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        start_index=1,
                        help_sections=m_order.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_new_card_sort_order_tooltip_2() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="select select-sm w-auto" data-bind="cfg.new_card_sort_order" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_sort_order_template_then_gather() }}</option>
                        <option value="1">{{ tr.deck_config_sort_order_gather() }}</option>
                        <option value="2">{{ tr.deck_config_sort_order_card_template_then_random() }}</option>
                        <option value="3">{{ tr.deck_config_sort_order_random_note_then_template() }}</option>
                        <option value="4">{{ tr.deck_config_sort_order_random() }}</option>
                    </select>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">{{ tr.deck_config_new_review_priority() }}</div>
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
