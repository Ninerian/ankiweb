{% from "components/titled_container.html.jinja" import titled_container %}
{% from "components/collapsible.html.jinja" import collapsible %}
{% from "components/help_modal.html.jinja" import help_modal %}
{% from "components/switch.html.jinja" import switch %}
{% from "components/enum_selector.html.jinja" import enum_selector %}
{% from "components/spin_box.html.jinja" import spin_box %}
{% from "components/modal.html.jinja" import modal %}

<div class="route-deck-options container-fluid" data-signals="{{ signals | tojson | forceescape }}">
    <!-- Sticky Header -->
    <div class="deck-options-header d-flex justify-content-between align-items-center mb-3">
        <div class="preset-selector-row d-flex align-items-center gap-2">
            <span class="fw-bold">{{ tr.card_stats_preset() }}:</span>
            <div id="presetSelectorWrap">
                <select id="presetSelector" class="form-select form-select-sm w-auto" data-bind="presetId" data-on:change="@post('/deck-options/change-preset')">
                    {% for p in all_configs %}
                        <option value="{{ p.id }}" {% if p.id == preset_id %}selected{% endif %}>
                            {{ p.name }}{% if p.use_count %} ({{ p.use_count }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Preset Action Dropdown -->
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    ⚙️
                </button>
                <ul class="dropdown-menu">
                    <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#addPresetModal">{{ tr.deck_config_add_group() }}</button></li>
                    <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#clonePresetModal">{{ tr.deck_config_clone_group() }}</button></li>
                    <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#renamePresetModal">{{ tr.deck_config_rename_group() }}</button></li>
                    <li><button class="dropdown-item text-danger" type="button" data-attr:disabled="$presetId == 1" data-bs-toggle="modal" data-bs-target="#deletePresetModal">{{ tr.deck_config_remove_group() }}</button></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><button class="dropdown-item" type="button" data-on:click="$applyToSubdecks = true; @post('/deck-options/save'); $applyToSubdecks = false;">{{ tr.deck_config_save_to_all_subdecks() }}</button></li>
                </ul>
            </div>

            <span class="badge bg-warning text-dark ms-2" data-show="$dirty">Unsaved changes</span>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-show="$dirty" data-on:click="@post('/deck-options/revert')">
                Revert
            </button>
            <button class="btn btn-sm btn-primary" type="button" data-on:click="$applyToSubdecks = false; @post('/deck-options/save')">
                {{ tr.deck_config_save_button() }}
            </button>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-on:click="if (!$dirty || confirm('You have unsaved changes. Are you sure you want to close?')) { window.location.href = '/deckbrowser'; }">
                Close
            </button>
        </div>
    </div>

    <!-- Status / Warnings Area -->
    <div class="mb-3" data-show="$statusMessage && $statusMessage !== ''">
        <div class="alert alert-info py-2 px-3 mb-0" data-text="$statusMessage"></div>
    </div>
    <div class="mb-3" data-show="$warnings.length > 0">
        <div class="alert alert-warning py-2 px-3 mb-0">
            <template data-for="w in $warnings">
                <div data-text="w"></div>
            </template>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs deck-options-nav mb-4">
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'daily-limits'}" data-on:click="$activeTab = 'daily-limits'">
                {{ tr.deck_config_daily_limits() }}
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'new-cards'}" data-on:click="$activeTab = 'new-cards'">
                New Cards
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'lapses'}" data-on:click="$activeTab = 'lapses'">
                Lapses
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'display-order'}" data-on:click="$activeTab = 'display-order'">
                {{ tr.deck_config_ordering_title() }}
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'burying'}" data-on:click="$activeTab = 'burying'">
                {{ tr.deck_config_bury_title() }}
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'audio'}" data-on:click="$activeTab = 'audio'">
                {{ tr.deck_config_audio_title() }}
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'timer'}" data-on:click="$activeTab = 'timer'">
                {{ tr.deck_config_timer_title() }}
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'auto-advance'}" data-on:click="$activeTab = 'auto-advance'">
                Auto Advance
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'fsrs'}" data-on:click="$activeTab = 'fsrs'">
                FSRS
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" type="button" data-class="{'active': $activeTab == 'advanced'}" data-on:click="$activeTab = 'advanced'">
                {{ tr.deck_config_advanced_title() }}
            </button>
        </li>
    </ul>

    <!-- 1. Daily Limits Tab -->
    <div class="tab-pane" data-show="$activeTab == 'daily-limits'">
        <div class="section-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">{{ tr.deck_config_daily_limits() }}</h5>
                <span class="help-badge">
                    {% set m_limits = help_modals.get('Daily Limits', {}) %}
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        help_sections=m_limits.sections or []
                    ) }}
                </span>
            </div>

            <!-- Subtabs: Preset / This Deck / Today Only -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3" type="button" data-class="{'active': $activeLimitSubTab == 'preset'}" data-on:click="$activeLimitSubTab = 'preset'; $limitMode = 'preset'; $dirty = true;">
                        {{ tr.deck_config_shared_preset() }}
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3" type="button" data-class="{'active': $activeLimitSubTab == 'deck'}" data-on:click="$activeLimitSubTab = 'deck'; $limitMode = 'deck'; $dirty = true;">
                        {{ tr.deck_config_deck_only() }}
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3" type="button" data-class="{'active': $activeLimitSubTab == 'today'}" data-on:click="$activeLimitSubTab = 'today'">
                        {{ tr.deck_config_today_only() }}
                    </button>
                </li>
            </ul>

            <!-- Preset Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'preset'">
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="form-label mb-0 fw-semibold">New cards/day</label>
                        {{ help_modal(
                            title=m_limits.title or "Daily Limits",
                            url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                            start_index=0,
                            help_sections=m_limits.sections or []
                        ) }}
                        <div class="text-muted small">Maximum number of new cards to introduce each day.</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.new_per_day" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="form-label mb-0 fw-semibold">Maximum reviews/day</label>
                        {{ help_modal(
                            title=m_limits.title or "Daily Limits",
                            url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                            start_index=1,
                            help_sections=m_limits.sections or []
                        ) }}
                        <div class="text-muted small">Maximum number of review cards to show each day.</div>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.reviews_per_day" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <!-- Per-Deck Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'deck'">
                <div class="alert alert-light border small py-2 px-3 mb-3">
                    Limits set here apply only to this specific deck (<strong>{{ deck_name }}</strong>), overriding preset limits.
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="form-label mb-0 fw-semibold">Deck new cards/day</label>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="deckLimitNew" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <label class="form-label mb-0 fw-semibold">Deck maximum reviews/day</label>
                    </div>
                    <div class="setting-input-col">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="deckLimitRev" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <!-- Today-Only Limits SubTab -->
            <div data-show="$activeLimitSubTab == 'today'">
                <div class="alert alert-light border small py-2 px-3 mb-3">
                    Temporary limits for today only. They will automatically reset at the start of tomorrow.
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="todayNewSwitch" data-bind="todayLimitNewActive" data-on:change="$dirty = true">
                            <label class="form-check-label fw-semibold" for="todayNewSwitch">Enable today's new card limit</label>
                        </div>
                    </div>
                    <div class="setting-input-col" data-show="$todayLimitNewActive">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="todayLimitNew" data-on:input="$dirty = true">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-label-col">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="todayRevSwitch" data-bind="todayLimitRevActive" data-on:change="$dirty = true">
                            <label class="form-check-label fw-semibold" for="todayRevSwitch">Enable today's review card limit</label>
                        </div>
                    </div>
                    <div class="setting-input-col" data-show="$todayLimitRevActive">
                        <input type="number" min="0" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="todayLimitRev" data-on:input="$dirty = true">
                    </div>
                </div>
            </div>

            <hr>

            <!-- Global Limit Options -->
            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_new_cards_ignore_review_limit() }}</label>
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        start_index=2,
                        help_sections=m_limits.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_new_cards_ignore_review_limit_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" data-bind="newCardsIgnoreReviewLimit" data-on:change="$dirty = true">
                    </div>
                </div>
            </div>
            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_apply_all_parent_limits() }}</label>
                    {{ help_modal(
                        title=m_limits.title or "Daily Limits",
                        url=m_limits.url or "https://docs.ankiweb.net/deck-options.html#daily-limits",
                        start_index=3,
                        help_sections=m_limits.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_apply_all_parent_limits_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" data-bind="applyAllParentLimits" data-on:change="$dirty = true">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. New Cards Tab -->
    <div class="tab-pane" data-show="$activeTab == 'new-cards'">
        <div class="section-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">New Cards</h5>
                <span class="help-badge">
                    {% set m_new = help_modals.get('New Cards', {}) %}
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        help_sections=m_new.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_learning_steps() }}</label>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=0,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_learning_steps_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="text" class="form-control form-control-sm text-end" style="width: 140px;" data-bind="learnStepsStr" data-on:input="$dirty = true" placeholder="1 10">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Graduating interval (days)</label>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=1,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_graduating_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.graduating_interval_good" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Easy interval (days)</label>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=2,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_easy_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.graduating_interval_easy" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_new_insertion_order() }}</label>
                    {{ help_modal(
                        title=m_new.title or "New Cards",
                        url=m_new.url or "https://docs.ankiweb.net/deck-options.html#new-cards",
                        start_index=3,
                        help_sections=m_new.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_new_insertion_order_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="form-select form-select-sm" data-bind="cfg.new_card_insert_order" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_new_insertion_order_sequential() }}</option>
                        <option value="1">{{ tr.deck_config_new_insertion_order_random() }}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Lapses Tab -->
    <div class="tab-pane" data-show="$activeTab == 'lapses'">
        <div class="section-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Lapses</h5>
                <span class="help-badge">
                    {% set m_lapses = help_modals.get('Lapses', {}) %}
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        help_sections=m_lapses.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_relearning_steps() }}</label>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=0,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_relearning_steps_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="text" class="form-control form-control-sm text-end" style="width: 140px;" data-bind="relearnStepsStr" data-on:input="$dirty = true" placeholder="10">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Minimum interval (days)</label>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=1,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_minimum_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="1" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.minimum_lapse_interval" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Leech threshold (lapses)</label>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=2,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_leech_threshold_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" min="0" max="999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.leech_threshold" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Leech action</label>
                    {{ help_modal(
                        title=m_lapses.title or "Lapses",
                        url=m_lapses.url or "https://docs.ankiweb.net/deck-options.html#lapses",
                        start_index=3,
                        help_sections=m_lapses.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_leech_action_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="form-select form-select-sm" data-bind="cfg.leech_action" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_suspend_leeches() }}</option>
                        <option value="1">Tag Only</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Display Order Tab -->
    <div class="tab-pane" data-show="$activeTab == 'display-order'">
        <div class="section-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">{{ tr.deck_config_ordering_title() }}</h5>
                <span class="help-badge">
                    {% set m_order = help_modals.get('Display Order', {}) %}
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        help_sections=m_order.sections or []
                    ) }}
                </span>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_new_gather_priority() }}</label>
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        start_index=0,
                        help_sections=m_order.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_new_gather_priority_tooltip_2() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="form-select form-select-sm" data-bind="cfg.new_card_gather_priority" data-on:change="$dirty = true">
                        <option value="0">{{ tr.deck_config_new_gather_priority_deck() }}</option>
                        <option value="5">{{ tr.deck_config_new_gather_priority_deck_then_random_notes() }}</option>
                        <option value="1">{{ tr.deck_config_new_gather_priority_position_lowest_first() }}</option>
                        <option value="2">{{ tr.deck_config_new_gather_priority_position_highest_first() }}</option>
                        <option value="3">{{ tr.deck_config_new_gather_priority_random_notes() }}</option>
                        <option value="4">{{ tr.deck_config_new_gather_priority_random_cards() }}</option>
                    </select>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_new_card_sort_order() }}</label>
                    {{ help_modal(
                        title=m_order.title or "Display Order",
                        url=m_order.url or "https://docs.ankiweb.net/deck-options.html#display-order",
                        start_index=1,
                        help_sections=m_order.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_new_card_sort_order_tooltip_2() }}</div>
                </div>
                <div class="setting-input-col">
                    <select class="form-select form-select-sm" data-bind="cfg.new_card_sort_order" data-on:change="$dirty = true">
