                    <input type="number" min="1" max="99999" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.maximum_review_interval" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">{{ tr.deck_config_historical_retention() }}</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=1,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_historical_retention_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.01" min="0.70" max="0.99" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.historical_retention" data-on:input="$dirty = true">
                </div>
            </div>

            <!-- Legacy SM-2 section -->
            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Starting ease</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=3,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_starting_ease_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="1.3" max="5.0" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.initial_ease" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Easy bonus</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=4,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_easy_bonus_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="1.0" max="5.0" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.easy_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Interval modifier</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=5,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_interval_modifier_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.5" max="5.0" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.interval_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">Hard interval multiplier</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=6,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_hard_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.5" max="5.0" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.hard_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <label class="form-label mb-0 fw-semibold">New interval multiplier</label>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=7,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-muted small">{{ tr.deck_config_new_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.0" max="1.0" class="form-control form-control-sm text-end" style="width: 100px;" data-bind="cfg.lapse_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <!-- Custom Card State Customizer -->
            <div class="mt-4">
                <label class="form-label fw-semibold">{{ tr.deck_config_custom_scheduling() }}</label>
                {{ help_modal(
                    title=m_adv.title or "Advanced",
                    url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                    start_index=8,
                    help_sections=m_adv.sections or []
                ) }}
                <div class="text-muted small mb-2">{{ tr.deck_config_custom_scheduling_tooltip() }}</div>
                <textarea class="form-control font-monospace small" rows="5" data-bind="cardStateCustomizer" data-on:input="$dirty = true"></textarea>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Add Preset Modal -->
    <div class="modal fade" id="addPresetModal" tabindex="-1" aria-labelledby="addPresetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addPresetModalLabel">{{ tr.deck_config_add_group() }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">{{ tr.deck_config_name_prompt() }}</label>
                    <input type="text" class="form-control" data-bind="newPresetName" placeholder="New Preset">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-on:click="@post('/deck-options/add-preset')">Add</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Clone Preset Modal -->
    <div class="modal fade" id="clonePresetModal" tabindex="-1" aria-labelledby="clonePresetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="clonePresetModalLabel">{{ tr.deck_config_clone_group() }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">{{ tr.deck_config_name_prompt() }}</label>
                    <input type="text" class="form-control" data-bind="clonePresetName" placeholder="Cloned Preset">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-on:click="@post('/deck-options/clone-preset')">Clone</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Rename Preset Modal -->
    <div class="modal fade" id="renamePresetModal" tabindex="-1" aria-labelledby="renamePresetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="renamePresetModalLabel">{{ tr.deck_config_rename_group() }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">{{ tr.deck_config_name_prompt() }}</label>
                    <input type="text" class="form-control" data-bind="renamePresetName" placeholder="Rename Preset">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-on:click="@post('/deck-options/rename-preset')">Rename</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Preset Modal -->
    <div class="modal fade" id="deletePresetModal" tabindex="-1" aria-labelledby="deletePresetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deletePresetModalLabel">{{ tr.deck_config_remove_group() }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger mb-0">{{ tr.deck_config_will_require_full_sync() }}</p>
                    <p class="mt-2">Are you sure you want to delete this preset?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal" data-on:click="@post('/deck-options/delete-preset')">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
