            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Easy bonus</div>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=4,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_easy_bonus_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="1.0" max="5.0" class="input input-sm text-right w-24" data-bind="cfg.easy_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Interval modifier</div>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=5,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_interval_modifier_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.5" max="5.0" class="input input-sm text-right w-24" data-bind="cfg.interval_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">Hard interval multiplier</div>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=6,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_hard_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.5" max="5.0" class="input input-sm text-right w-24" data-bind="cfg.hard_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label-col">
                    <div class="font-semibold">New interval multiplier</div>
                    {{ help_modal(
                        title=m_adv.title or "Advanced",
                        url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                        start_index=7,
                        help_sections=m_adv.sections or []
                    ) }}
                    <div class="text-base-content/60 text-xs">{{ tr.deck_config_new_interval_tooltip() }}</div>
                </div>
                <div class="setting-input-col">
                    <input type="number" step="0.05" min="0.0" max="1.0" class="input input-sm text-right w-24" data-bind="cfg.lapse_multiplier" data-on:input="$dirty = true">
                </div>
            </div>

            <!-- Custom Card State Customizer -->
            <div class="mt-4">
                <div class="font-semibold">{{ tr.deck_config_custom_scheduling() }}</div>
                {{ help_modal(
                    title=m_adv.title or "Advanced",
                    url=m_adv.url or "https://docs.ankiweb.net/deck-options.html#advanced",
                    start_index=8,
                    help_sections=m_adv.sections or []
                ) }}
                <div class="text-base-content/60 text-xs mb-2">{{ tr.deck_config_custom_scheduling_tooltip() }}</div>
                <textarea class="textarea font-mono text-sm w-full" rows="5" data-bind="cardStateCustomizer" data-on:input="$dirty = true"></textarea>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Add Preset Modal -->
    <dialog class="modal" id="addPresetModal">
        <div class="modal-box">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="addPresetModalLabel">{{ tr.deck_config_add_group() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <label class="block py-1 text-sm font-semibold">{{ tr.deck_config_name_prompt() }}</label>
                <input type="text" class="input input-sm w-full" data-bind="newPresetName" placeholder="New Preset">
            </div>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-sm btn-ghost">Cancel</button>
                </form>
                <button type="button" class="btn btn-sm btn-primary" data-on:click="@post('/deck-options/add-preset')">Add</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Clone Preset Modal -->
    <dialog class="modal" id="clonePresetModal">
        <div class="modal-box">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="clonePresetModalLabel">{{ tr.deck_config_clone_group() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <label class="block py-1 text-sm font-semibold">{{ tr.deck_config_name_prompt() }}</label>
                <input type="text" class="input input-sm w-full" data-bind="clonePresetName" placeholder="Cloned Preset">
            </div>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-sm btn-ghost">Cancel</button>
                </form>
                <button type="button" class="btn btn-sm btn-primary" data-on:click="@post('/deck-options/clone-preset')">Clone</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Rename Preset Modal -->
    <dialog class="modal" id="renamePresetModal">
        <div class="modal-box">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="renamePresetModalLabel">{{ tr.deck_config_rename_group() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <label class="block py-1 text-sm font-semibold">{{ tr.deck_config_name_prompt() }}</label>
                <input type="text" class="input input-sm w-full" data-bind="renamePresetName" placeholder="Rename Preset">
            </div>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-sm btn-ghost">Cancel</button>
                </form>
                <button type="button" class="btn btn-sm btn-primary" data-on:click="@post('/deck-options/rename-preset')">Rename</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Delete Preset Modal -->
    <dialog class="modal" id="deletePresetModal">
        <div class="modal-box">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="deletePresetModalLabel">{{ tr.deck_config_remove_group() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <p class="text-error mb-0">{{ tr.deck_config_will_require_full_sync() }}</p>
                <p class="mt-2 text-sm">Are you sure you want to delete this preset?</p>
            </div>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-sm btn-ghost">Cancel</button>
                </form>
                <button type="button" class="btn btn-sm btn-error" data-on:click="@post('/deck-options/delete-preset')">Delete</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>
</div>
