{% from "components/titled_container.html.jinja" import titled_container %}
{% from "components/enum_selector.html.jinja" import enum_selector %}
{% from "components/checkbox.html.jinja" import checkbox %}

<div id="import-csv-content" class="route-import-csv" data-signals="{{ initial_signals_json }}">
  <!-- Sticky Top Bar -->
  <div class="sticky top-0 sticky-top-bar flex justify-between items-center mb-3">
    <div class="filename text-base">
      {{ filename }}
    </div>
    <div>
      <button
        id="import-csv-submit-btn"
        type="button"
        class="btn btn-primary btn-sm import-btn-inner"
        title="Ctrl+Enter"
        data-on:click="@post('/import-csv/submit')"
      >
        {{ tr.actions_import() }}
      </button>
    </div>
  </div>

  <div id="import-alert-area">
    {% if error_msg %}
      <div class="alert alert-error py-2 px-3 mb-3">{{ error_msg }}</div>
    {% endif %}
    {% if info_msg %}
      <div class="alert alert-info py-2 px-3 mb-3">{{ info_msg }}</div>
    {% endif %}
  </div>

  <div class="w-full px-1">
    <!-- 1. File Options Section -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box flex justify-between items-center">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.importing_file() }}</h5>
        <button
          type="button"
          class="btn btn-sm btn-ghost p-0 text-base-content/60"
          data-on:click="$active_help = ($active_help === 'file' ? '' : 'file')"
          title="{{ tr.actions_help() }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-circle" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
          </svg>
        </button>
      </div>

      <div class="card-body p-3">
        <!-- Help Area -->
        <div data-show="$active_help === 'file'" class="alert alert-info block py-2 px-3 mb-3">
          {% for sec in help_dict.file.sections %}
            <h6 class="font-bold mb-1">{{ sec.title }}</h6>
            <p class="text-sm mb-2">{{ sec.content | replace('\n', '<br>') | safe }}</p>
          {% endfor %}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
          <!-- Delimiter -->
          <div>
            <label class="label text-sm font-semibold py-1">
              {% if force_delimiter %}
                {{ tr.importing_field_separator() }}
              {% else %}
                {{ tr.importing_field_separator_guessed() }}
              {% endif %}
            </label>
            <select
              id="csv-delimiter-select"
              class="select select-sm w-full"
              data-bind="delimiter"
              {% if force_delimiter %}disabled{% endif %}
              data-on:change="@post('/import-csv/update-options')"
            >
              {% for choice in delimiter_choices %}
                <option value="{{ choice.value }}" {% if choice.value == delimiter %}selected{% endif %}>
                  {{ choice.label }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- HTML Checkbox -->
          <div class="flex items-end pb-1">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input
                id="csv-is-html-check"
                type="checkbox"
                class="checkbox checkbox-sm"
                data-bind="is_html"
                {% if force_is_html %}disabled{% endif %}
                {% if is_html %}checked{% endif %}
                data-on:change="@post('/import-csv/update-options')"
              >
              <span class="text-sm">
                {{ tr.importing_allow_html_in_fields() }}
              </span>
            </label>
          </div>
        </div>

        <!-- Preview Table -->
        <div class="preview-outer border border-base-300 rounded-box">
          <table class="preview-table">
            <thead>
              <tr>
                {% for h in preview_headers %}
                  <th>{{ h }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in preview_rows %}
                <tr>
                  {% for val in row %}
                    <td>{{ val }}</td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 2. Import Options Section -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box flex justify-between items-center">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.importing_import_options() }}</h5>
        <button
          type="button"
          class="btn btn-sm btn-ghost p-0 text-base-content/60"
          data-on:click="$active_help = ($active_help === 'import_options' ? '' : 'import_options')"
          title="{{ tr.actions_help() }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-circle" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
          </svg>
        </button>
      </div>

      <div class="card-body p-3">
        <!-- Help Area -->
        <div data-show="$active_help === 'import_options'" class="alert alert-info block py-2 px-3 mb-3">
          {% for sec in help_dict.import_options.sections %}
            <h6 class="font-bold mb-1">{{ sec.title }}</h6>
            <p class="text-sm mb-2">{{ sec.content | replace('\n', '<br>') | safe }}</p>
          {% endfor %}
        </div>

        {% if new_deck_warning %}
          <div class="alert alert-info py-2 px-3 mb-3">
            {{ new_deck_warning }}
          </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
          <!-- Notetype -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.notetypes_notetype() }}</label>
            <select
              id="csv-notetype-select"
              class="select select-sm w-full"
              data-bind="notetype_id"
              data-on:change="@post('/import-csv/update-options')"
            >
              {% for nt in notetypes %}
                <option value="{{ nt.id }}" {% if nt.id == selected_notetype_id %}selected{% endif %}>
                  {{ nt.name }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- Deck -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.decks_deck() }}</label>
            <select
              id="csv-deck-select"
              class="select select-sm w-full"
              data-bind="deck_id"
              data-on:change="@post('/import-csv/update-options')"
            >
              {% for d in decks %}
                <option value="{{ d.id }}" {% if d.id == selected_deck_id %}selected{% endif %}>
                  {{ d.name }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
          <!-- Dupe Resolution -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.importing_existing_notes() }}</label>
            <select
              id="csv-dupe-resolution-select"
              class="select select-sm w-full"
              data-bind="dupe_resolution"
            >
              {% for choice in dupe_resolution_choices %}
                <option value="{{ choice.value }}" {% if choice.value == dupe_resolution %}selected{% endif %}>
                  {{ choice.label }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- Match Scope -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.importing_match_scope() }}</label>
            <select
              id="csv-match-scope-select"
              class="select select-sm w-full"
              data-bind="match_scope"
            >
              {% for choice in match_scope_choices %}
                <option value="{{ choice.value }}" {% if choice.value == match_scope %}selected{% endif %}>
                  {{ choice.label }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <!-- Global Tags -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.importing_tag_all_notes() }}</label>
            <input
              type="text"
              class="input input-sm w-full"
              data-bind="global_tags"
              value="{{ global_tags }}"
              placeholder="tags separated by spaces"
            >
          </div>

          <!-- Updated Tags -->
          <div>
            <label class="label text-sm font-semibold py-1">{{ tr.importing_tag_updated_notes() }}</label>
            <input
              type="text"
              class="input input-sm w-full"
              data-bind="updated_tags"
              value="{{ updated_tags }}"
              placeholder="tags separated by spaces"
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Field Mapping Section -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.importing_field_mapping() }}</h5>
      </div>

      <div class="card-body p-3">
        <!-- Field Rows -->
        {% for row in field_rows %}
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center mb-2">
            <div class="sm:col-span-4 md:col-span-3">
              <span class="text-sm font-semibold">{{ row.name }}</span>
            </div>
            <div class="sm:col-span-8 md:col-span-5">
              <select
                id="csv-field-col-{{ row.index }}"
                class="select select-sm w-full"
                data-bind="field_col_{{ row.index }}"
              >
                {% for opt in row.options %}
                  <option
                    value="{{ opt.value }}"
                    {% if opt.value == row.selected_column %}selected{% endif %}
                    {% if opt.disabled %}disabled{% endif %}
                  >
                    {{ opt.label }}
                  </option>
                {% endfor %}
              </select>
            </div>
          </div>
        {% endfor %}

        <!-- Tags Column -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center mb-2 pt-2 border-t border-base-300">
          <div class="sm:col-span-4 md:col-span-3">
            <span class="text-sm font-semibold">{{ tr.editing_tags() }}</span>
          </div>
          <div class="sm:col-span-8 md:col-span-5">
            <select
              id="csv-tags-column-select"
              class="select select-sm w-full"
              data-bind="tags_column"
            >
              {% for opt in column_options %}
                <option
                  value="{{ opt.value }}"
                  {% if opt.value == tags_column %}selected{% endif %}
                  {% if opt.disabled %}disabled{% endif %}
                >
                  {{ opt.label }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
