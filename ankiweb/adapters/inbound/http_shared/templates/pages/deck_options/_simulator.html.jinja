{# FSRS Simulator and Workload Modal Partial #}
{% from "components/spin_box.html.jinja" import spin_box %}
{% from "components/switch.html.jinja" import switch %}

<div class="route-deck-options-sim mt-4" data-signals='{"simDaysToSimulate": 365, "simDeckSize": 0, "simDesiredRetention": 0.9, "simNewLimit": 20, "simReviewLimit": 200, "simMaxInterval": 36500, "simSmooth": true, "simSubgraph": "count", "simSuspendLeeches": false, "simLeechThreshold": 8, "workloadDaysToSimulate": 365, "workloadDeckSize": 0, "workloadNewLimit": 20, "workloadReviewLimit": 9999, "workloadMaxInterval": 36500, "workloadSubgraph": "ratio"}'>
    <h5 class="font-bold mb-3 border-b border-base-300 pb-2">{{ tr.deck_config_fsrs_simulator_experimental() }}</h5>
    
    <div class="flex flex-wrap gap-2 mb-3">
        <!-- Button to open FSRS Simulator Modal -->
        <button
            type="button"
            class="btn btn-sm btn-primary"
            onclick="document.getElementById('fsrsSimulatorModal').showModal()"
            id="openSimulatorBtn"
        >
            {{ tr.deck_config_fsrs_simulator_experimental() }}
        </button>

        <!-- Button to open Workload / Desired Retention Simulator Modal -->
        <button
            type="button"
            class="btn btn-sm btn-outline btn-primary"
            onclick="document.getElementById('fsrsWorkloadModal').showModal()"
            id="openWorkloadBtn"
        >
            {{ tr.deck_config_fsrs_simulate_desired_retention_experimental() }}
        </button>
    </div>

    <!-- Simulator Modal -->
    <dialog class="modal" id="fsrsSimulatorModal">
        <div class="modal-box max-w-5xl max-h-[90vh]">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="fsrsSimulatorModalLabel">{{ tr.deck_config_fsrs_simulator_experimental() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <!-- Controls -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.deck_config_days_to_simulate() }}</label>
                        <input type="number" class="input input-sm w-full" min="1" max="3650" data-bind="simDaysToSimulate" id="simDaysInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.deck_config_additional_new_cards_to_simulate() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="100000" data-bind="simDeckSize" id="simDeckSizeInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.deck_config_desired_retention() }}</label>
                        <input type="number" step="0.01" min="0.70" max="0.99" class="input input-sm w-full" data-bind="simDesiredRetention" id="simRetentionInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_new_cardsday() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="9999" data-bind="simNewLimit" id="simNewLimitInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_maximum_reviewsday() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="9999" data-bind="simReviewLimit" id="simReviewLimitInput" />
                    </div>
                </div>

                <!-- Easy Days Collapsible -->
                <details class="collapse collapse-arrow mb-3 border border-base-300 bg-base-100 rounded-box">
                    <summary class="collapse-title font-semibold text-sm min-h-0 py-2">{{ tr.deck_config_easy_days_title() }}</summary>
                    <div class="collapse-content pt-2">
                        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
                            {% set day_names = [
                                tr.deck_config_easy_days_monday(),
                                tr.deck_config_easy_days_tuesday(),
                                tr.deck_config_easy_days_wednesday(),
                                tr.deck_config_easy_days_thursday(),
                                tr.deck_config_easy_days_friday(),
                                tr.deck_config_easy_days_saturday(),
                                tr.deck_config_easy_days_sunday()
                            ] %}
                            {% for i in range(7) %}
                            <div>
                                <label class="text-xs text-base-content/60 block text-center mb-1">{{ day_names[i] }}</label>
                                <input type="range" class="range range-xs" min="0.0" max="1.0" step="0.5" data-bind="simEasyDaysPercentages[{{ i }}]" />
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </details>

                <!-- Advanced Settings Collapsible -->
                <details class="collapse collapse-arrow mb-3 border border-base-300 bg-base-100 rounded-box">
                    <summary class="collapse-title font-semibold text-sm min-h-0 py-2">{{ tr.deck_config_advanced_settings() }}</summary>
                    <div class="collapse-content pt-2">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            <div>
                                <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_maximum_interval() }}</label>
                                <input type="number" class="input input-sm w-full" min="1" max="36500" data-bind="simMaxInterval" />
                            </div>
                            <div class="flex items-center pt-6">
                                <label class="cursor-pointer inline-flex items-center gap-2" for="simSmoothCheck">
                                    <input class="toggle toggle-sm" type="checkbox" id="simSmoothCheck" data-bind="simSmooth" />
                                    <span class="text-sm font-semibold whitespace-normal">{{ tr.deck_config_smooth_graph() }}</span>
                                </label>
                            </div>
                            <div class="flex items-center pt-6">
                                <label class="cursor-pointer inline-flex items-center gap-2" for="simSuspendCheck">
                                    <input class="toggle toggle-sm" type="checkbox" id="simSuspendCheck" data-bind="simSuspendLeeches" />
                                    <span class="text-sm font-semibold whitespace-normal">{{ tr.deck_config_suspend_leeches() }}</span>
                                </label>
                            </div>
                            <div data-show="$simSuspendLeeches">
                                <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_leech_threshold() }}</label>
                                <input type="number" class="input input-sm w-full" min="1" max="9999" data-bind="simLeechThreshold" />
                            </div>
                        </div>
                    </div>
                </details>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-2 mb-3 items-center">
                    <button
                        type="button"
                        class="btn btn-sm btn-primary"
                        data-attr:disabled="$simProcessing ? true : false"
                        data-on:click="$simProcessing = true; @post('/deck-options/sim/run-simulator')"
                        id="simulateBtn"
                    >
                        <span data-show="!$simProcessing">{{ tr.deck_config_simulate() }}</span>
                        <span data-show="$simProcessing">Simulating...</span>
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline"
                        data-attr:disabled="(!$simHistory || $simHistory.length === 0 || $simProcessing) ? true : false"
                        data-on:click="@post('/deck-options/sim/clear-simulation')"
                        id="clearSimBtn"
                    >
                        {{ tr.deck_config_clear_last_simulate() }}
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline btn-success"
                        data-attr:disabled="$simProcessing ? true : false"
                        data-on:click="@post('/deck-options/sim/save-sim-to-preset')"
                        id="saveSimBtn"
                    >
                        {{ tr.deck_config_save_options_to_preset() }}
                    </button>

                    <span class="text-xs text-base-content/60 ms-2" data-show="$simProcessing">
                        {{ tr.actions_processing() }}
                    </span>
                    <span class="text-xs text-error ms-2" data-show="$simError" data-text="$simError"></span>
                    <span class="text-xs text-success ms-2" data-show="$simSavedSuccess">Saved to preset!</span>
                </div>

                <!-- Radio Group for Subgraphs -->
                <div class="sim-radio-group border-t border-base-300 pt-2 flex flex-wrap gap-4">
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="simSubgraph"
                            value="count"
                            data-bind="simSubgraph"
                            data-on:change="$simMode = 'review'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.deck_config_fsrs_simulator_radio_count() }}
                    </label>
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="simSubgraph"
                            value="time"
                            data-bind="simSubgraph"
                            data-on:change="$simMode = 'review'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.statistics_reviews_time_checkbox() }}
                    </label>
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="simSubgraph"
                            value="memorized"
                            data-bind="simSubgraph"
                            data-on:change="$simMode = 'review'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.deck_config_fsrs_simulator_radio_memorized() }}
                    </label>
                </div>

                <!-- SVG Chart Container -->
                <div id="simChartContainer" class="sim-svg-container mt-2">
                    <div class="text-base-content/60 text-xs">No simulation data. Click "Simulate" to run.</div>
                </div>

                <!-- Table Data / Legend Summary -->
                <div id="simTableContainer" class="mt-3"></div>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Workload / Desired Retention Modal -->
    <dialog class="modal" id="fsrsWorkloadModal">
        <div class="modal-box max-w-5xl max-h-[90vh]">
            <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
                <h5 class="font-bold text-lg" id="fsrsWorkloadModalLabel">{{ tr.deck_config_fsrs_simulate_desired_retention_experimental() }}</h5>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost">✕</button>
                </form>
            </div>
            <div>
                <!-- Controls -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.deck_config_days_to_simulate() }}</label>
                        <input type="number" class="input input-sm w-full" min="1" max="3650" data-bind="workloadDaysToSimulate" id="workloadDaysInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.deck_config_additional_new_cards_to_simulate() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="100000" data-bind="workloadDeckSize" id="workloadDeckSizeInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_new_cardsday() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="9999" data-bind="workloadNewLimit" id="workloadNewLimitInput" />
                    </div>
                    <div>
                        <label class="block py-1 text-sm font-semibold whitespace-normal">{{ tr.scheduling_maximum_reviewsday() }}</label>
                        <input type="number" class="input input-sm w-full" min="0" max="9999" data-bind="workloadReviewLimit" id="workloadReviewLimitInput" />
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-2 mb-3 items-center">
                    <button
                        type="button"
                        class="btn btn-sm btn-primary"
                        data-attr:disabled="$workloadProcessing ? true : false"
                        data-on:click="$workloadProcessing = true; @post('/deck-options/sim/run-workload')"
                        id="simulateWorkloadBtn"
                    >
                        <span data-show="!$workloadProcessing">{{ tr.deck_config_simulate() }}</span>
                        <span data-show="$workloadProcessing">Simulating...</span>
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline"
                        data-attr:disabled="(!$workloadHistory || $workloadHistory.length === 0 || $workloadProcessing) ? true : false"
                        data-on:click="@post('/deck-options/sim/clear-workload')"
                        id="clearWorkloadBtn"
                    >
                        {{ tr.deck_config_clear_last_simulate() }}
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline btn-success"
                        data-attr:disabled="$workloadProcessing ? true : false"
                        data-on:click="$simMode = 'workload'; @post('/deck-options/sim/save-sim-to-preset')"
                        id="saveWorkloadBtn"
                    >
                        {{ tr.deck_config_save_options_to_preset() }}
                    </button>

                    <span class="text-xs text-base-content/60 ms-2" data-show="$workloadProcessing">
                        {{ tr.actions_processing() }}
                    </span>
                    <span class="text-xs text-error ms-2" data-show="$workloadError" data-text="$workloadError"></span>
                </div>

                <!-- Radio Group for Workload Subgraphs -->
                <div class="sim-radio-group border-t border-base-300 pt-2 flex flex-wrap gap-4">
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="workloadSubgraph"
                            value="ratio"
                            data-bind="workloadSubgraph"
                            data-on:change="$simMode = 'workload'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.deck_config_fsrs_simulator_radio_ratio() }}
                    </label>
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="workloadSubgraph"
                            value="count"
                            data-bind="workloadSubgraph"
                            data-on:change="$simMode = 'workload'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.deck_config_fsrs_simulator_radio_count() }}
                    </label>
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="workloadSubgraph"
                            value="time"
                            data-bind="workloadSubgraph"
                            data-on:change="$simMode = 'workload'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.statistics_reviews_time_checkbox() }}
                    </label>
                    <label class="cursor-pointer inline-flex items-center gap-1 text-sm">
                        <input
                            type="radio"
                            class="radio radio-sm"
                            name="workloadSubgraph"
                            value="memorized"
                            data-bind="workloadSubgraph"
                            data-on:change="$simMode = 'workload'; @post('/deck-options/sim/switch-subgraph')"
                        />
                        {{ tr.deck_config_fsrs_simulator_radio_memorized() }}
                    </label>
                </div>

                <!-- SVG Chart Container -->
                <div id="workloadChartContainer" class="sim-svg-container mt-2">
                    <div class="text-base-content/60 text-xs">No workload data. Click "Simulate" to run.</div>
                </div>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>
</div>
