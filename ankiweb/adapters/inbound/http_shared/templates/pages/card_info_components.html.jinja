{% macro card_info_block(card_data, title="", show_revlog=true, show_curve=true) %}
<div class="card-info-single">
    {% if title %}
    <h3>{{ title }}</h3>
    {% endif %}

    {% if not card_data or not card_data.rows %}
    <div class="card-info-placeholder">{{ tr.card_stats_no_card() }}</div>
    {% else %}
    <div class="row">
        <table class="stats-table align-start">
            <tbody>
                {% for row in card_data.rows %}
                <tr>
                    <th class="align-start">{{ row.label }}</th>
                    <td>{{ row.value }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if show_revlog and card_data.revlogs %}
    <div class="row">
        <div class="revlog-table">
            <div class="column">
                <div class="column-head">{{ tr.card_stats_review_log_date() }}</div>
                <div class="column-content">
                    {% for r in card_data.revlogs %}
                    <div><b>{{ r.date }}</b> <span class="hidden-xs">@ {{ r.time }}</span></div>
                    {% endfor %}
                </div>
            </div>
            <div class="column hidden-xs">
                <div class="column-head">{{ tr.card_stats_review_log_type() }}</div>
                <div class="column-content">
                    {% for r in card_data.revlogs %}
                    <div class="{{ r.review_kind_class }}">{{ r.review_kind }}</div>
                    {% endfor %}
                </div>
            </div>
            <div class="column">
                <div class="column-head">{{ tr.card_stats_review_log_rating() }}</div>
                <div class="column-content">
                    {% for r in card_data.revlogs %}
                    <div class="{{ r.rating_class }}">{{ r.rating }}</div>
                    {% endfor %}
                </div>
            </div>
            <div class="column">
                <div class="column-head">{{ tr.card_stats_interval() }}</div>
                <div class="column-content right">
                    {% for r in card_data.revlogs %}
                    <div>{{ r.interval }}</div>
                    {% endfor %}
                </div>
            </div>
            <div class="column hidden-xs">
                <div class="column-head">{{ tr.card_stats_ease() }}</div>
                <div class="column-content">
                    {% for r in card_data.revlogs %}
                    <div>{{ r.ease }}</div>
                    {% endfor %}
                </div>
            </div>
            <div class="column">
                <div class="column-head">{{ tr.card_stats_review_log_time_taken() }}</div>
                <div class="column-content right">
                    {% for r in card_data.revlogs %}
                    <div>{{ r.taken_secs }}</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if show_curve and card_data.fsrs_enabled and card_data.curve_svg %}
    <div class="row">
        {{ forgetting_curve_block(card_data) }}
    </div>
    {% endif %}
    {% endif %}
</div>
{% endmacro %}

{% macro forgetting_curve_block(card_data) %}
<div class="forgetting-curve" id="curve-{{ card_data.card_id }}">
    <div class="position-relative">
        <h1 class="svelte-zuiu8u">{{ tr.card_stats_fsrs_forgetting_curve_title() }}</h1>
        <div class="help-badge position-absolute svelte-zuiu8u"></div>
    </div>
    {% if card_data.show_time_selector %}
    <div class="time-range-selector">
        <label>
            <input type="radio" name="time-range-{{ card_data.card_id }}" value="0"
                   {% if card_data.selected_range == 0 %}checked{% endif %}
                   data-on:change="@post('/card-info/curve/{{ card_data.card_id }}?range=0')" />
            {{ tr.card_stats_fsrs_forgetting_curve_first_week() }}
        </label>
        <label>
            <input type="radio" name="time-range-{{ card_data.card_id }}" value="1"
                   {% if card_data.selected_range == 1 %}checked{% endif %}
                   data-on:change="@post('/card-info/curve/{{ card_data.card_id }}?range=1')" />
            {{ tr.card_stats_fsrs_forgetting_curve_first_month() }}
        </label>
        {% if card_data.max_span > 30 %}
        <label>
            <input type="radio" name="time-range-{{ card_data.card_id }}" value="2"
                   {% if card_data.selected_range == 2 %}checked{% endif %}
                   data-on:change="@post('/card-info/curve/{{ card_data.card_id }}?range=2')" />
            {{ tr.card_stats_fsrs_forgetting_curve_first_year() }}
        </label>
        {% endif %}
        {% if card_data.max_span > 365 %}
        <label>
            <input type="radio" name="time-range-{{ card_data.card_id }}" value="3"
                   {% if card_data.selected_range == 3 %}checked{% endif %}
                   data-on:change="@post('/card-info/curve/{{ card_data.card_id }}?range=3')" />
            {{ tr.card_stats_fsrs_forgetting_curve_all_time() }}
        </label>
        {% endif %}
    </div>
    {% endif %}
    {{ card_data.curve_svg | safe }}
</div>
{% endmacro %}

{% if comp_block %}
{{ forgetting_curve_block(card_data) }}
{% endif %}
