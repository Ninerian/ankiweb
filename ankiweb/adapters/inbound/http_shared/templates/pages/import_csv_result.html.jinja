{# Overview and Details of completed import #}
<div id="import-csv-content" class="route-import-csv">
  <!-- Sticky Top Bar with Done/Back button -->
  <div class="sticky-top sticky-top-bar d-flex justify-content-between align-items-center mb-3">
    <div class="filename fs-6">
      {{ filename }}
    </div>
    <div>
      <a href="/deckbrowser" class="btn btn-secondary btn-sm">
        {{ tr.actions_close() }}
      </a>
    </div>
  </div>

  <div class="container-fluid px-1">
    <!-- Overview Card -->
    <div class="card mb-3 shadow-sm">
      <div class="card-header bg-body-tertiary py-2">
        <h5 class="card-title mb-0 fs-6">{{ tr.importing_overview() }}</h5>
      </div>
      <div class="card-body p-3">
        <p class="mb-2 fw-medium">{{ result.found_notes_text }}</p>
        <ul class="list-unstyled mb-0 ps-2">
          {% if result.added_count > 0 %}
            <li class="mb-1 text-success d-flex align-items-center">
              <span class="badge bg-success me-2">+</span>
              <span>{{ result.added_text }}</span>
            </li>
          {% endif %}
          {% if result.updated_count > 0 %}
            <li class="mb-1 text-primary d-flex align-items-center">
              <span class="badge bg-primary me-2">~</span>
              <span>{{ result.updated_text }}</span>
            </li>
          {% endif %}
          {% if result.skipped_count > 0 %}
            <li class="mb-1 text-secondary d-flex align-items-center">
              <span class="badge bg-secondary me-2">=</span>
              <span>{{ result.skipped_text }}</span>
            </li>
          {% endif %}
          {% if result.failed_count > 0 %}
            <li class="mb-1 text-danger d-flex align-items-center">
              <span class="badge bg-danger me-2">!</span>
              <span>{{ result.failed_text }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    <!-- Details Card -->
    {% if result.details %}
    <div class="card mb-3 shadow-sm">
      <div class="card-header bg-body-tertiary py-2">
        <h5 class="card-title mb-0 fs-6">{{ tr.importing_details() }}</h5>
      </div>
      <div class="card-body p-3">
        <div class="table-responsive">
          <table class="table table-sm details-table mb-0">
            <thead class="table-light">
              <tr>
                <th class="index-cell">#</th>
                <th class="status-cell">{{ tr.importing_status() }}</th>
                <th class="contents-cell">{{ tr.editing_fields() }}</th>
                <th style="width: 4em; text-align: center;"></th>
              </tr>
            </thead>
            <tbody>
              {% for item in result.details %}
                <tr>
                  <td class="index-cell text-muted">{{ loop.index }}</td>
                  <td class="status-cell">
                    <span class="badge {% if item.status == tr.adding_added() %}bg-success{% elif item.status == tr.importing_updated() %}bg-primary{% else %}bg-secondary{% endif %}" title="{{ item.reason }}">
                      {{ item.status }}
                    </span>
                  </td>
                  <td class="contents-cell">{{ item.fields }}</td>
                  <td style="text-align: center;">
                    {% if item.can_browse and item.nid %}
                      <a href="/browse?q=nid:{{ item.nid }}" class="btn btn-outline-secondary btn-sm py-0 px-1" title="{{ tr.importing_show() }}">
                        {{ tr.importing_show() }}
                      </a>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
