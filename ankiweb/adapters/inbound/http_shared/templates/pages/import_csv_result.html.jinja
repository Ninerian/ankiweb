{# Overview and Details of completed import #}
<div id="import-csv-content" class="route-import-csv">
  <!-- Sticky Top Bar with Done/Back button -->
  <div class="sticky top-0 sticky-top-bar flex justify-between items-center mb-3">
    <div class="filename text-base">
      {{ filename }}
    </div>
    <div>
      <a href="/deckbrowser" class="btn btn-sm">
        {{ tr.actions_close() }}
      </a>
    </div>
  </div>

  <div class="w-full px-1">
    <!-- Overview Card -->
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.importing_overview() }}</h5>
      </div>
      <div class="card-body p-3">
        <p class="mb-2 font-medium">{{ result.found_notes_text }}</p>
        <ul class="list-none mb-0 ps-2">
          {% if result.added_count > 0 %}
            <li class="mb-1 text-success flex items-center">
              <span class="badge badge-success me-2">+</span>
              <span>{{ result.added_text }}</span>
            </li>
          {% endif %}
          {% if result.updated_count > 0 %}
            <li class="mb-1 text-primary flex items-center">
              <span class="badge badge-primary me-2">~</span>
              <span>{{ result.updated_text }}</span>
            </li>
          {% endif %}
          {% if result.skipped_count > 0 %}
            <li class="mb-1 text-base-content/60 flex items-center">
              <span class="badge badge-neutral me-2">=</span>
              <span>{{ result.skipped_text }}</span>
            </li>
          {% endif %}
          {% if result.failed_count > 0 %}
            <li class="mb-1 text-error flex items-center">
              <span class="badge badge-error me-2">!</span>
              <span>{{ result.failed_text }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    <!-- Details Card -->
    {% if result.details %}
    <div class="card bg-base-100 border border-base-300 rounded-box mb-3 shadow-xs">
      <div class="bg-base-200 px-4 py-2 border-b border-base-300 rounded-t-box">
        <h5 class="card-title text-sm font-semibold mb-0">{{ tr.importing_details() }}</h5>
      </div>
      <div class="card-body p-3">
        <div class="overflow-x-auto">
          <table class="table table-sm details-table mb-0">
            <thead class="bg-base-200">
              <tr>
                <th class="index-cell">#</th>
                <th class="status-cell">{{ tr.importing_status() }}</th>
                <th class="contents-cell">{{ tr.editing_fields() }}</th>
                <th style="width: 4em; text-align: center;"></th>
              </tr>
            </thead>
            <tbody>
              {% for item in result.details %}
                <tr>
                  <td class="index-cell text-base-content/60">{{ loop.index }}</td>
                  <td class="status-cell">
                    <span class="badge {% if item.status == tr.adding_added() %}badge-success{% elif item.status == tr.importing_updated() %}badge-primary{% else %}badge-neutral{% endif %}" title="{{ item.reason }}">
                      {{ item.status }}
                    </span>
                  </td>
                  <td class="contents-cell">{{ item.fields }}</td>
                  <td style="text-align: center;">
                    {% if item.can_browse and item.nid %}
                      <a href="/browse?q=nid:{{ item.nid }}" class="btn btn-outline btn-sm py-0 px-1" title="{{ tr.importing_show() }}">
                        {{ tr.importing_show() }}
                      </a>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
