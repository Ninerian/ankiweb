{% from "components/help_modal.html.jinja" import help_modal %}
{# Full content fragment for all graph cards #}
<div id="graphs-cards-container">
  {# 1. Today #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header">
      <h1 class="graph-title">{{ today.title }}</h1>
    </div>
    <div class="graph-body">
      <div class="legend">
        {% if today.has_data %}
          <div>{{ today.studied_str }}</div>
          <div>{{ today.again_str }}</div>
          <div>{{ today.breakdown_str }}</div>
          {% if today.mature_str %}
            <div>{{ today.mature_str }}</div>
          {% endif %}
        {% else %}
          <div>{{ today.no_cards_str }}</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# 2. Future Due #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ future_due.title }}</h1>
        <div class="graph-subtitle">{{ future_due.subtitle }}</div>
      </div>
      <div class="flex items-center gap-3">
        {% if future_due.have_backlog %}
          <label class="inline-flex items-center gap-1 text-sm cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-sm" data-bind="show_backlog" data-on:change="@post('/graphs/update')" {% if future_due.show_backlog %}checked{% endif %}>
            <span>{{ tr.statistics_backlog_checkbox() }}</span>
          </label>
        {% endif %}
        <div class="join" role="group">
          <input type="radio" class="btn btn-sm btn-outline join-item" name="fd-range" id="fd-30" value="30" aria-label="1 month" data-bind="future_due_range" data-on:change="@post('/graphs/update')" {% if future_due.range_days == 30 %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="fd-range" id="fd-90" value="90" aria-label="3 months" data-bind="future_due_range" data-on:change="@post('/graphs/update')" {% if future_due.range_days == 90 %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="fd-range" id="fd-365" value="365" aria-label="1 year" data-bind="future_due_range" data-on:change="@post('/graphs/update')" {% if future_due.range_days == 365 %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="fd-range" id="fd-all" value="0" aria-label="all" data-bind="future_due_range" data-on:change="@post('/graphs/update')" {% if future_due.range_days == 0 %}checked{% endif %}>
        </div>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ future_due.svg | safe }}
    </div>
    <div class="graph-summary-table overflow-x-auto">
      <table class="table table-xs table-zebra">
        <tbody>
          {% for row in future_due.summary %}
            <tr>
              <td class="text-right font-semibold">{{ row.label }}:</td>
              <td class="text-left">{{ row.value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# 3. Calendar #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex justify-between items-center">
      <div>
        <h1 class="graph-title">{{ calendar.title }}</h1>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline" data-on:click="$calendar_year = $calendar_year - 1; @post('/graphs/update')">◄</button>
        <span class="font-bold">{{ calendar.year }}</span>
        <button type="button" class="btn btn-sm btn-outline" data-on:click="$calendar_year = $calendar_year + 1; @post('/graphs/update')">►</button>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ calendar.svg | safe }}
    </div>
  </div>

  {# 4. Reviews #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ reviews.title }}</h1>
        <div class="graph-subtitle">{{ reviews.subtitle }}</div>
      </div>
      <div class="flex items-center gap-3">
        <label class="inline-flex items-center gap-1 text-sm cursor-pointer">
          <input type="checkbox" class="checkbox checkbox-sm" data-bind="reviews_show_time" data-on:change="@post('/graphs/update')" {% if reviews.show_time %}checked{% endif %}>
          <span>{{ tr.statistics_reviews_time_checkbox() }}</span>
        </label>
        <div class="join" role="group">
          <input type="radio" class="btn btn-sm btn-outline join-item" name="rev-range" id="rev-30" value="30" aria-label="1 month" data-bind="reviews_range" data-on:change="@post('/graphs/update')" {% if reviews.days_range == 30 %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="rev-range" id="rev-90" value="90" aria-label="3 months" data-bind="reviews_range" data-on:change="@post('/graphs/update')" {% if reviews.days_range == 90 %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="rev-range" id="rev-365" value="365" aria-label="1 year" data-bind="reviews_range" data-on:change="@post('/graphs/update')" {% if reviews.days_range == 365 %}checked{% endif %}>
        </div>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ reviews.svg | safe }}
    </div>
    <div class="graph-summary-table overflow-x-auto">
      <table class="table table-xs table-zebra">
        <tbody>
          {% for row in reviews.summary %}
            <tr>
              <td class="text-right font-semibold">{{ row.label }}:</td>
              <td class="text-left">{{ row.value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# 5. Card Counts #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header">
      <div>
        <h1 class="graph-title">{{ card_counts.title }}</h1>
      </div>
    </div>
    <div class="mb-2">
      <label class="inline-flex items-center gap-2 cursor-pointer">
        <input type="checkbox" class="checkbox checkbox-sm" data-bind="separate_inactive" data-on:change="@post('/graphs/update')" {% if card_counts.separate_inactive %}checked{% endif %}>
        <span>{{ tr.statistics_counts_separate_suspended_buried_cards() }}</span>
      </label>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
      <div class="md:col-span-5 flex justify-center">
        <div class="graph-svg-wrap">
          {{ card_counts.svg | safe }}
        </div>
      </div>
      <div class="md:col-span-7">
        <table class="table table-sm m-0">
          <tbody>
            {% for row in card_counts.rows %}
              <tr>
                <td>
                  {% if row.color %}
                    <span style="color: {{ row.color }};">■&nbsp;</span>
                  {% endif %}
                  {% if row.query %}
                    <a href="/browse?q={{ row.query | urlencode }}" class="btn btn-link btn-sm p-0 align-baseline">
                      {{ row.name }}
                    </a>
                  {% else %}
                    <span class="font-semibold">{{ row.name }}</span>
                  {% endif %}
                </td>
                <td class="text-right">{{ row.count }}</td>
                <td class="text-right text-base-content/60">{{ row.percent }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {# 6. Review Intervals #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ intervals.title }}</h1>
        <div class="graph-subtitle">{{ intervals.subtitle }}</div>
      </div>
      <div class="join" role="group">
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ivl-range" id="ivl-month" value="month" aria-label="1 month" data-bind="intervals_range" data-on:change="@post('/graphs/update')" {% if intervals.range_choice == "month" %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ivl-range" id="ivl-50" value="50" aria-label="50%" data-bind="intervals_range" data-on:change="@post('/graphs/update')" {% if intervals.range_choice == "50" %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ivl-range" id="ivl-95" value="95" aria-label="95%" data-bind="intervals_range" data-on:change="@post('/graphs/update')" {% if intervals.range_choice == "95" %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ivl-range" id="ivl-all" value="all" aria-label="all" data-bind="intervals_range" data-on:change="@post('/graphs/update')" {% if intervals.range_choice == "all" %}checked{% endif %}>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ intervals.svg | safe }}
    </div>
    {% if intervals.summary %}
      <div class="graph-summary-table overflow-x-auto">
        <table class="table table-xs table-zebra">
          <tbody>
            {% for row in intervals.summary %}
              <tr>
                <td class="text-right font-semibold">{{ row.label }}:</td>
                <td class="text-left">{{ row.value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {# 7. Card Ease / Difficulty #}
  {% if fsrs_enabled and difficulty %}
    <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
      <div class="graph-header">
        <div>
          <h1 class="graph-title">{{ difficulty.title }}</h1>
          <div class="graph-subtitle">{{ difficulty.subtitle }}</div>
        </div>
      </div>
      <div class="graph-svg-wrap">
        {{ difficulty.svg | safe }}
      </div>
      {% if difficulty.summary %}
        <div class="graph-summary-table">
          <table>
            <tbody>
              {% for row in difficulty.summary %}
                <tr>
                  <td class="text-right font-semibold">{{ row.label }}:</td>
                  <td class="text-left">{{ row.value }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
      <div class="graph-header">
        <div>
          <h1 class="graph-title">{{ ease.title }}</h1>
          <div class="graph-subtitle">{{ ease.subtitle }}</div>
        </div>
      </div>
      <div class="graph-svg-wrap">
        {{ ease.svg | safe }}
      </div>
      {% if ease.summary %}
        <div class="graph-summary-table">
          <table>
            <tbody>
              {% for row in ease.summary %}
                <tr>
                  <td class="text-right font-semibold">{{ row.label }}:</td>
                  <td class="text-left">{{ row.value }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# 8. True Retention #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="graph-title m-0">{{ retention.title }}</h1>
          <span class="help-badge">
            {{ help_modal(
                title=retention.title,
                url="https://docs.ankiweb.net/deck-options.html#fsrs",
                link_label=tr.deck_config_desired_retention(),
                id="retentionHelpModal",
                help_sections=[
                    {
                        "title": retention.title,
                        "help": "<p>" ~ tr.statistics_true_retention_tooltip() ~ "</p>",
                        "url": "https://docs.ankiweb.net/deck-options.html#fsrs"
                    }
                ]
            ) }}
          </span>
        </div>
        <div class="graph-subtitle">{{ retention.subtitle }}</div>
      </div>
      <div class="join" role="group">
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ret-mode" id="ret-summary" value="summary" aria-label="Summary" data-bind="retention_mode" data-on:change="@post('/graphs/update')" {% if retention.filter_mode == "summary" %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ret-mode" id="ret-young" value="young" aria-label="{{ tr.statistics_true_retention_young() }}" data-bind="retention_mode" data-on:change="@post('/graphs/update')" {% if retention.filter_mode == "young" %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="ret-mode" id="ret-mature" value="mature" aria-label="{{ tr.statistics_true_retention_mature() }}" data-bind="retention_mode" data-on:change="@post('/graphs/update')" {% if retention.filter_mode == "mature" %}checked{% endif %}>
      </div>
    </div>
    <div class="overflow-x-auto">
      {% if retention.filter_mode == "young" %}
        <table class="table table-sm text-center">
          <thead>
            <tr>
              <th class="text-left"></th>
              <th>Pass</th>
              <th>Fail</th>
              <th>Total</th>
              <th>Retention</th>
            </tr>
          </thead>
          <tbody>
            {% for row in retention.rows %}
              <tr>
                <td class="text-left font-semibold">{{ row.period }}</td>
                <td>{{ row.young_passed }}</td>
                <td>{{ row.young_failed }}</td>
                <td>{{ row.young_passed + row.young_failed }}</td>
                <td>{{ row.young }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% elif retention.filter_mode == "mature" %}
        <table class="table table-sm text-center">
          <thead>
            <tr>
              <th class="text-left"></th>
              <th>Pass</th>
              <th>Fail</th>
              <th>Total</th>
              <th>Retention</th>
            </tr>
          </thead>
          <tbody>
            {% for row in retention.rows %}
              <tr>
                <td class="text-left font-semibold">{{ row.period }}</td>
                <td>{{ row.mature_passed }}</td>
                <td>{{ row.mature_failed }}</td>
                <td>{{ row.mature_passed + row.mature_failed }}</td>
                <td>{{ row.mature }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <table class="table table-sm text-center">
          <thead>
            <tr>
              <th class="text-left"></th>
              <th>{{ tr.statistics_true_retention_young() }}</th>
              <th>{{ tr.statistics_true_retention_mature() }}</th>
              <th>{{ tr.statistics_true_retention_total() }}</th>
              <th>{{ tr.statistics_true_retention_count() }}</th>
            </tr>
          </thead>
          <tbody>
            {% for row in retention.rows %}
              <tr>
                <td class="text-left font-semibold">{{ row.period }}</td>
                <td>{{ row.young }}</td>
                <td>{{ row.mature }}</td>
                <td>{{ row.total }}</td>
                <td>{{ row.count }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>

  {# 9. Hourly Breakdown #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ hours.title }}</h1>
        <div class="graph-subtitle">{{ hours.subtitle }}</div>
      </div>
      <div class="join" role="group">
        <input type="radio" class="btn btn-sm btn-outline join-item" name="hr-range" id="hr-30" value="30" aria-label="1 month" data-bind="hours_range" data-on:change="@post('/graphs/update')" {% if hours.days_range == 30 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="hr-range" id="hr-90" value="90" aria-label="3 months" data-bind="hours_range" data-on:change="@post('/graphs/update')" {% if hours.days_range == 90 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="hr-range" id="hr-365" value="365" aria-label="1 year" data-bind="hours_range" data-on:change="@post('/graphs/update')" {% if hours.days_range == 365 %}checked{% endif %}>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ hours.svg | safe }}
    </div>
  </div>

  {# 10. Answer Buttons #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ buttons.title }}</h1>
        <div class="graph-subtitle">{{ buttons.subtitle }}</div>
      </div>
      <div class="join" role="group">
        <input type="radio" class="btn btn-sm btn-outline join-item" name="btn-range" id="btn-30" value="30" aria-label="1 month" data-bind="buttons_range" data-on:change="@post('/graphs/update')" {% if buttons.days_range == 30 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="btn-range" id="btn-90" value="90" aria-label="3 months" data-bind="buttons_range" data-on:change="@post('/graphs/update')" {% if buttons.days_range == 90 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="btn-range" id="btn-365" value="365" aria-label="1 year" data-bind="buttons_range" data-on:change="@post('/graphs/update')" {% if buttons.days_range == 365 %}checked{% endif %}>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ buttons.svg | safe }}
    </div>
  </div>

  {# 11. Added #}
  <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
    <div class="graph-header flex flex-wrap justify-between items-center">
      <div>
        <h1 class="graph-title">{{ added.title }}</h1>
        <div class="graph-subtitle">{{ added.subtitle }}</div>
      </div>
      <div class="join" role="group">
        <input type="radio" class="btn btn-sm btn-outline join-item" name="add-range" id="add-30" value="30" aria-label="1 month" data-bind="added_range" data-on:change="@post('/graphs/update')" {% if added.days_range == 30 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="add-range" id="add-90" value="90" aria-label="3 months" data-bind="added_range" data-on:change="@post('/graphs/update')" {% if added.days_range == 90 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="add-range" id="add-365" value="365" aria-label="1 year" data-bind="added_range" data-on:change="@post('/graphs/update')" {% if added.days_range == 365 %}checked{% endif %}>
        <input type="radio" class="btn btn-sm btn-outline join-item" name="add-range" id="add-all" value="0" aria-label="all" data-bind="added_range" data-on:change="@post('/graphs/update')" {% if added.days_range == 0 %}checked{% endif %}>
      </div>
    </div>
    <div class="graph-svg-wrap">
      {{ added.svg | safe }}
    </div>
    <div class="graph-summary-table overflow-x-auto">
      <table class="table table-xs table-zebra">
        <tbody>
          {% for row in added.summary %}
            <tr>
              <td class="text-right font-semibold">{{ row.label }}:</td>
              <td class="text-left">{{ row.value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# 12. Retrievability (FSRS) #}
  {% if fsrs_enabled and retrievability %}
    <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
      <div class="graph-header">
        <div>
          <h1 class="graph-title">{{ retrievability.title }}</h1>
          <div class="graph-subtitle">{{ retrievability.subtitle }}</div>
        </div>
      </div>
      <div class="graph-svg-wrap">
        {{ retrievability.svg | safe }}
      </div>
      {% if retrievability.summary %}
        <div class="graph-summary-table">
          <table>
            <tbody>
              {% for row in retrievability.summary %}
                <tr>
                  <td class="text-right font-semibold">{{ row.label }}:</td>
                  <td class="text-left">{{ row.value }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# 13. Stability (FSRS) #}
  {% if fsrs_enabled and stability %}
    <div class="graph-card card card-bordered bg-base-100 shadow-sm p-4 mb-6 border-base-300">
      <div class="graph-header flex flex-wrap justify-between items-center">
        <div>
          <h1 class="graph-title">{{ stability.title }}</h1>
          <div class="graph-subtitle">{{ stability.subtitle }}</div>
        </div>
        <div class="join" role="group">
          <input type="radio" class="btn btn-sm btn-outline join-item" name="stab-range" id="stab-month" value="month" aria-label="1 month" data-bind="stability_range" data-on:change="@post('/graphs/update')" {% if stability.range_choice == "month" %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="stab-range" id="stab-50" value="50" aria-label="50%" data-bind="stability_range" data-on:change="@post('/graphs/update')" {% if stability.range_choice == "50" %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="stab-range" id="stab-95" value="95" aria-label="95%" data-bind="stability_range" data-on:change="@post('/graphs/update')" {% if stability.range_choice == "95" %}checked{% endif %}>
          <input type="radio" class="btn btn-sm btn-outline join-item" name="stab-range" id="stab-all" value="all" aria-label="all" data-bind="stability_range" data-on:change="@post('/graphs/update')" {% if stability.range_choice == "all" %}checked{% endif %}>
        </div>
      </div>
      <div class="graph-svg-wrap">
        {{ stability.svg | safe }}
      </div>
      {% if stability.summary %}
        <div class="graph-summary-table">
          <table>
            <tbody>
              {% for row in stability.summary %}
                <tr>
                  <td class="text-right font-semibold">{{ row.label }}:</td>
                  <td class="text-left">{{ row.value }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
