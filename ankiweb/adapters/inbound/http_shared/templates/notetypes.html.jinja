<div class="notetypes container-fluid">
  <h3>{{ heading }}</h3>
  <table id="nttbl" class="table table-sm table-hover align-middle">
    <tbody id="ntrows">
      {% for r in rows %}
        <tr class="nt-row" data-id="{{ r.id }}" data-name="{{ r.name }}">
          <td class="nt-name">{{ r.name }}</td>
          <td class="nt-count">{{ r.count }} notes</td>
          <td><a href="/fields/{{ r.id }}">{{ L_fields }}</a></td>
          <td><a href="/card-layout/{{ r.id }}">{{ L_cards }}</a></td>
          <td>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; const cur = this.closest('.nt-row').getAttribute('data-name'); const name = prompt('New name:', cur); if (name) @post('/notetypes/rename/{{ r.id }}', {payload: {name: name}})">
              {{ L_rename }}
            </button>
          </td>
          <td>
            <button class="btn btn-sm btn-outline-danger" type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; if (confirm('Delete this note type and its {{ r.count }} note(s)?')) @post('/notetypes/delete/{{ r.id }}')">
              {{ L_delete }}
            </button>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <div id="ntadd" class="row g-2 align-items-center mt-3">
    <h4 class="mb-2">{{ L_add }}</h4>
    <div class="col-auto">
      <label for="ntnewname" class="visually-hidden">{{ L_name }}</label>
      <input type="text" id="ntnewname" class="form-control" placeholder="{{ L_name }}" size="24">
    </div>
    <div class="col-auto">
      <select id="ntbase" class="form-select">
        {% for r in rows %}<option value="{{ r.id }}">{{ r.name }}</option>{%
          endfor
        %}
      </select>
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; const name = document.getElementById('ntnewname').value; const base = document.getElementById('ntbase').value; if (name && base) @post('/notetypes/add/' + base, {payload: {name: name}})">{{ L_add }}</button>
    </div>
  </div>
  <div id="err" class="text-danger mt-2"></div>
</div>
