<style>
  #browser {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 57px);
  }
  @media (max-width: 767.98px) {
    #browser {
      height: calc(100dvh - var(--ankiweb-bottomnav-h, 3.5rem));
    }
  }

  #browser-top {
    position: relative;
    flex-shrink: 0;
  }

  #browser-main {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  #browser-main > .drawer-content {
    display: flex;
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  #browser-main > .drawer-side {
    position: absolute;
    inset: 0;
    display: grid;
    grid-area: 1 / 1;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
    width: 100%;
    height: 100%;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    z-index: 40;
  }

  #browser-sidebar-state:checked ~ .drawer-side {
    visibility: visible;
    pointer-events: auto;
  }

  #browser-main > .drawer-side > .drawer-overlay {
    position: static;
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    background: rgb(0 0 0 / 0.4);
  }

  #browser-main > .drawer-side > #sidebar-panel {
    grid-area: 1 / 1;
    width: min(20rem, calc(100vw - 3rem));
    min-width: 0;
    min-height: 0;
    height: 100%;
    box-sizing: border-box;
    overflow-y: auto;
    border-right: 1px solid var(--color-base-300);
    translate: 0;
  }

  @media (min-width: 1024px) {
    #browser-main {
      grid-template-columns: auto minmax(0, 1fr);
    }

    #browser-main > .drawer-content {
      grid-column: 2;
    }

    #browser-main > .drawer-side {
      position: static;
      grid-column: 1;
      display: none;
      width: min(20rem, calc(100vw - 3rem));
    }

    #browser-sidebar-state:checked ~ .drawer-side {
      display: grid;
    }

    #browser-main > .drawer-side > .drawer-overlay {
      display: none;
    }
  }


  #search {
    max-width: 320px;
    padding: 4px;
  }


  #sidebar > li,
  #sidebar details,
  #sidebar details > ul > li {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  #sidebar details > ul {
    min-width: 0;
  }

  #sidebar details:not([open]) > ul {
    display: none;
  }
  #sidebar summary {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.5rem;
  }

  #sidebar summary::after {
    order: -1;
    flex-shrink: 0;
    margin-inline-start: 0;
  }

  #sidebar summary > .side-item {
    flex: 1;
    padding: 0;
  }


  #sidebar .side-item {
    width: 100%;
    min-width: 0;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #results-wrap {
    flex: 1 1 0%;
    min-width: 0;
    overflow-y: auto;
    overflow-x: auto;
    height: 100%;
  }
  @media (max-width: 767.98px) {
    #results-wrap {
      padding-bottom: var(--ankiweb-bottomnav-h, 3.5rem);
    }
  }

  #results {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }

  .browser-row {
    cursor: pointer;
  }
  .browser-checkbox-target {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
  }
  @media (max-width: 767.98px) {
    .browser-row {
      min-height: 56px;
    }
    .browser-row td.cell-mobile {
      min-height: 56px;
    }
    #results .cell-select {
      width: 44px;
      min-width: 44px;
      max-width: 44px;
      padding: 0;
    }
    .browser-checkbox-target {
      width: 44px;
      height: 44px;
    }
  }

  .browser-row:hover {
    background-color: var(--color-base-200);
  }

  .browser-row.suspended-card {
    opacity: 0.65;
  }

  #results tr.selected {
    background-color: color-mix(in oklab, var(--color-primary) 12%, transparent) !important;
    border-left: 3px solid var(--color-primary);
  }

  #results tr.selected > td {
    background-color: transparent !important;
  }

  /* Desktop column widths */
  .cell-select {
    width: 38px;
    min-width: 38px;
    max-width: 38px;
    text-align: center;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  .cell-sortfield {
    width: 35%;
    max-width: 0;
  }
  .cell-card {
    width: 20%;
    max-width: 0;
  }
  .cell-deck {
    width: 25%;
    max-width: 0;
  }
  .cell-due {
    width: 20%;
  }
  @media (min-width: 1200px) {
    .cell-sortfield { width: 30%; }
    .cell-card { width: 15%; }
    .cell-deck { width: 20%; }
    .cell-due { width: 15%; }
    .cell-tags { width: 20%; max-width: 0; }
  }
  /* Scoped action dropdown styling: right-aligned dropdown panels with viewport safety */
  #browser-selection-status-row {
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    min-width: 0;
    min-height: 1.5rem;
  }
  @media (max-width: 767.98px) {
    #browser-selection-status-row {
      display: none;
    }
  }
  #browser-selected-status {
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    min-height: 1.5rem;
    height: auto;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  #browser-actions {
    position: relative;
  }
  #browser-actions details.dropdown {
    position: static;
  }
  #browser-actions .browser-action-panel {
    right: 0;
    left: auto;
    max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
  }
  #browser-actions details.dropdown summary svg {
    transition: transform 0.2s ease;
  }
  #browser-actions details.dropdown[open] summary svg {
    transform: rotate(180deg);
  }
  @media (min-width: 640px) {
    #browser-actions details.dropdown {
      position: relative;
    }
  }
  /* Desktop detail pane (mobile uses the bottom modal) */
  #detail-desktop {
    width: 46%;
    height: 100%;
    flex-shrink: 0;
    border-left: 1px solid var(--color-base-300);
    overflow: hidden;
  }

  #detail {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6px;
  }

  #detail .fldname {
    font-weight: bold;
    color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
    font-size: 11px;
    margin-top: 6px;
  }

  .editor-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  #detail-mobile-slot #detail { height: auto; }
  #detail-mobile-slot .editor-frame { height: 70dvh; }
  /* Mobile editor modal: vertical scrolling only */
  #detail-offcanvas .modal-box,
  #detail-mobile-slot {
    overflow-x: hidden;
    overscroll-behavior-x: none;
    touch-action: pan-y;
  }
  .editor-frame { touch-action: pan-y; }
</style>
