<aside id="sidebar-panel" class="bg-base-100 border-base-300">
    <ul id="sidebar" class="menu w-full min-w-0 flex-nowrap gap-1 p-2">
      <li>
        {% include "browser_sidebar_decks.html.jinja" %}
      </li>
      <li>
        <details id="sidebar-tags-section" open>
          <summary>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" class="size-4"><path d="M7.5 7.5h.01"></path><path d="M3 6v5.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l5.592 -5.592a2.41 2.41 0 0 0 0 -3.408l-7.71 -7.71a2 2 0 0 0 -1.414 -.586h-5.172a3 3 0 0 0 -3 3z"></path></svg>
            <span>{{ tr.browsing_sidebar_tags() }}</span>
          </summary>
          <ul>
            {% for item in tags %}
              <li class="min-w-0">
                <a
                  class="side-item"
                  title="{{ item.name }}"
                  href="/browse?{{ {'q': item.query} | urlencode }}"
                >{{ item.name }}</a>
              </li>
            {% endfor %}
          </ul>
        </details>
      </li>
      <li>
        <details id="sidebar-card-types-section" open>
          <summary>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" class="size-4"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h5"></path></svg>
            <span>{{ tr.card_stats_card_template() }}</span>
          </summary>
          <ul>
            {% for item in card_types %}
              <li class="min-w-0">
                <a
                  class="side-item"
                  title="{{ item.name }}"
                  href="/browse?{{ {'q': item.query} | urlencode }}"
                >{{ item.name }}</a>
              </li>
            {% endfor %}
          </ul>
        </details>
      </li>
    </ul>
</aside>
