<div id="sheet" class="modal modal-bottom" role="dialog" aria-modal="true" aria-labelledby="sheet-title" aria-hidden="true" inert data-class:modal-open="$sheetOpen" data-attr:aria-hidden="$sheetOpen ? 'false' : 'true'" data-attr:inert="!$sheetOpen">
  {% if view and not completed %}
  <div class="modal-box max-h-review-sheet-max-height w-full max-w-xl overflow-y-auto rounded-t-box border-2 border-neo-edge bg-base-200 p-5 pb-review-sheet-safe-bottom shadow-neo">
    <div class="mx-auto mb-4 h-1.5 w-12 rounded-full bg-base-300" aria-hidden="true"></div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2 id="sheet-title" class="text-xl font-black">{{ s('app_review_card_actions') }}</h2>
      <button id="sheet-close" type="button" class="review-sheet-close" aria-label="{{ tr.actions_close() | tr_clean }}" data-on:click="$sheetOpen = false; $dueOpen = false"><span aria-hidden="true">✕</span></button>
    </div>
    <div class="review-actions-grid">
      <button id="action-mark" type="button" class="review-action-tile" data-on:click="@post('/app/review/action/mark')"><svg aria-hidden="true" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span>{% if view.marked %}{{ s('app_review_unmark_card') }}{% else %}{{ tr.studying_mark_note() | tr_clean }}{% endif %}</span></button>
      <button id="action-flag" type="button" class="review-action-tile" data-on:click="$flag = {{ 0 if view.flag else 1 }}; @post('/app/review/action/flag')"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg><span>{% if view.flag %}{{ s('app_review_remove_flag') }}{% else %}{{ tr.studying_flag_card() | tr_clean }}{% endif %}</span></button>
      <button id="action-bury" type="button" class="review-action-tile" data-on:click="@post('/app/review/action/bury')"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12h20"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"/></svg><span>{{ tr.studying_bury_card() | tr_clean }}</span></button>
      <button id="action-suspend" type="button" class="review-action-tile" data-on:click="@post('/app/review/action/suspend')"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg><span>{{ tr.actions_suspend_card() | tr_clean }}</span></button>
      <button id="action-undo" type="button" class="review-action-tile" data-on:click="@post('/app/review/action/undo')"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg><span>{{ tr.undo_undo() | tr_clean }}</span></button>
      <button id="action-due" type="button" class="review-action-tile" aria-expanded="false" data-attr:aria-expanded="$dueOpen ? 'true' : 'false'" aria-controls="due-form" data-on:click="$dueOpen = !$dueOpen"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>{{ tr.actions_set_due_date() | tr_clean }}</span></button>
      <a id="action-info" class="review-action-tile" href="/app/review/info/{{ view.card_id }}"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg><span>{{ tr.actions_card_info() | tr_clean }}</span></a>
      <button id="action-delete" type="button" class="review-action-tile review-action-tile--danger" data-on:click="@post('/app/review/action/delete')"><svg aria-hidden="true" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg><span>{{ tr.studying_delete_note() | tr_clean }}</span></button>
    </div>
    <form id="due-form" class="mt-3 flex flex-wrap items-end gap-2" data-show="$dueOpen" style="display:none" data-on:submit__prevent="@post('/app/review/due')">
      <label class="min-w-0 flex-1 text-sm font-bold" for="due-spec">{{ tr.actions_set_due_date() | tr_clean }}
        <input id="due-spec" class="input mt-1 w-full shadow-neo focus:shadow-neo" type="text" autocomplete="off" placeholder="1-7" data-bind:spec>
      </label>
      <button id="due-submit" type="submit" class="btn btn-accent shadow-neo active:shadow-none">{{ tr.actions_save() | tr_clean }}</button>
    </form>
    <button id="sheet-dismiss" type="button" class="review-sheet-dismiss" data-on:click="$sheetOpen = false; $dueOpen = false">{{ tr.actions_close() | tr_clean }}</button>
  </div>
  <div id="sheet-backdrop" class="modal-backdrop" data-on:click="$sheetOpen = false; $dueOpen = false"></div>
  {% endif %}
</div>
