<article id="deck-{{ view.row.deck_id }}" class="card deck-card bg-base-200" data-show="{{ view.show }}">
  <div class="card-body gap-0 p-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="grid size-12 flex-none place-items-center rounded-[10px] border-2 border-base-content bg-secondary text-2xl leading-none" aria-hidden="true">{{ view.row.emoji }}</span>
      <h3 class="min-w-0 text-[1.18rem] leading-[1.15] font-black tracking-[-0.03em] [overflow-wrap:anywhere]">{{ view.row.name }}</h3>
    </div>
    <div class="my-3 flex flex-wrap gap-1.5">
      <span class="badge badge-warning lowercase h-auto border-[1.5px] border-current px-[9px] py-[3px] text-[0.73rem] leading-[1.3] font-extrabold">{{ view.row.due }} {{ tr.statistics_due_count() }}</span>
      <span class="badge badge-info lowercase h-auto border-[1.5px] border-current px-[9px] py-[3px] text-[0.73rem] leading-[1.3] font-extrabold">{{ view.row.new }} {{ tr.actions_new() }}</span>
    </div>
    <div class="mb-[5px] flex justify-between gap-2 text-[0.72rem] font-black uppercase tracking-[0.08em] text-[color:var(--color-muted)]">
      <span>{{ s("app_decks_progress") }}</span>
      <span>{{ view.row.progress_pct }}%</span>
    </div>
    <div class="h-3 overflow-hidden rounded-full border-2 border-base-content bg-[var(--color-meter-track)]" role="progressbar" aria-label="{{ s('app_decks_progress_for', deck=view.row.name) }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ view.row.progress_pct }}">
      <div class="meter-fill" style="width: {{ view.row.progress_pct }}%"></div>
    </div>
    <div class="mt-[15px] grid grid-cols-2 gap-2.5 pr-[3px] pb-[3px]">
      <a class="btn [--depth:0] min-h-11 rounded-[10px] border-[color:var(--color-neo-border)] p-2 text-[0.9rem] font-black shadow-[3px_3px_0_var(--color-neo-shadow)] transition-[transform,box-shadow] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary motion-reduce:transition-none motion-reduce:active:transform-none btn-accent" href="/app/review?deck={{ view.row.deck_id }}" aria-label="{{ s('app_decks_learn_deck', deck=view.row.name) }}">{{ s("app_decks_learn") }}</a>
      <a class="btn [--depth:0] min-h-11 rounded-[10px] border-[color:var(--color-neo-border)] p-2 text-[0.9rem] font-black shadow-[3px_3px_0_var(--color-neo-shadow)] transition-[transform,box-shadow] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary motion-reduce:transition-none motion-reduce:active:transform-none bg-base-200 dark:bg-base-300" href="/app/add?deck={{ view.row.deck_id }}">{{ s("app_decks_edit_add") }}</a>
    </div>
  </div>
</article>
