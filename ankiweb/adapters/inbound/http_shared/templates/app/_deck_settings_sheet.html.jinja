{% import 'app/_deck_languages.html.jinja' as language_picker with context %}
{% set labels = language_picker.deck_language_labels %}
{% set group_labels = {'study': s('app_decks_emoji_group_study'), 'nature': s('app_decks_emoji_group_nature'), 'fun': s('app_decks_emoji_group_fun'), 'world': s('app_decks_emoji_group_world')} %}
{% if fragment == "body" %}
    {% set initial_mode = 'langs' if settings.languages else 'none' %}
    {% set initial_src = settings.languages.src if settings.languages else '' %}
    {% set initial_dst = settings.languages.dst if settings.languages else '' %}
    {% set selected = namespace(group='study') %}
    {% for language in LANGUAGES %}
        {% if settings.emoji == language.flag %}
            {% set selected.group = "world" %}
        {% endif %}
    {% endfor %}
    {% for group in emoji_groups %}
        {% if settings.emoji in group.emojis %}
            {% set selected.group = group.key %}
        {% endif %}
    {% endfor %}
    <div id="deck-settings-body"
         class="flex min-h-0 flex-1 flex-col"
         data-signals="{setId: {{ settings.deck_id }}, setName: {{ js_literal(settings.name) }}, setEmoji: {{ js_literal(settings.emoji) }}, setMode: {{ js_literal(initial_mode) }}, setSrc: {{ js_literal(initial_src) }}, setDst: {{ js_literal(initial_dst) }}, baseName: {{ js_literal(settings.name) }}, baseEmoji: {{ js_literal(settings.emoji) }}, baseMode: {{ js_literal(initial_mode) }}, baseSrc: {{ js_literal(initial_src) }}, baseDst: {{ js_literal(initial_dst) }}, setEmojiGroup: {{ js_literal(selected.group) }}, saving: false, setError: ''}"
         data-computed:_dirty="($setName !== $baseName ? 1 : 0) + ($setEmoji !== $baseEmoji ? 1 : 0) + ($setMode !== $baseMode || ($setMode === 'langs' && ($setSrc !== $baseSrc || $setDst !== $baseDst)) ? 1 : 0)">
        <header class="flex-none px-5 pt-5">
            <div class="mx-auto mb-4 h-1.5 w-12 rounded-full bg-base-300 sm:hidden"
                 aria-hidden="true"></div>
            <div class="mb-4 flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <h2 id="deck-settings-title" class="text-xl font-black">{{ labels.settings_title }}</h2>
                    <p class="text-sm font-bold text-base-content/70 wrap-anywhere">{{ settings.name }}</p>
                </div>
                <button id="deck-settings-close"
                        type="button"
                        class="review-sheet-close"
                        aria-label="{{ tr.actions_close() | tr_clean }}"
                        data-on:click="$setOpen = false"><span aria-hidden="true">✕</span></button>
            </div>
        </header>
        <form id="deck-settings-form"
              class="flex min-h-0 flex-1 flex-col"
              data-on:submit__prevent="$_dirty > 0 && !$saving && $setName.trim() && !$setError && ($setMode === 'none' || ($setMode === 'langs' && !!$setSrc && !!$setDst && $setSrc !== $setDst)) && @post('/app/decks/{{ settings.deck_id }}/settings')"
              data-indicator:saving>
            <div class="min-h-0 flex-1 overflow-y-auto px-5">
                <div id="deck-settings-dirty"
                     class="badge badge-info mb-3 h-auto rounded-full border-2 border-neo-edge px-3 py-1 font-review-sheet text-xs font-black"
                     role="status"
                     data-show="$_dirty > 0"
                     style="display:none">
                    <span class="size-2 rounded-full border border-neo-edge bg-info-content"
                          aria-hidden="true"></span><span data-text="$_dirty + ' ' + ($_dirty === 1 ? {{ js_literal(labels.changes_one) }} : {{ js_literal(labels.changes_many) }})"></span>
                </div>
                <div class="mb-4 flex items-center gap-3 rounded-box border-2 border-dashed border-neo-edge bg-base-100 p-3"
                     aria-hidden="true">
                    <span id="settings-preview-emoji"
                          class="grid size-15 flex-none place-items-center rounded-deck border-2 border-neo-edge bg-base-200 text-3xl shadow-neo"
                          data-text="$setEmoji">{{ settings.emoji }}</span>
                    <span class="min-w-0">
                        <span class="block text-lg font-black wrap-anywhere"
                              data-text="$setName.trim() || {{ js_literal(s('app_decks_name_placeholder')) }}">{{ settings.name }}</span>
                        <span id="settings-preview-languages"
                              class="badge mt-1 h-auto max-w-full rounded-full border-deck-pill border-neo-edge bg-base-100 px-2.25 py-0.75 font-review-sheet text-deck-pill leading-deck-pill font-black tracking-wide text-base-content"
                              data-show="$setMode === 'langs' && !!$setSrc && !!$setDst && $setSrc !== $setDst"
                              data-text="{{ js_literal(language_picker.deck_language_flags) }}[$setSrc] + ' ' + $setSrc.toUpperCase() + ' → ' + {{ js_literal(language_picker.deck_language_flags) }}[$setDst] + ' ' + $setDst.toUpperCase()"
                              style="display:none"></span>
                        <span class="badge mt-1 h-auto max-w-full rounded-full border-deck-pill border-dashed border-neo-edge bg-transparent px-2.25 py-0.75 font-review-sheet text-deck-pill leading-deck-pill font-extrabold text-muted-fg"
                              data-show="$setMode === 'langs' && (!$setSrc || !$setDst || $setSrc === $setDst)"
                              style="display:none">{{ labels.unset }}</span>
                        <span class="badge mt-1 h-auto max-w-full rounded-full border-deck-pill border-dashed border-neo-edge bg-transparent px-2.25 py-0.75 font-review-sheet text-deck-pill leading-deck-pill font-extrabold text-muted-fg"
                              data-show="$setMode === 'none'"
                              style="display:none">{{ labels.none_chip }}</span>
                    </span>
                </div>
                <fieldset class="fieldset mb-3">
                    <div class="flex items-baseline justify-between gap-2">
                        <label class="fieldset-legend" for="set-name">{{ s("app_decks_name") }} <span id="set-name-changed"
                                                                                                      class="badge badge-info badge-sm h-auto rounded-full border-deck-pill border-neo-edge px-1.5 py-0.5 font-review-sheet text-review-dist-heading leading-none font-black uppercase tracking-wide"
                                                                                                      data-show="$setName !== $baseName"
                                                                                                      style="display:none">{{ labels.changed_tag }}</span></label>
                        <span class="text-xs font-bold text-muted-fg"
                              data-class:text-error-content="$setName.length >= 40"
                              data-text="$setName.length + ' / 40'"></span>
                    </div>
                    <label class="input flex h-12.5 w-full items-center gap-2.5 border-neo-edge bg-base-200 px-3.5 shadow-neo focus-within:outline-3 focus-within:outline-offset-3 focus-within:outline-primary">
                        <input id="set-name"
                               class="grow text-base font-bold"
                               type="text"
                               maxlength="40"
                               autocomplete="off"
                               autocapitalize="words"
                               enterkeyhint="done"
                               value="{{ settings.name }}"
                               data-bind:set-name
                               data-on:input="$setError = ''">
                    </label>
                </fieldset>
                <p id="deck-settings-error"
                   class="mb-3 text-sm font-bold text-error-content"
                   role="alert"
                   data-show="$setError"
                   data-text="$setError"
                   style="display:none"></p>
                {{ language_picker.languages("set") }}
                <p id="set-emoji-label" class="mb-2 text-sm font-black">{{ s("app_decks_pick_emoji") }} <span id="set-emoji-changed"
                                                                                                              class="badge badge-info badge-sm h-auto rounded-full border-deck-pill border-neo-edge px-1.5 py-0.5 font-review-sheet text-review-dist-heading leading-none font-black uppercase tracking-wide"
                                                                                                              data-show="$setEmoji !== $baseEmoji"
                                                                                                              style="display:none">{{ labels.changed_tag }}</span></p>
                <div class="mb-3 flex flex-nowrap gap-2 overflow-x-auto pb-1"
                     role="tablist"
                     aria-label="{{ s('app_decks_pick_category') }}">
                    {% for group in emoji_groups %}
                        <button id="set-emoji-tab-{{ group.key }}"
                                type="button"
                                class="btn btn-sm flex-none rounded-full border-2 border-neo-edge bg-base-200 font-black uppercase shadow-none aria-selected:bg-accent aria-selected:text-accent-content aria-selected:shadow-neo"
                                role="tab"
                                aria-controls="set-emoji-group-{{ group.key }}"
                                aria-selected="{{ 'true' if group.key == selected.group else 'false' }}"
                                data-attr:aria-selected="$setEmojiGroup === {{ js_literal(group.key) }} ? 'true' : 'false'"
                                data-on:click="$setEmojiGroup = {{ js_literal(group.key) }}">{{ group_labels[group.key] }}</button>
                    {% endfor %}
                </div>
                <div data-on:change="$setError = ''">
                    {% for group in emoji_groups %}
                        <div id="set-emoji-group-{{ group.key }}"
                             class="mb-4 grid grid-cols-6 gap-2"
                             role="radiogroup"
                             aria-labelledby="set-emoji-label"
                             data-show="$setEmojiGroup === {{ js_literal(group.key) }}"
                             style="display:none">
                            {% for emoji in group.emojis %}
                                <label class="btn btn-square relative aspect-square h-auto min-h-0 w-full max-w-13.5 justify-self-center rounded-field border-2 border-neo-edge bg-base-100 p-0 text-2xl leading-none shadow-neo active:translate-x-0.5 active:translate-y-0.5 active:shadow-none has-checked:translate-x-0.5 has-checked:translate-y-0.5 has-checked:bg-accent has-checked:shadow-none">
                                    <input class="sr-only"
                                           type="radio"
                                           name="set-emoji-{{ group.key }}"
                                           value="{{ emoji }}"
                                           aria-label="{{ emoji }}"
                                           data-bind:set-emoji{% if emoji == settings.emoji %}
                                           checked{% endif %}>
                                    <span aria-hidden="true">{{ emoji }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <footer class="flex flex-none gap-2.5 border-t-2 border-neo-edge bg-base-200 px-5 pt-3 pb-review-sheet-safe-bottom">
                <button id="deck-settings-cancel"
                        type="button"
                        class="btn neo-press min-h-14 min-w-0 flex-5 rounded-deck bg-base-300 text-base font-black shadow-neo active:shadow-none"
                        data-on:click="$setOpen = false">{{ labels.cancel }}</button>
                <button id="deck-settings-save"
                        type="submit"
                        class="btn btn-accent neo-press min-h-14 min-w-0 flex-7 rounded-deck text-base font-black shadow-neo active:shadow-none"
                        data-attr:disabled="$_dirty === 0 || !$setName.trim() || $saving || !!$setError || !($setMode === 'none' || ($setMode === 'langs' && !!$setSrc && !!$setDst && $setSrc !== $setDst))"
                        disabled>{{ labels.save }}</button>
            </footer>
        </form>
    </div>
{% else %}
    <div id="deck-settings-sheet"
         class="modal modal-bottom sm:modal-middle"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deck-settings-title"
         aria-hidden="true"
         inert
         data-class:modal-open="$setOpen"
         data-attr:aria-hidden="$setOpen ? 'false' : 'true'"
         data-attr:inert="!$setOpen"
         data-effect="window.avDeckFocus($setOpen, 'deck-settings-sheet', 'set-name')"
         data-on:keydown__window="$setOpen && evt.key === 'Escape' && ($setOpen = false)"
         data-on:keydown="window.avDeckModalKey(evt)">
        <div class="modal-box mx-auto flex max-h-review-sheet-max-height w-full max-w-xl flex-col overflow-hidden rounded-t-box border-2 border-neo-edge bg-base-200 p-0 shadow-neo sm:rounded-box">
            <div id="deck-settings-body" class="flex min-h-0 flex-1 flex-col"></div>
        </div>
        <div id="deck-settings-backdrop"
             class="modal-backdrop"
             data-on:click="$setOpen = false"></div>
    </div>
{% endif %}
