<footer id="bar" class="w-full px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-2">
  {% if view and not completed %}
  <div id="bar-show-answer" data-show="!$revealed">
    <button id="btn-show-ans" type="button" class="btn btn-accent btn-block btn-lg neo-press font-black" data-on:click="$revealed = true">{{ tr.studying_show_answer() | tr_clean }}</button>
  </div>
  <div id="bar-ease-buttons" class="grid grid-cols-4 gap-2" data-show="$revealed" style="display:none">
    {% for number, name in [(1, tr.studying_again() | tr_clean), (2, tr.studying_hard() | tr_clean), (3, tr.studying_good() | tr_clean), (4, tr.studying_easy() | tr_clean)] %}
    <button id="ease-{{ number }}" type="button" {% if number == 1 %}class="btn btn-error neo-press review-ease review-ease-error flex h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2"{% elif number == 2 %}class="btn btn-warning neo-press review-ease review-ease-warning flex h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2"{% elif number == 3 %}class="btn btn-success neo-press review-ease review-ease-success flex h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2"{% else %}class="btn btn-info neo-press review-ease review-ease-info flex h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2"{% endif %} data-on:click="$ease = {{ number }}; @post('/app/review/answer')">
      <span class="max-w-full break-words text-center text-sm font-black">{{ name }}</span><span class="max-w-full break-words text-center font-mono text-xs">{{ view.labels[number - 1] }}</span>
    </button>
    {% endfor %}
  </div>
  {% endif %}
</footer>
