{% macro request_step(to, via) -%}
    window.avRequestStep('{{ ["front", "back", "preview"][to - 1] }}', '{{ via }}')
{%- endmacro %}
{% macro steps() %}
    <div id="edit-steps"
         class="browse-fade mt-2.5 flex items-center justify-between gap-2">
        {% for label in [tr.notetypes_front_field(), tr.notetypes_back_field(), tr.actions_preview()] %}
            <button type="button"
                    class="add-step{% if projection.step|int == loop.index %} add-step-active{% elif projection.step|int > loop.index %} add-step-done{% endif %}"
                    {% if projection.step|int == loop.index %}aria-current="step"{% endif %}
                    data-attr:disabled="$_busy"
                    data-on:click="{{ request_step(loop.index, 'chip') }}"><span class="add-step-num" aria-hidden="true">{{ loop.index }}</span><span>{{ label }}</span></button>
        {% endfor %}
    </div>
{% endmacro %}
{% macro marker() %}
    <div id="edit-step" data-step="{{ projection.step }}" hidden></div>
{% endmacro %}
{% macro error() %}<div id="edit-error"
                        class="toast"
                        role="alert"{% if not error_message|default('') %} hidden{% endif %}>{% if error_message|default("") %}<div class="alert alert-error">{{ error_message }}</div>{% endif %}</div>{% endmacro %}
{% macro preview_card() %}
    <div id="preview" class="add-preview">
        <div class="add-label-row mb-0">
            <h2 class="add-label">{{ s("app_add_card_preview") }}</h2>
            <span class="add-help">{{ s("app_edit_ready_to_save") if projection.draft.nid else s('app_add_ready_to_add') }}</span>
        </div>
        <div class="add-preview-section">
            <span class="add-preview-tag">{{ s("app_add_front_preview") }}</span>
            <p class="av-front-text whitespace-pre-wrap">{{ projection.draft.front }}</p>
        </div>
        {% if projection.draft.hint %}<div class="add-preview-section"><span class="add-preview-tag">{{ s("app_add_hint") }}</span><p class="av-hint whitespace-pre-wrap">{{ projection.draft.hint }}</p></div>{% endif %}
        <hr class="add-preview-divider">
        <div class="add-preview-section">
            <span class="add-preview-tag">{{ s("app_add_back_preview") }}</span>
            <p class="av-back-text whitespace-pre-wrap">{{ projection.draft.back }}</p>
        </div>
        {% if projection.draft.example %}<div class="add-preview-section"><span class="add-preview-tag">{{ s("app_add_example") }}</span><p class="av-example">{{ projection.example_html|safe }}</p></div>{% endif %}
        <button type="button"
                class="add-preview-edit"
                data-attr:disabled="$_busy"
                data-on:click="{{ request_step(1, 'chip') }}">{{ s("app_edit_preview_edit") if projection.draft.nid else s('app_add_edit_preview') }}</button>
    </div>
{% endmacro %}
{% macro actions() %}
    <footer id="edit-actions" class="browse-fade review-bar">
        <div class="flex gap-2.5">
            {% if projection.step|int > 1 %}
                <button type="button"
                        class="btn btn-square neo-press h-16 min-h-0 w-14.5 shrink-0 rounded-2xl border-3 border-neo-edge bg-base-200 p-0 shadow-neo active:shadow-none"
                        aria-label="{{ s('app_add_previous_step') }}"
                        data-attr:disabled="$_busy"
                        data-on:click="{{ request_step(projection.step|int - 1, 'next') }}">
                    <svg aria-hidden="true"
                         viewBox="0 0 24 24"
                         class="h-5.5 w-5.5"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.4"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
            {% endif %}
        {% if projection.step|int < 3 %}<button id="btn-next"
                                                type="button"
                                                class="btn btn-accent neo-press h-16 min-h-0 min-w-0 flex-1 whitespace-nowrap rounded-2xl border-3 border-neo-edge px-2 text-[clamp(1rem,calc(6vw_-_2px),1.35rem)] leading-tight font-black uppercase tracking-review-reveal-label shadow-neo active:shadow-none"
                                                data-attr:disabled="$_busy"
                                                data-on:click="{{ request_step(projection.step|int + 1, 'next') }}">{{ s("app_add_next_back") if projection.step|int == 1 else s('app_add_next_preview') }}</button>
    {% else %}<button id="btn-add"
                      type="button"
                      class="btn btn-success neo-press h-16 min-h-0 min-w-0 flex-1 whitespace-normal rounded-2xl border-3 border-neo-edge text-review-reveal-label leading-tight font-black uppercase tracking-review-reveal-label shadow-neo active:shadow-none"
                      data-save-failed="{{ s('app_add_save_failed') }}"
                      data-on:datastar-fetch="el === evt.detail.el &amp;&amp; evt.detail.type === 'error' ? window.avEditError(el.dataset.saveFailed) : null"
                      data-on:click="$_busy ? null : @post(window.avAction('/commit'), {contentType:'form', selector:'#edit-form'})"
                      data-indicator:_busy
                      data-attr:disabled="$_busy">{{ s("app_edit_save") if projection.draft.nid else tr.actions_add()|tr_clean }}</button>{% endif %}
</div>
</footer>
{% endmacro %}
{% macro chip(label, target, space=false, value=none) %}<button type="button"
                                                                class="add-chip"
                                                                data-target="{{ target }}"
                                                                data-value="{{ value if value is not none else label ~ (' ' if space else '') }}"
                                                                data-attr:disabled="$_busy"
                                                                data-on:click="window.avInsert(el)">{{ label }}</button>{% endmacro %}
{% macro field_label(for_id, label, help, language='') %}<div class="add-label-row"><label for="{{ for_id }}" class="add-label">{{ label }}{% if language %} · {{ language }}{% endif %}</label>{% if help %}<span id="{{ for_id }}-help" class="add-help">{{ help }}</span>{% endif %}</div>{% endmacro %}
{% macro form() %}
    {% import 'app/_deck_language_strings.html.jinja' as language_strings with context %}
    {% macro language_name(code) %}{% set flag = (LANGUAGES | selectattr('code', 'equalto', code) | first).flag %}{{ flag }} {{ language_strings.deck_language_names[code] }}{% endmacro %}
    <div id="edit-session"
         data-instance="{{ instance }}"
         data-rev="{{ revision }}"{% if reset_from is defined %} data-reset-from="{{ reset_from }}"{% endif %}
         data-nid="{{ projection.draft.nid }}"
         data-original="{{ projection.draft.fields|tojson|forceescape }}"
         data-attr:inert="$_busy">
        <span id="edit-step-request"
              hidden
              data-indicator:_busy
              data-on:datastar-fetch="el === evt.detail.el &amp;&amp; (evt.detail.type === 'error' || evt.detail.type === 'retries-failed') ? window.avStepRejected() : null"
              data-on:av-step="@post(window.avAction('/step/' + evt.detail.to + '/' + evt.detail.via), {contentType:'form', selector:'#edit-form', requestCancellation:window.avStepRequest()})"></span>
        {{ error() }}
        <header class="review-hud">
            <div class="navbar review-hud-nav min-h-0 p-0">
                <a id="edit-back"
                   href="/app/"
                   tabindex="0"
                   class="btn btn-square neo-press size-review-hud-control min-h-0 shrink-0 rounded-review-sheet-control border-2 border-neo-edge bg-base-200 p-0 shadow-neo active:shadow-none"
                   aria-label="{{ s('app_add_exit') }}"
                   data-exit="{{ s('app_add_exit') }}"
                   data-browse-back="{{ s('app_edit_back_to_editor') }}"
                   data-list-back="{{ s('app_edit_back_to_cards') }}"
                   data-discard="{{ s('app_add_discard_leave') }}"
                   data-on:keydown="window.avBackKey(evt, el)"
                   data-on:click="window.avEditBack(evt)">
                    <svg aria-hidden="true"
                         viewBox="0 0 24 24"
                         class="h-5 w-5"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.4"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </a>
                <a id="deck-chip"
                   href="/app/"
                   class="flex h-review-hud-control min-w-0 flex-1 items-center gap-2 px-2 text-left"
                   data-discard="{{ s('app_add_discard_leave') }}"
                   data-on:click="window.avGuardNav(evt, el.dataset.discard)"><span class="shrink-0">{{ deck_emoji }}</span> <span class="min-w-0 truncate text-xl font-black" dir="auto">{{ deck_name }}</span></a>
                <button id="edit-done"
                        type="button"
                        class="btn btn-accent neo-press h-review-hud-control min-h-0 shrink-0 rounded-review-sheet-control border-2 border-neo-edge px-3.5 text-sm font-black uppercase shadow-neo active:shadow-none"
                        data-attr:disabled="$_busy"
                        data-discard="{{ s('app_add_discard_finish') }}"
                        data-on:click="window.avCanFinish(el.dataset.discard) ? (window.avBumpRev(), window.avFinishEditor(), @post(window.avAction('/done'), {contentType:'form', selector:'#edit-form'})) : null">{{ s("app_add_done") }}</button>
            </div>
            {{ steps() }}
        </header>
        <div id="add-stage" class="review-stage">
            <div id="add-editor" class="add-card motion-reduce:animate-none">
                {% if projection.draft.nid and projection.draft.learned %}<div id="edit-warning"
                                                                               class="alert alert-warning mb-3 text-sm font-bold"
                                                                               role="note">{{ s("app_edit_warning") }}</div>{% endif %}
                {% if projection.progress_reset %}<div id="progress-reset-notice"
                                                       class="alert alert-success mb-3 text-sm font-bold"
                                                       role="status">{{ s("app_edit_progress_reset") }}</div>{% endif %}
                <form id="edit-form" novalidate data-on:submit__prevent="null">
                    <input type="hidden" name="nid" value="{{ projection.draft.nid }}">
                    {{ marker() }}
                    <section data-step-section="1">
                        {{ field_label('input-front', s('app_add_front_prompt'), s('app_add_front_help'), language_name(languages.dst) if languages else '') }}
                        <textarea id="input-front"
                                  name="front"
                                  class="add-input"
                                  rows="4"
                                  data-attr:readonly="$_busy"{% if languages %} lang="{{ languages.dst }}"{% endif %}
                                  aria-describedby="input-front-help{% if projection.draft.nid and projection.draft.learned %} edit-warning{% endif %}"
                                  placeholder="{{ s('app_add_front_placeholder_languages') if languages else s('app_add_front_placeholder') }}"
                                  required>{{ projection.draft.front }}</textarea>
                        <p class="add-counter"><span data-counter-for="front">{{ projection.counts.front }}</span> {{ s("app_add_characters") }}</p>
                        {% if not languages %}<div class="add-chips">{{ chip(s('app_add_chip_der'), 'input-front', true) }}{{ chip(s('app_add_chip_die'), 'input-front', true) }}{{ chip(s('app_add_chip_das'), 'input-front', true) }}{{ chip(s('app_add_chip_a_umlaut'), 'input-front') }}{{ chip(s('app_add_chip_o_umlaut'), 'input-front') }}{{ chip(s('app_add_chip_u_umlaut'), 'input-front') }}{{ chip(s('app_add_chip_sharp_s'), 'input-front') }}</div>{% elif target_chips %}<div id="add-chips-front" class="add-chips" lang="{{ languages.dst }}">{% for item in target_chips %}{{ chip(item.label, 'input-front', value=item.value) }}{% endfor %}</div>{% endif %}
                    </section>
                    <section data-step-section="2">
                        {{ field_label('input-back', s('app_add_back_prompt'), s('app_add_back_help'), language_name(languages.src) if languages else '') }}
                        <textarea id="input-back"
                                  name="back"
                                  class="add-input"
                                  rows="4"
                                  data-attr:readonly="$_busy"{% if languages %} lang="{{ languages.src }}"{% endif %}
                                  aria-describedby="input-back-help"
                                  placeholder="{{ s('app_add_back_placeholder_languages') if languages else s('app_add_back_placeholder') }}"
                                  required>{{ projection.draft.back }}</textarea>
                        <p class="add-counter"><span data-counter-for="back">{{ projection.counts.back }}</span> {{ s("app_add_characters") }}</p>
                        <details class="collapse collapse-arrow add-optional"{% if projection.draft.hint %} open{% endif %}><summary class="collapse-title font-extrabold">{{ s("app_add_hint") }} · {{ s("app_add_optional") }}</summary><div class="collapse-content">{{ field_label('input-hint', s('app_add_hint'), '') }}<textarea id="input-hint"
                                                                                                                                                                                                                                                                                                                                        name="hint"
                                                                                                                                                                                                                                                                                                                                        class="add-input add-input-sm"
                                                                                                                                                                                                                                                                                                                                        rows="2"
                                                                                                                                                                                                                                                                                                                                        data-attr:readonly="$_busy"
                                                                                                                                                                                                                                                                                                                                        placeholder="{{ s('app_add_hint_placeholder') }}">{{ projection.draft.hint }}</textarea><p class="add-counter"><span data-counter-for="hint">{{ projection.counts.hint }}</span> {{ s("app_add_characters") }}</p><div class="add-chips">{{ chip(s('app_add_chip_noun'), 'input-hint', true) }}{{ chip(s('app_add_chip_verb'), 'input-hint', true) }}{{ chip(s('app_add_chip_adjective'), 'input-hint', true) }}{{ chip(s('app_add_chip_plural'), 'input-hint', true) }}</div></div></details>
                        <details class="collapse collapse-arrow add-optional"{% if projection.draft.example %} open{% endif %}><summary class="collapse-title font-extrabold">{{ s("app_add_example") }} · {{ s("app_add_optional") }}</summary><div class="collapse-content">{{ field_label('input-example', s('app_add_example'), s('app_add_example_help')) }}<textarea id="input-example"
                                                                                                                                                                                                                                                                                                                                                                           name="example"
                                                                                                                                                                                                                                                                                                                                                                           class="add-input add-input-sm"
                                                                                                                                                                                                                                                                                                                                                                           rows="2"
                                                                                                                                                                                                                                                                                                                                                                           data-attr:readonly="$_busy"
                                                                                                                                                                                                                                                                                                                                                                           aria-describedby="input-example-help"
                                                                                                                                                                                                                                                                                                                                                                           placeholder="{{ s('app_add_example_placeholder_languages') if languages else s('app_add_example_placeholder') }}">{{ projection.draft.example }}</textarea><p class="add-counter"><span data-counter-for="example">{{ projection.counts.example }}</span> {{ s("app_add_characters") }}</p></div></details>
                    </section>
                    <section data-step-section="3">
                        {{ preview_card() }}
                    </section>
                </form>
            </div>
            {% include "app/_edit_deck_pile.html.jinja" %}
        </div>
        {% include "app/_edit_deck_cards.html.jinja" %}
        {{ actions() }}
    </div>
{% endmacro %}
{% if fragment|default("") == "form" %}{{ form() }}
{% elif fragment|default("") == "steps" %}{{ steps() }}
{% elif fragment|default("") == "marker" %}{{ marker() }}
{% elif fragment|default("") == "actions" %}{{ actions() }}
{% elif fragment|default("") == "preview" %}{{ preview_card() }}
{% elif fragment|default("") == "error" %}{{ error() }}
{% else %}
    <main id="add-wizard"
          class="review-app"
          data-deck-id="{{ deck_id }}"
          data-initial-view="{{ initial_view }}"
          data-initial-card="{{ projection.draft.nid }}"
          data-initial-step="{{ projection.step.path }}"
          data-signals="{_busy: false}"
          data-discard="{{ s('app_edit_discard') }}"
          data-load-failed="{{ s('app_add_edit_unavailable') }}"
          data-browse-phase="{{ 'open' if initial_view == 'cards' else 'closed' }}"
          data-indicator:_busy
          data-attr:aria-busy="$_busy ? 'true' : 'false'"
          data-on:av-history="window.avPrepareHistory(evt); evt.detail.path ? @post(window.avAction(evt.detail.path), {contentType:'form', selector:'#edit-form'}) : null"
          data-on:av-history-failed="window.avEditError(el.dataset.loadFailed)"
          data-on:popstate__window="window.avSummaryHistory(); window.avEditPop(evt, el.dataset.discard)"
          data-on:datastar-fetch__document="window.avEditFetch(evt)"
          data-on:keydown__window="window.avEditKey(evt)">
        {{ form() }}
        <div id="edit-dialog-host">
            <div hidden>{% include "app/_edit_summary_count.html.jinja" %}</div>
        </div>
    </main>
{% endif %}
