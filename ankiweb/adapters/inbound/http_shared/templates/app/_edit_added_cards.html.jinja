<div id="pile-region" class="contents">
  <button id="pile" type="button" class="flex w-full flex-col cursor-auto select-auto p-0 text-start focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"
          aria-controls="deck-cards" aria-expanded="false"
          aria-label="{{ count }} {{ s('app_edit_stack_label_one') if count == 1 else s('app_edit_stack_label_other') }}"
          data-label-one="{{ s('app_edit_stack_label_one') }}" data-label-other="{{ s('app_edit_stack_label_other') }}"
          data-discard="{{ s('app_edit_discard') }}"
          data-attr:aria-expanded="$_browsing ? 'true' : 'false'"
          data-attr:aria-label="$count + ' ' + ($count === 1 ? el.dataset.labelOne : el.dataset.labelOther)"
          data-attr:aria-disabled="$count === 0 ? 'true' : 'false'"
          data-attr:tabindex="$count === 0 ? '-1' : null"
          data-show="!$_browsing"
          data-on:click="$count > 0 &amp;&amp; window.avConfirmDiscard($front, $back, $hint, $example, $saving, el.dataset.discard, $nid, $editOriginal) ? ($_browsing = true, window.avOpenBrowse(el)) : null">
<div id="added-cards" class="mt-1"{% if animation_stamp|default(false) %} data-ts="{{ animation_stamp }}"{% endif %}>
  {% if cards %}
  <div class="relative mx-3 h-72">
    <span class="sr-only">{{ count }} {{ s('app_add_cards_added') }}</span>
    <svg class="add-stack-badge" viewBox="0 0 100 100" aria-hidden="true">
      <defs><path id="add-stack-arc" d="M 15 50 A 35 35 0 0 0 85 50"/></defs>
      <polygon class="add-stack-star" points="50.0,2.0 60.4,11.4 74.0,8.4 78.3,21.7 91.6,26.0 88.6,39.6 98.0,50.0 88.6,60.4 91.6,74.0 78.3,78.3 74.0,91.6 60.4,88.6 50.0,98.0 39.6,88.6 26.0,91.6 21.7,78.3 8.4,74.0 11.4,60.4 2.0,50.0 11.4,39.6 8.4,26.0 21.7,21.7 26.0,8.4 39.6,11.4"/>
      <text class="add-stack-count" x="50" y="58" text-anchor="middle">{{ count }}</text>
      <text class="add-stack-unit"><textPath href="#add-stack-arc" startOffset="50%" text-anchor="middle">{{ s('app_add_stack_cards_one') if count == 1 else s('app_add_stack_cards_other') }}</textPath></text>
    </svg>
    {% for card in cards|reverse %}
    {% if loop.first %}
    <article {% if animation_stamp|default(false) %}class="card absolute added-0 animate-slide-to-added motion-reduce:animate-none h-40 w-full overflow-hidden border-3 border-neo-edge bg-base-200 shadow-neo"{% else %}class="card absolute added-0 h-40 w-full overflow-hidden border-3 border-neo-edge bg-base-200 shadow-neo"{% endif %}
             data-note-id="{{ card.nid }}"{% if animation_stamp|default(false) %} data-ts="{{ animation_stamp }}"{% endif %}>
      <div class="card-body justify-center gap-1 p-4">
        <p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-lg font-black">{{ card.front }}</p>
        <p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap font-bold text-primary">{{ card.back }}</p>
        {% if card.hint %}<p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-sm font-bold text-muted-fg">{{ card.hint }}</p>{% endif %}
        {% if card.example %}<p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-sm font-bold text-muted-fg">{{ card.example }}</p>{% endif %}
      </div>
    </article>
    {% else %}
    <div {% if loop.index0 == 1 %}class="card absolute added-1 h-40 w-full overflow-hidden border-3 border-neo-edge bg-base-200 shadow-neo"{% elif loop.index0 == 2 %}class="card absolute added-2 h-40 w-full overflow-hidden border-3 border-neo-edge bg-base-200 shadow-neo"{% else %}class="card absolute added-3 h-40 w-full overflow-hidden border-3 border-neo-edge bg-base-200 shadow-neo"{% endif %} aria-hidden="true">
      <div class="card-body justify-center gap-1 p-4">
        <p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-lg font-black">{{ card.front }}</p>
        <p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap font-bold text-primary">{{ card.back }}</p>
        {% if card.hint %}<p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-sm font-bold text-muted-fg">{{ card.hint }}</p>{% endif %}
        {% if card.example %}<p class="line-clamp-1 wrap-anywhere whitespace-pre-wrap text-sm font-bold text-muted-fg">{{ card.example }}</p>{% endif %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <div class="add-empty">
    <p class="flex items-center justify-center gap-2"><span aria-hidden="true">✨</span><span>{{ s('app_add_no_cards') }}</span></p>
    <p>{{ s('app_add_first_card') }}</p>
  </div>
  {% endif %}
</div>
  </button>
  <p class="text-center text-xs font-black uppercase tracking-wide text-muted-fg" data-show="!$_browsing &amp;&amp; $count > 0" style="display:none">{{ s('app_edit_pile_cue') }}</p>
  {% if deck_cards %}
  <button id="empty-pile-open" type="button" class="btn neo-press mt-2 rounded-deck border-2 border-neo-edge bg-base-200 font-black shadow-neo active:shadow-none focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"
          aria-controls="deck-cards" aria-expanded="false" data-attr:aria-expanded="$_browsing ? 'true' : 'false'"
          data-discard="{{ s('app_edit_discard') }}" data-show="!$_browsing &amp;&amp; $count === 0" style="display:none"
          data-on:click="window.avConfirmDiscard($front, $back, $hint, $example, $saving, el.dataset.discard, $nid, $editOriginal) ? ($_browsing = true, window.avOpenBrowse(el)) : null">{{ s('app_edit_empty_open', count=deck_cards|length) }}</button>
  {% endif %}
</div>
