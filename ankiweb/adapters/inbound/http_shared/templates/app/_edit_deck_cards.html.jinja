<section id="deck-cards"
         class="deck-browse"
         aria-labelledby="deck-cards-title"
         tabindex="-1"
         {% if progress_reset|default(false) %}aria-describedby="deck-progress-reset-notice"{% endif %}
         data-show="$_browsePhase === 'open' || $_browsePhase === 'closing'"
         data-class:is-folding="$_browsePhase === 'closing'"
         data-attr:inert="$_browsePhase !== 'open'"
         data-attr:aria-hidden="$_browsePhase === 'open' ? null : 'true'"
         inert
         aria-hidden="true"
         style="display:none">
    <h2 id="deck-cards-title" class="sr-only">{{ s("app_edit_browse_title") }}</h2>
    {% if progress_reset|default(false) %}
        <div id="deck-progress-reset-notice"
             class="alert alert-success mb-3 text-sm font-bold"
             role="status">{{ s("app_edit_progress_reset") }}</div>
    {% endif %}
    <ul class="deck-browse-list">
        {% for card in deck_cards|reverse %}
            <li style="--fan-delay: {{ [loop.index0, 5]|min * 38 }}ms;
                       --fold-delay: {{ [loop.revindex0, 5]|min * 24 }}ms">
                <button type="button"
                        class="browse-card w-full rounded-deck border-2 border-neo-edge bg-base-200 p-3 text-start shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"
                        data-note-id="{{ card.nid }}"
                        aria-label="{{ s('app_edit_row_label', front=card.front) }}{% if card.learned %}, {{ s('app_edit_learned') }}{% endif %}"
                        data-load-failed="{{ s('app_add_edit_unavailable') }}"
                        data-on:datastar-fetch="el === evt.detail.el &amp;&amp; evt.detail.type === 'error' ? window.avEditError(el.dataset.loadFailed) : null"
                        data-on:click="$saving ? null : (window.avBumpRev(), @post(window.avAction('/card/{{ card.nid }}'), {contentType:'form', selector:'#edit-form'}))"
                        data-indicator:saving
                        data-attr:disabled="$saving">
                    <span class="browse-num" aria-hidden="true">{{ loop.index }}</span>
                    <span class="browse-body">
                        <span class="flex flex-wrap items-start justify-between gap-2">
                            <span class="min-w-0 flex-1 wrap-anywhere whitespace-pre-wrap text-lg font-black"
                                  dir="auto">{{ card.front }}</span>
                            {% if card.learned %}<span class="rounded-deck bg-warning px-2 py-1 text-xs font-black text-warning-content">{{ s("app_edit_learned") }}</span>{% endif %}
                        </span>
                        <span class="mt-1 block wrap-anywhere whitespace-pre-wrap font-bold text-primary"
                              dir="auto">{{ card.back }}</span>
                        {% if card.hint %}<span class="mt-1 block wrap-anywhere whitespace-pre-wrap text-sm text-muted-fg"
                                                dir="auto">{{ card.hint }}</span>{% endif %}
                        {% if card.example %}<span class="mt-1 block wrap-anywhere whitespace-pre-wrap text-sm text-muted-fg"
                                                   dir="auto">{{ card.example }}</span>{% endif %}
                        <span class="mt-2 block text-sm font-black">{{ s("app_edit_row_action") }} →</span>
                    </span>
                </button>
            </li>
        {% endfor %}
    </ul>
</section>
