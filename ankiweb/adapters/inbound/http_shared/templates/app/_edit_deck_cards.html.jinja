<section id="deck-cards" class="deck-card rounded-box bg-base-200 p-4" aria-labelledby="deck-cards-title" data-show="$_browsing" style="display:none">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 id="deck-cards-title" class="text-xl font-black" tabindex="-1">{{ s('app_edit_browse_title') }}</h2>
    <button id="deck-cards-back" type="button" class="btn btn-sm rounded-deck border-2 border-neo-edge bg-base-200 font-black shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"
            data-attr:disabled="$saving" data-on:click="$_browsing = false; window.avCloseBrowse()">{{ s('app_edit_browse_back') }}</button>
  </div>
  <p id="deck-cards-legend" class="mb-3 rounded-deck bg-warning p-3 text-sm font-bold text-warning-content">{{ s('app_edit_learned_legend') }}</p>
  <ul class="flex flex-col gap-3">
    {% for card in deck_cards %}
    <li>
      <button type="button" class="w-full rounded-deck border-2 border-neo-edge bg-base-100 p-3 text-start shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"
              data-note-id="{{ card.nid }}" aria-label="{{ s('app_edit_row_label', front=card.front) }}{% if card.learned %}, {{ s('app_edit_learned') }}{% endif %}"
              {% if card.learned %}aria-describedby="deck-cards-legend"{% endif %}
              data-load-failed="{{ s('app_add_edit_unavailable') }}"
              data-on:datastar-fetch="el === evt.detail.el &amp;&amp; evt.detail.type === 'error' ? ($error = el.dataset.loadFailed) : null"
              data-on:click="$saving ? null : ($error = '', @post('/app/edit/card/{{ card.nid }}?deck={{ deck_id }}'))"
              data-indicator:saving data-attr:disabled="$saving">
        <span class="flex flex-wrap items-start justify-between gap-2">
          <span class="min-w-0 flex-1 wrap-anywhere whitespace-pre-wrap text-lg font-black" dir="auto">{{ card.front }}</span>
          {% if card.learned %}<span class="rounded-deck bg-warning px-2 py-1 text-xs font-black text-warning-content">{{ s('app_edit_learned') }}</span>{% endif %}
        </span>
        <span class="mt-1 block wrap-anywhere whitespace-pre-wrap font-bold text-primary" dir="auto">{{ card.back }}</span>
        {% if card.hint %}<span class="mt-1 block wrap-anywhere whitespace-pre-wrap text-sm text-muted-fg" dir="auto">{{ card.hint }}</span>{% endif %}
        {% if card.example %}<span class="mt-1 block wrap-anywhere whitespace-pre-wrap text-sm text-muted-fg" dir="auto">{{ card.example }}</span>{% endif %}
        <span class="mt-2 block text-sm font-black">{{ s('app_edit_row_action') }} →</span>
      </button>
    </li>
    {% endfor %}
  </ul>
</section>
