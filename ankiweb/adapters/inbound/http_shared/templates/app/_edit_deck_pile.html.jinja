<div id="pile-region"
     class="pile-region"
     data-show="$_browsePhase !== 'open' &amp;&amp; $_browsePhase !== 'closing'">
    <button id="pile"
            type="button"
            {% if deck_cards|length == 0 %}class="pile-button pile-size-0 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" {% elif deck_cards|length == 1 %}class="pile-button pile-size-1 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" {% elif deck_cards|length == 2 %}class="pile-button pile-size-2 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" {% elif deck_cards|length == 3 %}class="pile-button pile-size-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" {% elif deck_cards|length == 4 %}class="pile-button pile-size-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" {% else %}class="pile-button pile-size-5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary"{% endif %}
            aria-controls="deck-cards"
            aria-expanded="false"
            aria-label="{{ deck_cards|length }} {{ s('app_edit_stack_label_one') if deck_cards|length == 1 else s('app_edit_stack_label_other') }}"
            data-label-one="{{ s('app_edit_stack_label_one') }}"
            data-label-other="{{ s('app_edit_stack_label_other') }}"
            data-discard="{{ s('app_edit_discard') }}"
            data-attr:aria-expanded="$_browsing ? 'true' : 'false'"
            data-attr:disabled="{{ (deck_cards|length == 0)|tojson }} || $_browsing || $_busy"
            data-on:click="!$_browsing &amp;&amp; window.avConfirmDiscard(el.dataset.discard) ? (window.avBumpRev(), $_browsing = true, $_browsePhase = 'opening', window.avOpenBrowse(el)) : null">
        <span id="added-cards"
              class="pile-cards"{% if animation_stamp|default(false) %} data-ts="{{ animation_stamp }}"{% endif %}>
            {% for card in deck_cards[:5] %}
                <span id="stacked-card-{{ card.nid }}"
                      {% if loop.index0 == 0 %}class="stacked-card added-0" {% elif loop.index0 == 1 %}class="stacked-card added-1" {% elif loop.index0 == 2 %}class="stacked-card added-2" {% elif loop.index0 == 3 %}class="stacked-card added-3" {% else %}class="stacked-card added-4"{% endif %}
                      data-note-id="{{ card.nid }}"
                      aria-hidden="true">
                    <span class="stacked-card-front" dir="auto">{{ card.front }}</span>
                    <span class="stacked-card-back" dir="auto">{{ card.back }}</span>
                </span>
            {% endfor %}
            {% if deck_cards %}
                <svg class="add-stack-badge" viewBox="0 0 100 100" aria-hidden="true">
                    <defs>
                    <path id="add-stack-arc" d="M 15 50 A 35 35 0 0 0 85 50" />
                    </defs>
                    <polygon class="add-stack-star" points="50.0,2.0 60.4,11.4 74.0,8.4 78.3,21.7 91.6,26.0 88.6,39.6 98.0,50.0 88.6,60.4 91.6,74.0 78.3,78.3 74.0,91.6 60.4,88.6 50.0,98.0 39.6,88.6 26.0,91.6 21.7,78.3 8.4,74.0 11.4,60.4 2.0,50.0 11.4,39.6 8.4,26.0 21.7,21.7 26.0,8.4 39.6,11.4" />
                    <text class="add-stack-count" x="50" y="58" text-anchor="middle">{{ deck_cards|length }}</text>
                    <text class="add-stack-unit"><textPath href="#add-stack-arc" startOffset="50%" text-anchor="middle">{{ s("app_add_stack_cards_one") if deck_cards|length == 1 else s('app_add_stack_cards_other') }}</textPath></text>
                </svg>
                <span class="pile-cue">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 14l6-6 6 6" />
                    </svg>{{ s("app_edit_pile_cue") }}</span>
            {% else %}
                <span class="add-empty"><span>{{ s("app_add_no_cards") }}</span><span>{{ s("app_add_first_card") }}</span></span>
            {% endif %}
        </span>
    </button>
</div>
