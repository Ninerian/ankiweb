{% import 'app/_deck_language_strings.html.jinja' as language_strings with context %}
{% set labels = language_strings.deck_language_labels %}
{% if fragment == 'body' %}
<div id="deck-delete-body" class="flex min-h-0 flex-1 flex-col">
  <header class="flex-none px-5 pt-5">
    <div class="mx-auto mb-4 h-1.5 w-12 rounded-full bg-base-300" aria-hidden="true"></div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2 id="deck-delete-title" class="text-xl font-black">{{ labels.delete_title }}</h2>
      <button id="deck-delete-close" type="button" class="review-sheet-close" aria-label="{{ tr.actions_close() | tr_clean }}" data-on:click="$delOpen = false"><span aria-hidden="true">✕</span></button>
    </div>
  </header>
  <form id="deck-delete-form" class="flex min-h-0 flex-1 flex-col" data-signals:deleting="false" data-indicator:deleting data-on:submit__prevent="!$deleting && @post('/app/decks/{{ settings.deck_id }}/delete')">
    <div class="min-h-0 flex-1 overflow-y-auto px-5">
      <p id="deck-delete-description" class="text-base font-bold wrap-anywhere">{{ s('app_decks_delete_body', deck=settings.name, cards=settings.card_count) }}</p>
    </div>
    <footer class="flex flex-none gap-3 px-5 pt-5 pb-review-sheet-safe-bottom">
      <button id="deck-delete-cancel" type="button" class="btn flex-1" data-on:click="$delOpen = false">{{ labels.cancel }}</button>
      <button id="deck-delete-confirm" type="submit" class="btn btn-error neo-press flex-1 font-black shadow-neo active:shadow-none" data-attr:disabled="$deleting">{{ labels.delete_confirm }}</button>
    </footer>
  </form>
</div>
{% else %}
<div id="deck-delete-sheet" class="modal modal-bottom sm:modal-middle" role="dialog" aria-modal="true" aria-labelledby="deck-delete-title" aria-describedby="deck-delete-description" aria-hidden="true" inert data-class:modal-open="$delOpen" data-attr:aria-hidden="$delOpen ? 'false' : 'true'" data-attr:inert="!$delOpen" data-effect="window.avDeckFocus($delOpen, 'deck-delete-sheet', 'deck-delete-cancel')" data-on:keydown__window="$delOpen && evt.key === 'Escape' && ($delOpen = false)" data-on:keydown="window.avDeckModalKey(evt)">
  <div class="modal-box mx-auto flex max-h-review-sheet-max-height w-full max-w-xl flex-col overflow-hidden rounded-t-box border-2 border-neo-edge bg-base-200 p-0 shadow-neo sm:rounded-box">
    <div id="deck-delete-body" class="flex min-h-0 flex-1 flex-col"></div>
  </div>
  <div id="deck-delete-backdrop" class="modal-backdrop" data-on:click="$delOpen = false"></div>
</div>
{% endif %}
