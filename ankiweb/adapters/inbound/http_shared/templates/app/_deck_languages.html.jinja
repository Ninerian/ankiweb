{% import 'app/_deck_language_strings.html.jinja' as language_strings with context %}
{% set deck_language_labels = language_strings.deck_language_labels %}
{% set deck_language_names = language_strings.deck_language_names %}
{% import 'app/_deck_projection.html.jinja' as form_projection with context %}
{% macro languages(prefix, projection) %}
<style>
  #{{ prefix }}-language-fields:not(:has(#{{ prefix }}-mode-langs:checked)) #{{ prefix }}-language-details { display: none; }
  #{{ prefix }}-language-details .relative:has(> [data-invalid="true"]) > select { border-color: var(--color-error-border); background-color: var(--color-error); box-shadow: 2px 2px 0 var(--color-error-border); }
  #{{ prefix }}-language-details [data-invalid="true"] { border-color: var(--color-error-border); }
</style>
<fieldset id="{{ prefix }}-language-fields" class="fieldset mb-4" aria-describedby="{{ prefix }}-lang-msg">
  <legend class="fieldset-legend">{{ deck_language_labels.languages }}{% if prefix == 'set' %} {{ form_projection.output('lang-changed', prefix, projection) }}{% endif %}</legend>
  <div class="grid w-full grid-cols-2 gap-2" role="radiogroup" aria-label="{{ deck_language_labels.languages }}">
    <label class="btn relative min-h-11 h-auto min-w-0 gap-1 rounded-deck border-2 border-neo-edge bg-base-200 px-1.5 py-2 text-center text-[clamp(0.75rem,3.2vw,0.875rem)] leading-tight font-black whitespace-nowrap shadow-neo has-checked:translate-x-0.5 has-checked:translate-y-0.5 has-checked:bg-accent has-checked:text-accent-content has-checked:shadow-none has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-primary motion-reduce:has-checked:translate-none">
      <input id="{{ prefix }}-mode-langs" class="absolute inset-0 z-10 m-0 h-full w-full cursor-pointer opacity-0" type="radio" name="mode" value="langs" aria-label="{{ deck_language_labels.mode_pair }}" {% if projection.mode == 'langs' %}checked{% endif %}>
      <span class="shrink-0" aria-hidden="true">🌍</span><span class="min-w-0 truncate">{{ deck_language_labels.mode_pair }}</span>
    </label>
    <label class="btn relative min-h-11 h-auto min-w-0 gap-1 rounded-deck border-2 border-neo-edge bg-base-200 px-1.5 py-2 text-center text-[clamp(0.75rem,3.2vw,0.875rem)] leading-tight font-black whitespace-nowrap shadow-neo has-checked:translate-x-0.5 has-checked:translate-y-0.5 has-checked:bg-accent has-checked:text-accent-content has-checked:shadow-none has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-primary motion-reduce:has-checked:translate-none">
      <input id="{{ prefix }}-mode-none" class="absolute inset-0 z-10 m-0 h-full w-full cursor-pointer opacity-0" type="radio" name="mode" value="none" aria-label="{{ deck_language_labels.mode_none }}" {% if projection.mode == 'none' %}checked{% endif %}>
      <span class="shrink-0" aria-hidden="true">🚫</span><span class="min-w-0 truncate">{{ deck_language_labels.mode_none }}</span>
    </label>
  </div>
  <div id="{{ prefix }}-lang-msg" role="alert" aria-live="polite">{{ form_projection.output('messages', prefix, projection) }}</div>
  <div id="{{ prefix }}-language-details">
    <label class="fieldset-legend mb-1 ml-0.5 block text-xs font-black uppercase tracking-wide text-muted-fg" for="{{ prefix }}-src">{{ deck_language_labels.src }}</label>
    <div class="relative">
      <select id="{{ prefix }}-src" name="src" class="select h-12.5 w-full truncate rounded-deck border-neo-edge bg-base-200 pr-11 pl-14 text-base font-bold shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" aria-describedby="{{ prefix }}-lang-msg {{ prefix }}-lang-note">
        <option value="">{{ deck_language_labels.pick }}</option>
        {% for language in LANGUAGES %}<option value="{{ language.code }}" {% if language.code == projection.src %}selected{% endif %}>{{ deck_language_names[language.code] }} · {{ language.code | upper }}</option>{% endfor %}
      </select>
      {{ form_projection.output('src-flag', prefix, projection) }}
    </div>
    <div class="flex items-center gap-2.5 py-2.5">
      <label class="ml-0.5 min-w-0 text-xs leading-tight font-black uppercase tracking-wide text-muted-fg wrap-anywhere" for="{{ prefix }}-dst">{{ deck_language_labels.dst }}</label>
      <div class="min-w-0 flex-1 border-t-2 border-dashed border-neo-edge opacity-30" aria-hidden="true"></div>
      {{ form_projection.output('swap', prefix, projection) }}
    </div>
    <div class="relative">
      <select id="{{ prefix }}-dst" name="dst" class="select h-12.5 w-full truncate rounded-deck border-neo-edge bg-base-200 pr-11 pl-14 text-base font-bold shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary" aria-describedby="{{ prefix }}-lang-msg {{ prefix }}-lang-note">
        <option value="">{{ deck_language_labels.pick }}</option>
        {% for language in LANGUAGES %}<option value="{{ language.code }}" {% if language.code == projection.dst %}selected{% endif %}>{{ deck_language_names[language.code] }} · {{ language.code | upper }}</option>{% endfor %}
      </select>
      {{ form_projection.output('dst-flag', prefix, projection) }}
    </div>
    <p id="{{ prefix }}-lang-note" class="mt-2 text-sm font-bold text-muted-fg"><strong class="font-black text-base-content">{{ deck_language_labels.src }}:</strong> {{ deck_language_labels.src_hint }} <strong class="font-black text-base-content">{{ deck_language_labels.dst }}:</strong> {{ deck_language_labels.dst_hint }}</p>
  </div>
  {% if prefix == 'new' %}{{ form_projection.output('suggest', prefix, projection) }}{% endif %}
</fieldset>
{% endmacro %}
