{% import 'app/_deck_language_strings.html.jinja' as language_strings with context %}
{% set deck_language_labels = language_strings.deck_language_labels %}
{% set deck_language_names = language_strings.deck_language_names %}
{% set deck_language_flags = {} %}
{% for language in LANGUAGES %}
  {% set _ = deck_language_flags.update({language.code: language.flag}) %}
{% endfor %}
{% macro with_language(text, signal) %}
  {% set parts = text.split('\x1f') %}
  <span>{{ parts[0] }}<strong data-text="{{ js_literal(deck_language_names) }}[{{ signal }}]"></strong>{{ parts[1] }}</span>
{% endmacro %}


{% macro languages(prefix) %}
<fieldset class="fieldset mb-4" aria-describedby="{{ prefix }}-lang-msg" data-signals:_swap__ifmissing="''" data-on:change="${{ prefix }}Error = ''">
  <legend class="fieldset-legend">{{ deck_language_labels.languages }}{% if prefix == 'set' %} <span id="set-lang-changed" class="badge badge-info badge-sm h-auto rounded-full border-deck-pill border-neo-edge px-1.5 py-0.5 font-review-sheet text-review-dist-heading leading-none font-black uppercase tracking-wide" data-show="$setMode !== $baseMode || ($setMode === 'langs' && ($setSrc !== $baseSrc || $setDst !== $baseDst))" style="display:none">{{ deck_language_labels.changed_tag }}</span>{% endif %}</legend>
  <div class="grid w-full grid-cols-2 gap-2" role="radiogroup" aria-label="{{ deck_language_labels.languages }}">
    <label class="btn relative min-h-11 h-auto min-w-0 gap-1 rounded-deck border-2 border-neo-edge bg-base-200 px-1.5 py-2 text-center text-[clamp(0.75rem,3.2vw,0.875rem)] leading-tight font-black whitespace-nowrap shadow-neo has-checked:translate-x-0.5 has-checked:translate-y-0.5 has-checked:bg-accent has-checked:text-accent-content has-checked:shadow-none has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-primary motion-reduce:has-checked:translate-none">
      <input id="{{ prefix }}-mode-langs" class="absolute inset-0 z-10 m-0 h-full w-full cursor-pointer opacity-0" type="radio" name="{{ prefix }}-mode" value="langs" aria-label="{{ deck_language_labels.mode_pair }}" data-bind:{{ prefix }}-mode>
      <span class="shrink-0" aria-hidden="true">🌍</span><span class="min-w-0 truncate">{{ deck_language_labels.mode_pair }}</span>
    </label>
    <label class="btn relative min-h-11 h-auto min-w-0 gap-1 rounded-deck border-2 border-neo-edge bg-base-200 px-1.5 py-2 text-center text-[clamp(0.75rem,3.2vw,0.875rem)] leading-tight font-black whitespace-nowrap shadow-neo has-checked:translate-x-0.5 has-checked:translate-y-0.5 has-checked:bg-accent has-checked:text-accent-content has-checked:shadow-none has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-primary motion-reduce:has-checked:translate-none">
      <input id="{{ prefix }}-mode-none" class="absolute inset-0 z-10 m-0 h-full w-full cursor-pointer opacity-0" type="radio" name="{{ prefix }}-mode" value="none" aria-label="{{ deck_language_labels.mode_none }}" data-bind:{{ prefix }}-mode>
      <span class="shrink-0" aria-hidden="true">🚫</span><span class="min-w-0 truncate">{{ deck_language_labels.mode_none }}</span>
    </label>
  </div>
  <div id="{{ prefix }}-lang-msg" role="alert" aria-live="polite">
    <div class="alert alert-error mt-2 flex items-start gap-2 rounded-deck border-2 border-review-ease-error-border bg-error px-3 py-2.5 text-sm font-bold text-error-content shadow-[2px_2px_0_var(--color-error-border)] wrap-anywhere" data-show="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && ${{ prefix }}Src === ${{ prefix }}Dst" style="display:none"><span aria-hidden="true">⚠</span>{{ with_language(deck_language_labels.same, '$' ~ prefix ~ 'Src') }}</div>
    <div class="alert alert-warning mt-2 flex items-start gap-2 rounded-deck border-2 border-review-ease-warning-border bg-warning px-3 py-2.5 text-sm font-bold text-warning-content wrap-anywhere" data-show="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && !${{ prefix }}Dst" style="display:none"><span aria-hidden="true">⚠</span><span>{{ deck_language_labels.missing_dst }}</span></div>
    <div class="alert alert-warning mt-2 flex items-start gap-2 rounded-deck border-2 border-review-ease-warning-border bg-warning px-3 py-2.5 text-sm font-bold text-warning-content wrap-anywhere" data-show="${{ prefix }}Mode === 'langs' && !${{ prefix }}Src && !!${{ prefix }}Dst" style="display:none"><span aria-hidden="true">⚠</span><span>{{ deck_language_labels.missing_src }}</span></div>
    {% if prefix == 'set' %}
    <div class="alert alert-warning mt-2 flex items-start gap-2 rounded-deck border-2 border-review-ease-warning-border bg-warning px-3 py-2.5 text-sm font-bold text-warning-content wrap-anywhere" data-show="$setMode === 'none' && $baseMode === 'langs' && !!$baseSrc && !!$baseDst" style="display:none"><span aria-hidden="true">⚠</span><span>{{ deck_language_labels.none_removes }}</span></div>
    {% endif %}
  </div>
  <div id="{{ prefix }}-language-details" data-show="${{ prefix }}Mode === 'langs'" style="display:none">
    <label class="fieldset-legend mb-1 ml-0.5 block text-xs font-black uppercase tracking-wide text-muted-fg" for="{{ prefix }}-src">{{ deck_language_labels.src }}</label>
    <div class="relative">
      <select id="{{ prefix }}-src" class="select peer h-12.5 w-full truncate rounded-deck border-neo-edge bg-base-200 pr-11 pl-14 text-base font-bold shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary aria-invalid:border-review-ease-error-border aria-invalid:bg-error aria-invalid:shadow-[2px_2px_0_var(--color-error-border)]" aria-describedby="{{ prefix }}-lang-msg {{ prefix }}-lang-note" data-bind:{{ prefix }}-src data-attr:aria-invalid="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && ${{ prefix }}Src === ${{ prefix }}Dst ? 'true' : 'false'" data-class:select-error="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && ${{ prefix }}Src === ${{ prefix }}Dst">
        <option value="">{{ deck_language_labels.pick }}</option>
        {% for language in LANGUAGES %}
        <option value="{{ language.code }}">{{ deck_language_names[language.code] }} · {{ language.code | upper }}</option>
        {% endfor %}
      </select>
      <span id="{{ prefix }}-flag-src" class="pointer-events-none absolute top-1/2 left-2 z-10 grid h-8.5 w-9.5 -translate-y-1/2 place-items-center rounded-lg border-2 border-neo-edge bg-base-100 text-xl leading-none data-[empty=true]:border-dashed data-[empty=true]:bg-transparent data-[empty=true]:text-sm data-[empty=true]:font-black data-[empty=true]:text-muted-fg peer-aria-invalid:border-review-ease-error-border" aria-hidden="true" data-empty="true" data-attr="{ 'data-empty': ${{ prefix }}Src ? 'false' : 'true' }" data-text="{{ js_literal(deck_language_flags) }}[${{ prefix }}Src] || '?'">?</span>
    </div>
    <div class="flex items-center gap-2.5 py-2.5">
      <label class="ml-0.5 min-w-0 text-xs leading-tight font-black uppercase tracking-wide text-muted-fg wrap-anywhere" for="{{ prefix }}-dst">{{ deck_language_labels.dst }}</label>
      <div class="min-w-0 flex-1 border-t-2 border-dashed border-neo-edge opacity-30" aria-hidden="true"></div>
      <button id="{{ prefix }}-swap" type="button" class="btn neo-press h-auto min-h-10 min-w-0 gap-2 rounded-full bg-base-200 px-3 py-1.5 text-sm leading-tight font-black whitespace-normal focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary disabled:shadow-none" aria-label="{{ deck_language_labels.swap }}" title="{{ deck_language_labels.swap }}" data-attr:disabled="${{ prefix }}Mode === 'none' || (!${{ prefix }}Src && !${{ prefix }}Dst)" data-on:click="$_swap = ${{ prefix }}Src; ${{ prefix }}Src = ${{ prefix }}Dst; ${{ prefix }}Dst = $_swap" disabled><span class="shrink-0 text-lg leading-none" aria-hidden="true">⇅</span><span class="min-w-0 wrap-anywhere">{{ deck_language_labels.swap_short }}</span></button>
    </div>
    <div class="relative">
      <select id="{{ prefix }}-dst" class="select peer h-12.5 w-full truncate rounded-deck border-neo-edge bg-base-200 pr-11 pl-14 text-base font-bold shadow-neo focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary aria-invalid:border-review-ease-error-border aria-invalid:bg-error aria-invalid:shadow-[2px_2px_0_var(--color-error-border)]" aria-describedby="{{ prefix }}-lang-msg {{ prefix }}-lang-note" data-bind:{{ prefix }}-dst data-attr:aria-invalid="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && ${{ prefix }}Src === ${{ prefix }}Dst ? 'true' : 'false'" data-class:select-error="${{ prefix }}Mode === 'langs' && !!${{ prefix }}Src && ${{ prefix }}Src === ${{ prefix }}Dst">
        <option value="">{{ deck_language_labels.pick }}</option>
        {% for language in LANGUAGES %}
        <option value="{{ language.code }}">{{ deck_language_names[language.code] }} · {{ language.code | upper }}</option>
        {% endfor %}
      </select>
      <span id="{{ prefix }}-flag-dst" class="pointer-events-none absolute top-1/2 left-2 z-10 grid h-8.5 w-9.5 -translate-y-1/2 place-items-center rounded-lg border-2 border-neo-edge bg-base-100 text-xl leading-none data-[empty=true]:border-dashed data-[empty=true]:bg-transparent data-[empty=true]:text-sm data-[empty=true]:font-black data-[empty=true]:text-muted-fg peer-aria-invalid:border-review-ease-error-border" aria-hidden="true" data-empty="true" data-attr="{ 'data-empty': ${{ prefix }}Dst ? 'false' : 'true' }" data-text="{{ js_literal(deck_language_flags) }}[${{ prefix }}Dst] || '?'">?</span>
    </div>
    <p id="{{ prefix }}-lang-note" class="mt-2 text-sm font-bold text-muted-fg"><strong class="font-black text-base-content">{{ deck_language_labels.src }}:</strong> {{ deck_language_labels.src_hint }} <strong class="font-black text-base-content">{{ deck_language_labels.dst }}:</strong> {{ deck_language_labels.dst_hint }}</p>
  </div>
  {% if prefix == 'new' %}
  <button id="new-flag-suggest" type="button" class="btn btn-sm mt-2 h-auto min-h-0 max-w-full gap-2 rounded-full border-2 border-info-content bg-info px-3 py-1.5 text-left text-sm leading-tight font-black text-info-content whitespace-normal focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary active:translate-x-px active:translate-y-px" data-show="$newMode === 'langs' && !!$newDst && $newSrc !== $newDst && $newEmoji !== {{ js_literal(deck_language_flags) }}[$newDst]" data-on:click="$newError = ''; $newEmoji = {{ js_literal(deck_language_flags) }}[$newDst]" style="display:none"><span class="shrink-0 text-lg leading-none" aria-hidden="true" data-text="{{ js_literal(deck_language_flags) }}[$newDst]"></span>{{ with_language(deck_language_labels.flag_suggest, '$newDst') }}</button>
  {% endif %}
</fieldset>
{% endmacro %}
