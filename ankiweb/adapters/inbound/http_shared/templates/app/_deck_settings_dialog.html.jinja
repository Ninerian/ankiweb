{% import 'app/_deck_language_strings.html.jinja' as language_strings with context %}
{% import 'app/_deck_languages.html.jinja' as language_picker with context %}
{% import 'app/_deck_projection.html.jinja' as form_projection with context %}
{% import 'app/_deck_emoji_picker.html.jinja' as emoji_picker with context %}
{% set labels = language_strings.deck_language_labels %}
<dialog id="deck-dialog" class="modal modal-bottom sm:modal-middle" data-token="{{ token }}" aria-labelledby="deck-settings-title" data-init="el.showModal()" data-on:close="window.avDeckDialogClosed(el)">
  <div class="modal-box mx-auto flex max-h-review-sheet-max-height w-full max-w-xl flex-col overflow-hidden rounded-t-box border-2 border-neo-edge bg-base-200 p-0 shadow-neo sm:rounded-box">
    <header class="flex-none px-5 pt-5">
      <div class="mx-auto mb-4 h-1.5 w-12 rounded-full bg-base-300 sm:hidden" aria-hidden="true"></div>
      <div class="mb-4 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h2 id="deck-settings-title" class="text-xl font-black">{{ labels.settings_title }}</h2>
          <p class="text-sm font-bold text-base-content/70 wrap-anywhere">{{ settings.name }}</p>
        </div>
        <button id="deck-settings-close" type="button" class="review-sheet-close" aria-label="{{ tr.actions_close() | tr_clean }}" data-on:click="el.closest('dialog').close()"><span aria-hidden="true">✕</span></button>
      </div>
    </header>
    <form id="deck-settings-form" class="flex min-h-0 flex-1 flex-col" data-indicator:_saving data-on:submit__prevent="!$_saving &amp;&amp; (el.dataset.submitted = 'true', @post('/app/decks/{{ settings.deck_id }}/settings', {contentType: 'form', requestCancellation: 'disabled'}))">
      <input type="hidden" name="token" value="{{ token }}">
      <div class="min-h-0 flex-1 overflow-y-auto px-5" data-on:input="el.closest('form').removeAttribute('data-submitted')" data-on:input__debounce.200ms="!$_saving &amp;&amp; @post('/app/decks/{{ settings.deck_id }}/settings/preview', {contentType: 'form'})">
        {{ form_projection.output('dirty', 'set', projection) }}
        {{ form_projection.output('preview', 'set', projection) }}
        <fieldset class="fieldset mb-3">
          <div class="flex items-baseline justify-between gap-2">
            <label class="fieldset-legend" for="set-name">{{ s('app_decks_name') }} {{ form_projection.output('name-changed', 'set', projection) }}</label>
            {{ form_projection.output('name-count', 'set', projection) }}
          </div>
          <label class="input flex h-12.5 w-full items-center gap-2.5 border-neo-edge bg-base-200 px-3.5 shadow-neo focus-within:outline-3 focus-within:outline-offset-3 focus-within:outline-primary">
            <input id="set-name" name="name" class="grow text-base font-bold" type="text" maxlength="40" autocomplete="off" autocapitalize="words" enterkeyhint="done" value="{{ settings.name }}" autofocus data-on:keydown="evt.key === 'Enter' &amp;&amp; (evt.preventDefault(), el.form.requestSubmit())">
          </label>
        </fieldset>
        {{ form_projection.output('error', 'set', projection) }}
        {{ language_picker.languages('set', projection) }}
        <p id="set-emoji-label" class="mb-2 text-sm font-black">{{ s('app_decks_pick_emoji') }} {{ form_projection.output('emoji-changed', 'set', projection) }}</p>
        {{ emoji_picker.emoji_picker('set', settings.emoji) }}
      </div>
      <footer class="flex flex-none gap-2.5 border-t-2 border-neo-edge bg-base-200 px-5 pt-3 pb-review-sheet-safe-bottom">
        <button id="deck-settings-cancel" type="button" class="btn neo-press min-h-14 min-w-0 flex-5 rounded-deck bg-base-300 text-base font-black shadow-neo active:shadow-none" data-on:click="el.closest('dialog').close()">{{ labels.cancel }}</button>
        {{ form_projection.output('submit', 'set', projection) }}
      </footer>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit" tabindex="-1" aria-label="{{ tr.actions_close() | tr_clean }}"></button></form>
</dialog>
