{% for r in rows %}
<tr
  id="browser-row-{{ r.cid }}"
  class="browser-row{% if r.is_suspended %} suspended-card{% endif %}{% if r.selected %} selected{% endif %}"
  data-cid="{{ r.cid }}"
  data-indicator:_browser-busy
  aria-selected="{% if r.selected %}true{% else %}false{% endif %}"
  data-on:click="$_browserBusy ? null : @post('/browse/select?cid={{ r.cid }}&mode=' + (evt.shiftKey ? 'range' : ((evt.ctrlKey || evt.metaKey) ? 'toggle' : 'single')) + '&openDetail=1', {contentType: 'form', selector: '#browser-state'})"
  data-on:contextmenu="evt.ctrlKey ? (evt.preventDefault(), ($_browserBusy ? null : @post('/browse/select?cid={{ r.cid }}&mode=' + (evt.shiftKey ? 'range' : 'toggle') + '&openDetail=1', {contentType: 'form', selector: '#browser-state'}))) : null"
>
  <td class="cell-select text-center" data-on:click="evt.stopPropagation()">
    <label class="browser-checkbox-target">
      <input
        type="checkbox"
        class="checkbox checkbox-xs"
        aria-label="{{ tr.browsing_card() }}: {{ r.sort_text }}"
        data-indicator:_browser-busy
        data-attr:disabled="$_browserBusy"
        {% if r.selected %}checked{% endif %}
        data-init="el.checked = {{ 'true' if r.selected else 'false' }}"
        data-on:click__prevent="$_browserBusy ? null : @post('/browse/select?cid={{ r.cid }}&mode=toggle', {contentType: 'form', selector: '#browser-state'})"
      >
    </label>
  </td>
  <td class="md:hidden cell-mobile py-2 px-3">
    <div class="row-line1 font-semibold truncate flex items-center gap-1">
      <span class="truncate min-w-0 flex-1">{{ r.sort_text }}</span>
      {% if r.is_suspended %}
      <span class="badge badge-neutral ms-auto shrink-0">{{ tr.browsing_suspended() }}</span>
      {% endif %}
    </div>
    <div class="row-line2 text-base-content/60 text-xs truncate min-w-0 mt-1">
      <span>{{ r.template_name }}</span>
      <span class="mx-1">·</span>
      <span>{{ r.deck }}</span>
      {% if r.due %}
      <span class="mx-1">·</span>
      <span>{{ r.due }}</span>
      {% endif %}
    </div>
  </td>
  <td class="hidden md:table-cell truncate cell-sortfield" title="{{ r.sort_text }}">
    {{ r.sort_text }}
    {% if r.is_suspended %}
    <span class="badge badge-neutral ms-1">{{ tr.browsing_suspended() }}</span>
    {% endif %}
  </td>
  <td class="hidden md:table-cell truncate cell-card" title="{{ r.template_name }}">{{ r.template_name }}</td>
  <td class="hidden md:table-cell truncate cell-deck">{{ r.deck }}</td>
  <td class="hidden md:table-cell whitespace-nowrap cell-due">{{ r.due }}</td>
  <td class="hidden xl:table-cell truncate cell-tags text-base-content/60" title="{{ r.tags }}">{{ r.tags }}</td>
</tr>
{% endfor %}
