<style>
  @media (max-width: 767.98px) {
    body {
      padding-bottom: 5rem !important;
    }
  }
  [data-bs-theme="dark"] .theme-icon-light,
  .night-mode .theme-icon-light {
    display: none !important;
  }
  [data-bs-theme="dark"] .theme-icon-dark,
  .night-mode .theme-icon-dark {
    display: inline-flex !important;
  }
  #ankiweb-bottom-nav .nav-link.active {
    color: var(--bs-primary) !important;
    font-weight: 600;
  }
</style>

<script>
  (() => {
    function updateToolbarActive() {
      const p = window.location.pathname;
      const targets = [
        ["/deckbrowser", "/deckbrowser"],
        ["/add", "/add"],
        ["/browse", "/browse"],
        ["/graphs", "/graphs"],
        ["/preferences", "/preferences"],
        ["/tools", "/tools"],
        ["/about", "/about"],
        ["/notify", "/notify"]
      ];
      let matched = null;
      for (const [path] of targets) {
        if (p === path || (path !== "/" && p.startsWith(path + "/"))) {
          matched = path;
          break;
        }
      }
      if (p === "/" || p === "") {
        matched = "/deckbrowser";
      }
      if (matched) {
        document.querySelectorAll(`#{{ nav_id }} a[href^="${matched}"]`).forEach(a => {
          if (a.getAttribute("href") === matched || a.getAttribute("href").startsWith(matched + "?")) {
            a.classList.add("active");
            a.setAttribute("aria-current", "page");
          }
        });
        document.querySelectorAll(`#ankiweb-bottom-nav a[data-nav-path="${matched}"]`).forEach(a => {
          a.classList.add("active");
          a.setAttribute("aria-current", "page");
        });
      }
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateToolbarActive);
    } else {
      updateToolbarActive();
    }
  })();
</script>
