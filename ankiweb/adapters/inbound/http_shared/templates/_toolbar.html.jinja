<script>
  (() => {
    function updateToolbarActive() {
      const p = window.location.pathname;
      const moreTargets = [
        "/preferences",
        "/tools",
        "/notetypes",
        "/about",
        "/notify"
      ];
      const targets = [
        ["/deckbrowser", "/deckbrowser"],
        ["/add", "/add"],
        ["/browse", "/browse"],
        ["/graphs", "/graphs"],
        ["/preferences", "/preferences"],
        ["/tools", "/tools"],
        ["/notetypes", "/notetypes"],
        ["/about", "/about"],
        ["/notify", "/notify"]
      ];
      let matched = null;
      for (const [path] of targets) {
        if (p === path || (path !== "/" && p.startsWith(path + "/"))) {
          matched = path;
          break;
        }
      }
      if (p === "/" || p === "") {
        matched = "/deckbrowser";
      }
      if (matched) {
        document.querySelectorAll(`#ankiweb-toolbar a[href^="${matched}"]`).forEach(a => {
          if (a.getAttribute("href") === matched || a.getAttribute("href").startsWith(matched + "?")) {
            a.classList.add("active");
            a.setAttribute("aria-current", "page");
          }
        });
        document.querySelectorAll(`#ankiweb-bottom-nav a[data-nav-path="${matched}"]`).forEach(a => {
          a.classList.add("active");
          a.setAttribute("aria-current", "page");
        });
        const isMoreActive = moreTargets.some(t => p === t || (t !== "/" && p.startsWith(t + "/")));
        if (isMoreActive) {
          const moreBtn = document.getElementById("ankiweb-bottom-more-btn");
          if (moreBtn) {
            moreBtn.classList.add("active");
            moreBtn.setAttribute("aria-current", "page");
          }
        }
      }

      // Sync mobile theme switch state
      const isNight = document.documentElement.classList.contains("night-mode") ||
                      document.documentElement.getAttribute("data-theme") === "dark" ||
                      localStorage.getItem("ankiweb-night") === "1";
      const sw = document.getElementById("theme-switch-mobile");
      if (sw) {
        sw.checked = isNight;
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateToolbarActive);
    } else {
      updateToolbarActive();
    }

    // Close desktop More <details> on outside click or Escape
    document.addEventListener("click", (evt) => {
      const details = document.getElementById("ankiweb-toolbar-more");
      if (details && details.hasAttribute("open") && !details.contains(evt.target)) {
        details.removeAttribute("open");
      }
    });
    document.addEventListener("keydown", (evt) => {
      if (evt.key === "Escape") {
        const details = document.getElementById("ankiweb-toolbar-more");
        if (details && details.hasAttribute("open")) {
          details.removeAttribute("open");
        }
      }
    });
  })();
</script>
