{% macro sidebar(decks, tags) %}
  <div class="side-section">{{ tr.browsing_sidebar_decks() }}</div>
  {% for d in decks %}
    <a
      class="side-item"
      title="{{ d.name }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchdeck/{{ d.id }}')"
    >{{ d.name }}</a>
  {% endfor %}
  <div class="side-section">{{ tr.browsing_sidebar_tags() }}</div>
  {% for t in tags %}
    <a
      class="side-item"
      title="{{ t }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchtag', {payload: {tag: '{{ t }}'}})"
    >{{ t }}</a>
  {% endfor %}
{% endmacro %}
<style>
  #browser {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 57px);
  }
  @media (max-width: 767.98px) {
    #browser {
      height: calc(100dvh - var(--ankiweb-bottomnav-h, 3.5rem));
    }
  }

  #browser-top {
    flex-shrink: 0;
  }

  #browser-main {
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    min-height: 0;
    overflow: hidden;
  }

  #search {
    max-width: 320px;
    padding: 4px;
  }

  /* Desktop sidebar */
  @media (min-width: 768px) {
    #sidebar-offcanvas {
      width: 200px !important;
      flex-shrink: 0;
      border-right: 1px solid var(--bs-border-color);
      overflow-y: auto;
    }
  }

  #sidebar {
    width: 100%;
    padding: 6px;
  }

  #sidebar .side-section {
    font-weight: bold;
    margin-top: 8px;
    color: var(--bs-body-color);
  }

  #sidebar .side-item {
    display: block;
    padding: 2px 4px;
    color: var(--bs-link-color);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    direction: rtl;
    text-align: left;
    border-radius: var(--bs-border-radius-sm);
  }

  #sidebar .side-item:hover {
    background-color: var(--bs-tertiary-bg);
  }

  #results-wrap {
    flex: 1 1 0%;
    min-width: 0;
    overflow-y: auto;
    overflow-x: auto;
    height: 100%;
  }
  @media (max-width: 767.98px) {
    #results-wrap {
      padding-bottom: var(--ankiweb-bottomnav-h, 3.5rem);
    }
  }

  #results {
    table-layout: fixed;
    width: 100%;
  }

  .browser-row {
    cursor: pointer;
  }
  @media (max-width: 767.98px) {
    .browser-row {
      min-height: 56px;
    }
    .browser-row td.cell-mobile {
      min-height: 56px;
    }
  }

  .browser-row:hover {
    background-color: var(--bs-tertiary-bg);
  }

  .browser-row.suspended-card {
    opacity: 0.65;
  }

  #results tr.selected {
    background-color: var(--bs-primary-bg-subtle) !important;
    border-left: 3px solid var(--bs-primary);
  }

  #results tr.selected > td {
    background-color: transparent !important;
  }

  /* Desktop column widths */
  .cell-sortfield {
    width: 35%;
    max-width: 0;
  }
  .cell-card {
    width: 20%;
    max-width: 0;
  }
  .cell-deck {
    width: 25%;
    max-width: 0;
  }
  .cell-due {
    width: 20%;
  }
  @media (min-width: 1200px) {
    .cell-sortfield { width: 30%; }
    .cell-card { width: 15%; }
    .cell-deck { width: 20%; }
    .cell-due { width: 15%; }
    .cell-tags { width: 20%; max-width: 0; }
  }
  /* Desktop detail pane */
  @media (min-width: 768px) {
    #detail-offcanvas {
      width: 46% !important;
      flex-shrink: 0;
      border-left: 1px solid var(--bs-border-color);
      overflow-y: auto;
    }
  }

  #detail {
    width: 100%;
    padding: 6px;
  }

  #detail .fldname {
    font-weight: bold;
    color: var(--bs-secondary-color, #888);
    font-size: 11px;
    margin-top: 6px;
  }

  .editor-frame {
    width: 100%;
    height: calc(100dvh - 120px);
    border: 0;
  }
</style>
<div id="browser" class="small">
  <div id="browser-top" class="d-flex flex-wrap align-items-center gap-2 p-2 border-bottom">
    <button
      class="btn btn-sm btn-outline-secondary d-md-none"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#sidebar-offcanvas"
      aria-controls="sidebar-offcanvas"
    >
      {{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}
    </button>
    <input
      id="search"
      class="form-control form-control-sm flex-grow-1 flex-md-grow-0"
      type="text"
      autofocus
      placeholder="{{ tr.actions_search() }}…"
      value="{{ query }}"
      onkeydown="if (event.key === 'Enter') {
                              document.getElementById('search-trigger').click();
                          }"
    >
    <div class="d-inline-flex align-items-center gap-2">
      <span id="browser-status" class="text-muted">{{ count_label }}</span>
      <span id="browser-selected-status" class="badge text-bg-secondary" style="display: none;"></span>
    </div>
    <div id="browser-actions" class="d-flex flex-wrap align-items-center gap-1 ms-auto">
      <button id="search-trigger" style="display:none" data-on:click__prevent="const q = document.getElementById('search').value; @post('/browse/search', {payload: {query: q}})"></button>
      <button id="refresh-trigger" style="display:none" data-on:click__prevent="@post('/browse/refresh')"></button>
      <button id="select-trigger" style="display:none" data-on:click__prevent="const cids = window.__ankiwebGetSel(); @post('/browse/select', {payload: {cids: cids}})"></button>

      <div class="btn-group" role="group">
        <button
          id="btn-suspend"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/suspend')"
        >
          {{ tr.studying_suspend() }}
        </button>
        <button
          id="btn-unsuspend"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/unsuspend')"
        >
          {{ tr.actions_unbury_unsuspend() }}
        </button>
        <button
          id="btn-forget"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/forget')"
        >
          {{ tr.actions_forget_card() }}
        </button>
        <button
          id="btn-setdue"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Due in days (e.g. 0, 3, 1-7):').then(function(x) { if (x !== null && x !== '') @post('/browse/setdue', {payload: {value: x}}); })"
        >
          {{ tr.actions_set_due_date() }}
        </button>
        <button
          id="btn-changedeck"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Move to deck:').then(function(x) { if (x !== null && x !== '') @post('/browse/changedeck', {payload: {deck: x}}); })"
        >
          {{ tr.browsing_change_deck() }}
        </button>
        <button
          id="btn-addtag"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Add tag:').then(function(x) { if (x !== null && x !== '') @post('/browse/addtag', {payload: {tag: x}}); })"
        >
          {{ tr.editing_tags_add() }}
        </button>
        <button
          id="btn-removetag"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Remove tag:').then(function(x) { if (x !== null && x !== '') @post('/browse/removetag', {payload: {tag: x}}); })"
        >
          {{ tr.actions_remove_tag() }}
        </button>
        <button
          id="btn-delete"
          class="btn btn-sm btn-outline-danger d-none d-md-inline-block"
          type="button"
          disabled
          data-on:click__prevent="ankiwebConfirm({{ (tr.browsing_delete_notes() ~ '?') | tojson | forceescape }}, {danger: true}).then(function(ok) { if (ok) @post('/browse/delete'); })"
        >
          {{ tr.actions_delete() }}
        </button>
        <button
          id="btn-cardinfo"
          class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
          type="button"
          disabled
          onclick="ankiwebCardInfo()"
        >
          {{ tr.actions_card_info() }}
        </button>

        <!-- Mobile dropdown collapsible -->
        <div class="btn-group d-md-none" role="group">
          <button
            id="btn-actions-dropdown"
            type="button"
            class="btn btn-sm btn-outline-secondary dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            disabled
          >
            {{ tr.studying_more() }}
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-suspend').click()">
                {{ tr.studying_suspend() }}
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-unsuspend').click()">
                {{ tr.actions_unbury_unsuspend() }}
              </button>
            </li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-forget').click()">
                {{ tr.actions_forget_card() }}
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-setdue').click()">
                {{ tr.actions_set_due_date() }}
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-changedeck').click()">
                {{ tr.browsing_change_deck() }}
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-addtag').click()">
                {{ tr.editing_tags_add() }}
              </button>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-removetag').click()">
                {{ tr.actions_remove_tag() }}
              </button>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button class="dropdown-item text-danger" type="button" onclick="document.getElementById('btn-delete').click()">
                {{ tr.actions_delete() }}
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" onclick="document.getElementById('btn-cardinfo').click()">
                {{ tr.actions_card_info() }}
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div id="browser-main">
    <!-- Sidebar in offcanvas-md start -->
    <div
      id="sidebar-offcanvas"
      class="offcanvas-md offcanvas-start bg-body"
      tabindex="-1"
      aria-labelledby="sidebar-offcanvas-label"
    >
      <div class="offcanvas-header d-md-none border-bottom p-2">
        <h6 class="offcanvas-title m-0" id="sidebar-offcanvas-label">{{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}</h6>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          data-bs-target="#sidebar-offcanvas"
          aria-label="Close"
        ></button>
      </div>
      <div class="offcanvas-body p-0">
        <div id="sidebar">{{ sidebar(decks, tags) }}</div>
      </div>
    </div>

    <!-- Results table -->
    <div id="results-wrap">
      <table id="results" class="table table-sm table-hover mb-0">
        <thead class="sticky-top bg-body">
          <tr class="d-none d-md-table-row">
            <th class="cell-sortfield">{{ tr.browsing_sort_field() }}</th>
            <th class="cell-card">{{ tr.browsing_card() }}</th>
            <th class="cell-deck">{{ tr.decks_deck() }}</th>
            <th class="cell-due">{{ tr.statistics_due_date() }}</th>
            <th class="cell-tags d-none d-xl-table-cell">{{ tr.editing_tags() }}</th>
          </tr>
        </thead>
        <tbody id="results-body">{{ initial_rows | safe }}</tbody>
      </table>
    </div>

    <!-- Detail pane in offcanvas-md end -->
    <div
      id="detail-offcanvas"
      class="offcanvas-md offcanvas-end bg-body w-100"
      tabindex="-1"
      aria-labelledby="detail-offcanvas-label"
    >
      <div class="offcanvas-header d-md-none border-bottom p-2">
        <h6 class="offcanvas-title m-0" id="detail-offcanvas-label">{{ tr.browsing_card() }} – {{ tr.importing_details() }}</h6>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          data-bs-target="#detail-offcanvas"
          aria-label="Close"
        ></button>
      </div>
      <div class="offcanvas-body p-0">
        <div id="detail"></div>
      </div>
    </div>
  </div>
</div>
<script>
  (function() {
      window.__ankiwebOnOpchanges = function() {
          var btn = document.getElementById('refresh-trigger');
          if (btn) btn.click();
      };
      var _sel = [],
          _anchor = null;

      function _updateBulkButtons() {
          var count = _sel.length;
          var hasSel = count > 0;
          var actionIds = [
              'btn-suspend', 'btn-unsuspend', 'btn-forget', 'btn-setdue',
              'btn-changedeck', 'btn-addtag', 'btn-removetag', 'btn-delete',
              'btn-cardinfo', 'btn-actions-dropdown'
          ];
          for (var i = 0; i < actionIds.length; i++) {
              var el = document.getElementById(actionIds[i]);
              if (el) el.disabled = !hasSel;
          }
          var selBadge = document.getElementById('browser-selected-status');
          if (selBadge) {
              if (hasSel) {
                  // Anki's window title "Browse (2 of 5480 cards selected)": take the parenthetical,
                  // substituting sentinel numbers so the text stays localized.
                  var tpl = {{ tr.browsing_window_title(total=987654, selected=123456) | tojson }};
                  var st = document.getElementById('browser-status');
                  var total = st ? parseInt(st.textContent, 10) : count;
                  var txt = tpl.replace(/[\u2068\u2069]/g, '')
                      .replace('123456', count).replace('987654', isNaN(total) ? count : total);
                  var m = txt.match(/\((.*)\)/);
                  selBadge.textContent = m ? m[1] : txt;
                  selBadge.style.display = 'inline-block';
              } else {
                  selBadge.style.display = 'none';
              }
          }
      }

      window.__ankiwebGetSel = function() {
          return _sel.map(function(x) { return parseInt(x); });
      };

      window.__ankiwebResetSel = function() {
          _sel = [];
          _anchor = null;
          _hl();
          _updateBulkButtons();
      };

      function _rows() {
          return Array.prototype.slice.call(
              document.querySelectorAll('#results-body tr[data-cid]'));
      }

      function _hl() {
          _rows().forEach(function(tr) {
              tr.classList.toggle('selected', _sel.indexOf(tr.dataset.cid) >= 0);
          });
      }

      function _selChanged() {
          _hl();
          _updateBulkButtons();
          var btn = document.getElementById('select-trigger');
          if (btn) btn.click();
      }

      function _openDetailOnMobile() {
          if (window.innerWidth < 768) {
              var panel = document.getElementById('detail-offcanvas');
              if (panel && typeof bootstrap !== 'undefined' && bootstrap.Offcanvas) {
                  var oc = bootstrap.Offcanvas.getInstance(panel) || new bootstrap.Offcanvas(panel);
                  oc.show();
              }
          }
      }

      function _click(tr, e) {
          var cid = tr.dataset.cid,
              rs = _rows();
          if (e.shiftKey && _anchor !== null) {
              var i = rs.findIndex(function(r) {
                      return r.dataset.cid === _anchor;
                  }),
                  j = rs.findIndex(function(r) {
                      return r.dataset.cid === cid;
                  });
              if (i >= 0 && j >= 0) {
                  var lo = Math.min(i, j),
                      hi = Math.max(i, j);
                  _sel = rs.slice(lo, hi + 1).map(function(r) {
                      return r.dataset.cid;
                  });
              }
          } else if (e.ctrlKey || e.metaKey) {
              var k = _sel.indexOf(cid);
              if (k >= 0) _sel.splice(k, 1);
              else _sel.push(cid);
              _anchor = cid;
          } else {
              _sel = [cid];
              _anchor = cid;
          }
          _selChanged();
          if (_sel.length > 0) {
              _openDetailOnMobile();
          }
      }

      window.ankiwebCardInfo = function() {
          if (_sel.length) window.location.href = '/card-info/' + _sel[0];
      };

      document.getElementById('results-body').addEventListener('click', function(e) {
          var tr = e.target.closest('tr');
          if (tr && tr.dataset.cid) {
              _click(tr, e);
          }
      });

      document.getElementById('results-body').addEventListener('contextmenu', function(e) {
          if (e.ctrlKey) {
              e.preventDefault();
              var tr = e.target.closest('tr');
              if (tr && tr.dataset.cid) {
                  _click(tr, e);
              }
          }
      });

      // Close sidebar offcanvas on mobile when clicking an item
      var sidebarEl = document.getElementById('sidebar-offcanvas');
      if (sidebarEl) {
          sidebarEl.addEventListener('click', function(e) {
              if (e.target.closest('.side-item') && window.innerWidth < 768) {
                  if (typeof bootstrap !== 'undefined' && bootstrap.Offcanvas) {
                      var oc = bootstrap.Offcanvas.getInstance(sidebarEl);
                      if (oc) oc.hide();
                  }
              }
          });
      }

      // Initial state
      _updateBulkButtons();
  })();
</script>