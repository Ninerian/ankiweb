{% macro sidebar(decks, tags) %}
  <div class="side-section">{{ tr.actions_decks() }}</div>
  {% for d in decks %}
    <a
      class="side-item"
      title="{{ d.name }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchdeck/{{ d.id }}')"
    >{{ d.name }}</a>
  {% endfor %}
  <div class="side-section">{{ tr.editing_tags() }}</div>
  {% for t in tags %}
    <a
      class="side-item"
      title="{{ t }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchtag', {payload: {tag: '{{ t }}'}})"
    >{{ t }}</a>
  {% endfor %}
{% endmacro %}
<style>
  #browser {
      font-family: sans-serif;
      font-size: 13px
  }

  #browser-top {
      padding: 6px;
      border-bottom: 1px solid #ccc
  }

  #search {
      width: 60%;
      padding: 4px
  }

  #browser-status {
      margin-left: 10px;
      color: #666
  }

  #browser-main {
      display: flex;
      align-items: flex-start
  }

  #sidebar {
      width: 200px;
      padding: 6px;
      border-right: 1px solid #ccc
  }

  #sidebar .side-section {
      font-weight: bold;
      margin-top: 8px
  }

  #sidebar .side-item {
      display: block;
      padding: 2px 4px;
      color: #06c;
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      direction: rtl;
      text-align: left
  }

  #sidebar .side-item:hover {
      background: #eef
  }

  #results-wrap {
      flex: 1;
      overflow: auto;
      max-height: 80vh
  }

  #results {
      width: 100%;
      border-collapse: collapse
  }

  #results th,
  #results td {
      text-align: left;
      padding: 3px 6px;
      border-bottom: 1px solid #eee
  }

  .browser-row {
      cursor: pointer
  }

  .browser-row:hover {
      background: #eef
  }

  #detail {
      width: 46%;
      padding: 6px;
      border-left: 1px solid #ccc
  }

  #detail .fldname {
      font-weight: bold;
      color: #888;
      font-size: 11px;
      margin-top: 6px
  }

  #results tr.selected {
      background: #cde
  }

  .editor-frame {
      width: 100%;
      height: 78vh;
      border: 0
  }
</style>
<div id="browser">
  <div id="browser-top">
    <input
      id="search"
      type="text"
      autofocus
      placeholder="{{ tr.actions_search() }}…"
      value="{{ query }}"
      onkeydown="if (event.key === 'Enter') {
                              document.getElementById('search-trigger').click();
                          }"
    >
    <span id="browser-status">{{ initial_count }} cards</span>
    <div id="browser-actions">
      <button id="search-trigger" style="display:none" data-on:click__prevent="const q = document.getElementById('search').value; @post('/browse/search', {payload: {query: q}})"></button>
      <button id="refresh-trigger" style="display:none" data-on:click__prevent="@post('/browse/refresh')"></button>
      <button id="select-trigger" style="display:none" data-on:click__prevent="const cids = window.__ankiwebGetSel(); @post('/browse/select', {payload: {cids: cids}})"></button>
      <button type="button" data-on:click__prevent="@post('/browse/suspend')">
        {{ tr.studying_suspend() }}
      </button>
      <button type="button" data-on:click__prevent="@post('/browse/unsuspend')">Unsuspend</button>
      <button type="button" data-on:click__prevent="@post('/browse/forget')">
        {{ tr.actions_forget_card() }}
      </button>
      <button
        type="button"
        data-on:click__prevent="const x = prompt('Due in days (e.g. 0, 3, 1-7):'); if (x !== null && x !== '') @post('/browse/setdue', {payload: {value: x}})"
      >
        {{ tr.actions_set_due_date() }}
      </button>
      <button
        type="button"
        data-on:click__prevent="const x = prompt('Move to deck:'); if (x !== null && x !== '') @post('/browse/changedeck', {payload: {deck: x}})"
      >
        {{ tr.browsing_change_deck() }}
      </button>
      <button type="button" data-on:click__prevent="const x = prompt('Add tag:'); if (x !== null && x !== '') @post('/browse/addtag', {payload: {tag: x}})">
        Add Tag
      </button>
      <button type="button" data-on:click__prevent="const x = prompt('Remove tag:'); if (x !== null && x !== '') @post('/browse/removetag', {payload: {tag: x}})">
        {{ tr.actions_remove_tag() }}
      </button>
      <button
        type="button"
        data-on:click__prevent="if (confirm('Delete selected notes?')) @post('/browse/delete')"
      >
        {{ tr.actions_delete() }}
      </button>
      <button type="button" onclick="ankiwebCardInfo()">
        {{ tr.actions_card_info() }}
      </button>
    </div>
  </div>
  <div id="browser-main">
    <div id="sidebar">{{ sidebar(decks, tags) }}</div>
    <div id="results-wrap">
      <table id="results">
        <thead>
          <tr>
            <th>{{ tr.browsing_sort_field() }}</th>
            <th>{{ tr.decks_deck() }}</th>
            <th>{{ tr.statistics_due_date() }}</th>
          </tr>
        </thead>
        <tbody id="results-body">{{ initial_rows | safe }}</tbody>
      </table>
    </div>
    <div id="detail"></div>
  </div>
</div>
<script>
  (function() {
      window.__ankiwebOnOpchanges = function() {
          var btn = document.getElementById('refresh-trigger');
          if (btn) btn.click();
      };
      var _sel = [],
          _anchor = null;

      window.__ankiwebGetSel = function() {
          return _sel.map(function(x) { return parseInt(x); });
      };

      window.__ankiwebResetSel = function() {
          _sel = [];
          _anchor = null;
      };

      function _rows() {
          return Array.prototype.slice.call(
              document.querySelectorAll('#results-body tr[data-cid]'));
      }

      function _hl() {
          _rows().forEach(function(tr) {
              tr.classList.toggle('selected', _sel.indexOf(tr.dataset.cid) >= 0);
          });
      }

      function _selChanged() {
          _hl();
          var btn = document.getElementById('select-trigger');
          if (btn) btn.click();
      }

      function _click(tr, e) {
          var cid = tr.dataset.cid,
              rs = _rows();
          if (e.shiftKey && _anchor !== null) {
              var i = rs.findIndex(function(r) {
                      return r.dataset.cid === _anchor;
                  }),
                  j = rs.findIndex(function(r) {
                      return r.dataset.cid === cid;
                  });
              if (i >= 0 && j >= 0) {
                  var lo = Math.min(i, j),
                      hi = Math.max(i, j);
                  _sel = rs.slice(lo, hi + 1).map(function(r) {
                      return r.dataset.cid;
                  });
              }
          } else if (e.ctrlKey || e.metaKey) {
              var k = _sel.indexOf(cid);
              if (k >= 0) _sel.splice(k, 1);
              else _sel.push(cid);
              _anchor = cid;
          } else {
              _sel = [cid];
              _anchor = cid;
          }
          _selChanged();
      }
      window.ankiwebCardInfo = function() {
          if (_sel.length) window.open('/card-info/' + _sel[0], '_blank');
      };
      document.getElementById('results-body').addEventListener('click', function(e) {
          var tr = e.target.closest('tr');
          if (tr && tr.dataset.cid) {
              _click(tr, e);
          }
      });
      document.getElementById('results-body').addEventListener('contextmenu', function(e) {
          if (e.ctrlKey) {
              e.preventDefault();
              var tr = e.target.closest('tr');
              if (tr && tr.dataset.cid) {
                  _click(tr, e);
              }
          }
      });
  })();
</script>
