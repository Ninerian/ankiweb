{% macro sidebar(decks, tags) %}
  <div class="side-section">{{ tr.browsing_sidebar_decks() }}</div>
  {% for item in decks %}
    <a
      class="side-item"
      title="{{ item.name }}"
      href="/browse?{{ {'q': item.query} | urlencode }}"
    >{{ item.name }}</a>
  {% endfor %}
  <div class="side-section">{{ tr.browsing_sidebar_tags() }}</div>
  {% for item in tags %}
    <a
      class="side-item"
      title="{{ item.name }}"
      href="/browse?{{ {'q': item.query} | urlencode }}"
    >{{ item.name }}</a>
  {% endfor %}
{% endmacro %}
<style>
  #browser {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 57px);
  }
  @media (max-width: 767.98px) {
    #browser {
      height: calc(100dvh - var(--ankiweb-bottomnav-h, 3.5rem));
    }
  }

  #browser-top {
    flex-shrink: 0;
  }

  #browser-main {
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    min-height: 0;
    overflow: hidden;
  }

  #search {
    max-width: 320px;
    padding: 4px;
  }

  /* Desktop sidebar */
  @media (min-width: 768px) {
    #sidebar-offcanvas {
      display: block !important;
      position: static !important;
      width: 200px !important;
      height: 100% !important;
      max-height: none !important;
      flex-shrink: 0;
      border-right: 1px solid var(--color-base-300);
      overflow-y: auto;
      background: transparent;
      padding: 0;
    }
    #sidebar-offcanvas::backdrop {
      display: none !important;
    }
  }

  #sidebar {
    width: 100%;
    padding: 6px;
  }

  #sidebar .side-section {
    font-weight: bold;
    margin-top: 8px;
    color: var(--color-base-content);
  }

  #sidebar .side-item {
    display: block;
    padding: 2px 4px;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    direction: rtl;
    text-align: left;
    border-radius: var(--radius-selector, 0.25rem);
  }

  #sidebar .side-item:hover {
    background-color: var(--color-base-200);
  }

  #results-wrap {
    flex: 1 1 0%;
    min-width: 0;
    overflow-y: auto;
    overflow-x: auto;
    height: 100%;
  }
  @media (max-width: 767.98px) {
    #results-wrap {
      padding-bottom: var(--ankiweb-bottomnav-h, 3.5rem);
    }
  }

  #results {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }

  .browser-row {
    cursor: pointer;
  }
  @media (max-width: 767.98px) {
    .browser-row {
      min-height: 56px;
    }
    .browser-row td.cell-mobile {
      min-height: 56px;
    }
  }

  .browser-row:hover {
    background-color: var(--color-base-200);
  }

  .browser-row.suspended-card {
    opacity: 0.65;
  }

  #results tr.selected {
    background-color: color-mix(in oklab, var(--color-primary) 12%, transparent) !important;
    border-left: 3px solid var(--color-primary);
  }

  #results tr.selected > td {
    background-color: transparent !important;
  }

  /* Desktop column widths */
  .cell-sortfield {
    width: 35%;
    max-width: 0;
  }
  .cell-card {
    width: 20%;
    max-width: 0;
  }
  .cell-deck {
    width: 25%;
    max-width: 0;
  }
  .cell-due {
    width: 20%;
  }
  @media (min-width: 1200px) {
    .cell-sortfield { width: 30%; }
    .cell-card { width: 15%; }
    .cell-deck { width: 20%; }
    .cell-due { width: 15%; }
    .cell-tags { width: 20%; max-width: 0; }
  }
  /* Desktop detail pane (mobile uses the bottom modal) */
  #detail-desktop {
    width: 46%;
    height: 100%;
    flex-shrink: 0;
    border-left: 1px solid var(--color-base-300);
    overflow: hidden;
  }

  #detail {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6px;
  }

  #detail .fldname {
    font-weight: bold;
    color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
    font-size: 11px;
    margin-top: 6px;
  }

  .editor-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  #detail-mobile-slot #detail { height: auto; }
  #detail-mobile-slot .editor-frame { height: 70dvh; }
</style>
{% set raw_title = tr.browsing_window_title(total=987654, selected=123456) %}
{% set clean_title = raw_title | replace('\u2068', '') | replace('\u2069', '') %}
{% if '(' in clean_title and ')' in clean_title %}
  {% set sel_pattern = clean_title.split('(')[1].split(')')[0] %}
{% else %}
  {% set sel_pattern = clean_title %}
{% endif %}
<div
  id="browser"
  class="text-sm"
  data-signals='{{ {
    "selectedCids": [],
    "_selectionAnchor": None,
    "_browserAction": "",
    "_visibleCids": initial_cids,
    "_matchedCount": initial_count | default(0),
    "query": query | default(""),
    "browserQuery": query | default(""),
    "value": "",
    "deck": "",
    "tag": "",
    "error": "",
    "_busy": false
  } | tojson }}'
  data-on:ankiweb:browser-refresh__window="@post('/browse/refresh')"
  data-on:popstate__window="$query = new URL(location.href).searchParams.get('q') || ''; @post('/browse/search')"
>
  <div id="browser-top" class="flex flex-wrap items-center gap-2 p-2 border-b border-base-300">
    <button
      class="btn btn-sm btn-outline md:hidden"
      type="button"
      onclick="document.getElementById('sidebar-offcanvas').showModal()"
    >
      {{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}
    </button>
    <form
      class="grow md:grow-0"
      data-indicator="_busy"
      data-on:submit__prevent="@post('/browse/search')"
    >
      <input
        id="search"
        class="input input-sm w-full md:w-80"
        data-init="if (!document.activeElement || document.activeElement.id !== 'search') el.focus()"
        placeholder="{{ tr.actions_search() }}…"
        data-bind="query"
        value="{{ query }}"
      >
    </form>
    <div class="inline-flex items-center gap-2">
      <span id="browser-status" class="text-base-content/60">{{ count_label }}</span>
      <span
        id="browser-selected-status"
        class="badge badge-neutral"
        data-show="$selectedCids.length > 0"
        data-text="{{ (sel_pattern | tojson | forceescape) }}.replace('123456', $selectedCids.length).replace('987654', $_matchedCount || $selectedCids.length)"
        style="display: none;"
      ></span>
    </div>
    <div id="browser-actions" class="flex flex-wrap items-center gap-1 ms-auto">
      <div class="join" role="group">
        <button
          id="btn-suspend"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-indicator="_busy"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="@post('/browse/suspend')"
        >
          {{ tr.studying_suspend() }}
        </button>
        <button
          id="btn-unsuspend"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-indicator="_busy"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="@post('/browse/unsuspend')"
        >
          {{ tr.actions_unbury_unsuspend() }}
        </button>
        <button
          id="btn-forget"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-indicator="_busy"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="@post('/browse/forget')"
        >
          {{ tr.actions_forget_card() }}
        </button>
        <button
          id="btn-setdue"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="$error = ''; $value = ''; $_browserAction = 'setdue'"
        >
          {{ tr.actions_set_due_date() }}
        </button>
        <button
          id="btn-changedeck"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="$error = ''; $deck = ''; $_browserAction = 'changedeck'"
        >
          {{ tr.browsing_change_deck() }}
        </button>
        <button
          id="btn-addtag"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="$error = ''; $tag = ''; $_browserAction = 'addtag'"
        >
          {{ tr.editing_tags_add() }}
        </button>
        <button
          id="btn-removetag"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="$error = ''; $tag = ''; $_browserAction = 'removetag'"
        >
          {{ tr.actions_remove_tag() }}
        </button>
        <button
          id="btn-delete"
          class="btn btn-sm btn-outline btn-error join-item hidden md:inline-flex"
          type="button"
          data-attr:disabled="!$selectedCids.length || $_busy"
          disabled
          data-on:click__prevent="$error = ''; $_browserAction = 'delete'"
        >
          {{ tr.actions_delete() }}
        </button>
        <a
          id="btn-cardinfo"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex btn-disabled pointer-events-none"
          role="button"
          href="#"
          aria-disabled="true"
          data-attr:href="$selectedCids.length ? ('/card-info/' + $selectedCids[0]) : '#'"
          data-attr:aria-disabled="!$selectedCids.length ? 'true' : 'false'"
          data-class="{'btn-disabled pointer-events-none': !$selectedCids.length}"
        >
          {{ tr.actions_card_info() }}
        </a>

        <!-- Mobile dropdown collapsible -->
        <details
          id="mobile-actions-dropdown"
          class="dropdown dropdown-end md:hidden"
          data-effect="if (!$selectedCids.length && el.hasAttribute('open')) el.removeAttribute('open')"
        >
          <summary
            id="btn-actions-dropdown"
            class="btn btn-sm btn-outline btn-disabled"
            role="button"
            aria-disabled="true"
            data-class="{'btn-disabled': !$selectedCids.length || $_busy}"
            data-attr:aria-disabled="(!$selectedCids.length || $_busy) ? 'true' : 'false'"
          >
            {{ tr.studying_more() }}
          </summary>
          <ul class="dropdown-content menu bg-base-100 rounded-box shadow-sm z-50 p-2 w-48 text-sm">
            <li>
              <button
                type="button"
                data-indicator="_busy"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); @post('/browse/suspend')"
              >
                {{ tr.studying_suspend() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-indicator="_busy"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); @post('/browse/unsuspend')"
              >
                {{ tr.actions_unbury_unsuspend() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-indicator="_busy"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); @post('/browse/forget')"
              >
                {{ tr.actions_forget_card() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); $error = ''; $value = ''; $_browserAction = 'setdue'"
              >
                {{ tr.actions_set_due_date() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); $error = ''; $deck = ''; $_browserAction = 'changedeck'"
              >
                {{ tr.browsing_change_deck() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); $error = ''; $tag = ''; $_browserAction = 'addtag'"
              >
                {{ tr.editing_tags_add() }}
              </button>
            </li>
            <li>
              <button
                type="button"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); $error = ''; $tag = ''; $_browserAction = 'removetag'"
              >
                {{ tr.actions_remove_tag() }}
              </button>
            </li>
            <li><hr class="border-base-300 my-1"></li>
            <li>
              <button
                class="text-error"
                type="button"
                data-attr:disabled="!$selectedCids.length || $_busy"
                disabled
                data-on:click="el.closest('details')?.removeAttribute('open'); $error = ''; $_browserAction = 'delete'"
              >
                {{ tr.actions_delete() }}
              </button>
            </li>
            <li>
              <a
                id="btn-cardinfo-mobile"
                class="btn-disabled pointer-events-none"
                role="button"
                href="#"
                aria-disabled="true"
                data-attr:href="$selectedCids.length ? ('/card-info/' + $selectedCids[0]) : '#'"
                data-attr:aria-disabled="!$selectedCids.length ? 'true' : 'false'"
                data-class="{'btn-disabled pointer-events-none': !$selectedCids.length}"
                data-on:click="el.closest('details')?.removeAttribute('open')"
              >
                {{ tr.actions_card_info() }}
              </a>
            </li>
          </ul>
        </details>
      </div>
    </div>
  </div>

  <div id="browser-main">
    <!-- Sidebar in modal dialog on mobile, static pane on md+ -->
    <dialog
      id="sidebar-offcanvas"
      class="modal modal-bottom sm:modal-middle md:modal-open md:static md:h-full md:max-h-none md:bg-transparent md:border-0 md:p-0 md:shadow-none"
      aria-labelledby="sidebar-offcanvas-label"
      data-on:click="const a = evt.target.closest('.side-item'); if (a && window.innerWidth < 768 && el.open && typeof el.close === 'function') el.close()"
    >
      <div class="modal-box p-0 md:max-w-none md:w-full md:h-full md:p-0 md:rounded-none md:shadow-none md:bg-transparent">
        <div class="flex justify-between items-center md:hidden border-b border-base-300 p-2">
          <h6 class="font-bold text-sm m-0" id="sidebar-offcanvas-label">{{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}</h6>
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button>
          </form>
        </div>
        <div class="p-0 overflow-y-auto">
          <div id="sidebar" data-on:click="const a = evt.target.closest('.side-item'); if (a && evt.button === 0 && !evt.metaKey && !evt.ctrlKey && !evt.shiftKey && !evt.altKey) { evt.preventDefault(); history.pushState(null, '', a.href); $query = new URL(a.href).searchParams.get('q') || ''; @post('/browse/search'); }">{{ sidebar(decks, tags) }}</div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop md:hidden"><button>close</button></form>
    </dialog>
    <!-- Results table -->
    <div id="results-wrap">
      <table id="results" class="table table-sm mb-0">
        <thead class="sticky top-0 bg-base-100 z-10">
          <tr class="hidden md:table-row">
            <th class="cell-sortfield">{{ tr.browsing_sort_field() }}</th>
            <th class="cell-card">{{ tr.browsing_card() }}</th>
            <th class="cell-deck">{{ tr.decks_deck() }}</th>
            <th class="cell-due">{{ tr.statistics_due_date() }}</th>
            <th class="cell-tags hidden xl:table-cell">{{ tr.editing_tags() }}</th>
          </tr>
        </thead>
        <tbody id="results-body">{{ initial_rows | safe }}</tbody>
      </table>
    </div>
    <!-- Detail: desktop-only aside; mobile-only bottom modal. #detail is moved between them by script. -->
    <aside id="detail-desktop" class="hidden md:block"><div id="detail" data-attr:data-selected-cids="$selectedCids.join(',')"></div></aside>
    <dialog id="detail-offcanvas" class="modal modal-bottom md:hidden" aria-labelledby="detail-offcanvas-label">
      <div class="modal-box p-0 max-w-full">
        <div class="flex justify-between items-center border-b border-base-300 p-2">
          <h6 class="font-bold text-sm m-0" id="detail-offcanvas-label">{{ tr.browsing_card() }} – {{ tr.importing_details() }}</h6>
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button>
          </form>
        </div>
        <div id="detail-mobile-slot" class="p-0 overflow-y-auto"></div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
    <script>
      if (!window.matchMedia('(min-width: 768px)').matches) document.getElementById('detail-mobile-slot').appendChild(document.getElementById('detail'));
    </script>
  </div>

  <!-- Consolidated Action Dialogs Macro -->
  {% macro action_dialog(act_key, act_title, prompt_label, input_id, input_bind, placeholder_text, endpoint, is_danger=false, is_confirm=false) %}
  <dialog
    id="dialog-{{ act_key }}"
    class="modal modal-bottom sm:modal-middle"
    aria-labelledby="dialog-{{ act_key }}-title"
    data-effect="if ($_browserAction === '{{ act_key }}') { if (!el.open) { el.showModal(); el.querySelector('input, button.btn-error, button.btn-primary')?.focus(); } } else { if (el.open && !$_busy) el.close(); }"
    data-on:cancel="if ($_busy) { evt.preventDefault(); } else if ($_browserAction === '{{ act_key }}') { $_browserAction = ''; $error = ''; }"
    data-on:close="if (!$_busy && $_browserAction === '{{ act_key }}') { $_browserAction = ''; $error = ''; }"
  >
    <div class="modal-box">
      <div class="flex justify-between items-center pb-2 mb-3 border-b border-base-300">
        <h5 class="font-bold text-lg{% if is_danger %} text-error{% endif %}" id="dialog-{{ act_key }}-title">{{ act_title }}</h5>
        <button
          type="button"
          class="btn btn-sm btn-circle btn-ghost"
          aria-label="Close"
          data-attr:disabled="$_busy"
          data-on:click="if (!$_busy) { $_browserAction = ''; $error = ''; el.closest('dialog')?.close(); }"
        >✕</button>
      </div>
      <div id="browser-action-error-{{ act_key }}" class="mb-3 text-error text-sm font-semibold" role="alert" data-show="$error" data-text="$error"></div>
      <form data-indicator="_busy" data-on:submit__prevent="@post('{{ endpoint }}')">
        {% if is_confirm %}
          <p class="py-2 text-sm">{{ prompt_label }}</p>
        {% else %}
          <div class="mb-4">
            <label for="{{ input_id }}" class="block py-1 text-sm font-semibold">{{ prompt_label }}</label>
            <input
              id="{{ input_id }}"
              type="text"
              class="input input-sm w-full"
              placeholder="{{ placeholder_text }}"
              data-bind="{{ input_bind }}"
              value=""
            >
          </div>
        {% endif %}
        <div class="modal-action">
          <button
            type="button"
            class="btn btn-sm btn-ghost"
            data-attr:disabled="$_busy"
            data-on:click="if (!$_busy) { $_browserAction = ''; $error = ''; el.closest('dialog')?.close(); }"
          >
            {{ tr.actions_cancel() }}
          </button>
          <button
            type="submit"
            class="btn btn-sm {% if is_danger %}btn-error{% else %}btn-primary{% endif %}"
            data-attr:disabled="{% if is_confirm %}!$selectedCids.length || $_busy{% else %}!${{ input_bind }}.trim() || !$selectedCids.length || $_busy{% endif %}"
          >
            {{ act_title }}
          </button>
        </div>
      </form>
    </div>
    <div class="modal-backdrop" data-on:click="if (!$_busy) { $_browserAction = ''; $error = ''; el.closest('dialog')?.close(); }"><button type="button" tabindex="-1" data-attr:disabled="$_busy">close</button></div>
  </dialog>
  {% endmacro %}

  <!-- The five consolidated prompt/confirm action dialogs -->
  {{ action_dialog(
      act_key="setdue",
      act_title=tr.actions_set_due_date(),
      prompt_label="Due in days (e.g. 0, 3, 1-7):",
      input_id="input-setdue",
      input_bind="value",
      placeholder_text="0, 3, 1-7",
      endpoint="/browse/setdue"
  ) }}

  {{ action_dialog(
      act_key="changedeck",
      act_title=tr.browsing_change_deck(),
      prompt_label="Move to deck:",
      input_id="input-changedeck",
      input_bind="deck",
      placeholder_text="Deck name",
      endpoint="/browse/changedeck"
  ) }}

  {{ action_dialog(
      act_key="addtag",
      act_title=tr.editing_tags_add(),
      prompt_label="Add tag:",
      input_id="input-addtag",
      input_bind="tag",
      placeholder_text="Tag",
      endpoint="/browse/addtag"
  ) }}

  {{ action_dialog(
      act_key="removetag",
      act_title=tr.actions_remove_tag(),
      prompt_label="Remove tag:",
      input_id="input-removetag",
      input_bind="tag",
      placeholder_text="Tag",
      endpoint="/browse/removetag"
  ) }}

  {{ action_dialog(
      act_key="delete",
      act_title=tr.actions_delete(),
      prompt_label=(tr.browsing_delete_notes() ~ '?'),
      input_id="",
      input_bind="",
      placeholder_text="",
      endpoint="/browse/delete",
      is_danger=true,
      is_confirm=true
  ) }}

</div>
<script>
  (function() {
      // Bridge for shell_src/bootstrap.ts to refresh in place on external opchanges without full reload
      window.__ankiwebOnOpchanges = function() {
          window.dispatchEvent(new CustomEvent('ankiweb:browser-refresh'));
      };

      // Single #detail node: desktop aside on md+, bottom modal slot below md
      if (window.matchMedia) {
          var mq = window.matchMedia('(min-width: 768px)');
          var placeDetail = function() {
              var d = document.getElementById('detail');
              var host = document.getElementById(mq.matches ? 'detail-desktop' : 'detail-mobile-slot');
              if (d && host && d.parentNode !== host) host.appendChild(d);
          };
          mq.addEventListener('change', function(e) {
              if (e.matches) {
                  ['sidebar-offcanvas', 'detail-offcanvas'].forEach(function(id) {
                      var d = document.getElementById(id);
                      if (d && typeof d.close === 'function' && d.open) {
                          d.close();
                      }
                  });
              }
              placeDetail();
          });
          placeDetail();
      }
  })();
</script>
