{% macro sidebar(decks, tags) %}
  <div class="side-section">{{ tr.browsing_sidebar_decks() }}</div>
  {% for d in decks %}
    <a
      class="side-item"
      title="{{ d.name }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchdeck/{{ d.id }}')"
    >{{ d.name }}</a>
  {% endfor %}
  <div class="side-section">{{ tr.browsing_sidebar_tags() }}</div>
  {% for t in tags %}
    <a
      class="side-item"
      title="{{ t }}"
      href="#"
      data-on:click__prevent="@post('/browse/searchtag', {payload: {tag: '{{ t }}'}})"
    >{{ t }}</a>
  {% endfor %}
{% endmacro %}
<style>
  #browser {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 57px);
  }
  @media (max-width: 767.98px) {
    #browser {
      height: calc(100dvh - var(--ankiweb-bottomnav-h, 3.5rem));
    }
  }

  #browser-top {
    flex-shrink: 0;
  }

  #browser-main {
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    min-height: 0;
    overflow: hidden;
  }

  #search {
    max-width: 320px;
    padding: 4px;
  }

  /* Desktop sidebar */
  @media (min-width: 768px) {
    #sidebar-offcanvas {
      display: block !important;
      position: static !important;
      width: 200px !important;
      height: 100% !important;
      max-height: none !important;
      flex-shrink: 0;
      border-right: 1px solid var(--color-base-300);
      overflow-y: auto;
      background: transparent;
      padding: 0;
    }
    #sidebar-offcanvas::backdrop {
      display: none !important;
    }
  }

  #sidebar {
    width: 100%;
    padding: 6px;
  }

  #sidebar .side-section {
    font-weight: bold;
    margin-top: 8px;
    color: var(--color-base-content);
  }

  #sidebar .side-item {
    display: block;
    padding: 2px 4px;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    direction: rtl;
    text-align: left;
    border-radius: var(--radius-selector, 0.25rem);
  }

  #sidebar .side-item:hover {
    background-color: var(--color-base-200);
  }

  #results-wrap {
    flex: 1 1 0%;
    min-width: 0;
    overflow-y: auto;
    overflow-x: auto;
    height: 100%;
  }
  @media (max-width: 767.98px) {
    #results-wrap {
      padding-bottom: var(--ankiweb-bottomnav-h, 3.5rem);
    }
  }

  #results {
    border-collapse: collapse;
    table-layout: fixed;
    width: 100%;
  }

  .browser-row {
    cursor: pointer;
  }
  @media (max-width: 767.98px) {
    .browser-row {
      min-height: 56px;
    }
    .browser-row td.cell-mobile {
      min-height: 56px;
    }
  }

  .browser-row:hover {
    background-color: var(--color-base-200);
  }

  .browser-row.suspended-card {
    opacity: 0.65;
  }

  #results tr.selected {
    background-color: color-mix(in oklab, var(--color-primary) 12%, transparent) !important;
    border-left: 3px solid var(--color-primary);
  }

  #results tr.selected > td {
    background-color: transparent !important;
  }

  /* Desktop column widths */
  .cell-sortfield {
    width: 35%;
    max-width: 0;
  }
  .cell-card {
    width: 20%;
    max-width: 0;
  }
  .cell-deck {
    width: 25%;
    max-width: 0;
  }
  .cell-due {
    width: 20%;
  }
  @media (min-width: 1200px) {
    .cell-sortfield { width: 30%; }
    .cell-card { width: 15%; }
    .cell-deck { width: 20%; }
    .cell-due { width: 15%; }
    .cell-tags { width: 20%; max-width: 0; }
  }
  /* Desktop detail pane */
  @media (min-width: 768px) {
    #detail-offcanvas {
      display: block !important;
      position: static !important;
      width: 46% !important;
      height: 100% !important;
      max-height: none !important;
      flex-shrink: 0;
      border-left: 1px solid var(--color-base-300);
      overflow-y: auto;
      background: transparent;
      padding: 0;
    }
    #detail-offcanvas::backdrop {
      display: none !important;
    }
  }

  #detail {
    width: 100%;
    padding: 6px;
  }

  #detail .fldname {
    font-weight: bold;
    color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
    font-size: 11px;
    margin-top: 6px;
  }

  .editor-frame {
    width: 100%;
    height: calc(100dvh - 120px);
    border: 0;
  }
</style>
<div id="browser" class="text-sm">
  <div id="browser-top" class="flex flex-wrap items-center gap-2 p-2 border-b border-base-300">
    <button
      class="btn btn-sm btn-outline md:hidden"
      type="button"
      onclick="document.getElementById('sidebar-offcanvas').showModal()"
    >
      {{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}
    </button>
    <input
      id="search"
      class="input input-sm grow md:grow-0"
      type="text"
      autofocus
      placeholder="{{ tr.actions_search() }}…"
      value="{{ query }}"
      data-on:keydown__enter__prevent="document.getElementById('search-trigger').click()"
    >
    <div class="inline-flex items-center gap-2">
      <span id="browser-status" class="text-base-content/60">{{ count_label }}</span>
      <span id="browser-selected-status" class="badge badge-neutral" style="display: none;"></span>
    </div>
    <div id="browser-actions" class="flex flex-wrap items-center gap-1 ms-auto">
      <button id="search-trigger" style="display:none" data-on:click__prevent="const q = document.getElementById('search').value; @post('/browse/search', {payload: {query: q}})"></button>
      <button id="refresh-trigger" style="display:none" data-on:click__prevent="@post('/browse/refresh')"></button>
      <button id="select-trigger" style="display:none" data-on:click__prevent="const cids = window.__ankiwebGetSel(); @post('/browse/select', {payload: {cids: cids}})"></button>

      <div class="join" role="group">
        <button
          id="btn-suspend"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/suspend')"
        >
          {{ tr.studying_suspend() }}
        </button>
        <button
          id="btn-unsuspend"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/unsuspend')"
        >
          {{ tr.actions_unbury_unsuspend() }}
        </button>
        <button
          id="btn-forget"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="@post('/browse/forget')"
        >
          {{ tr.actions_forget_card() }}
        </button>
        <button
          id="btn-setdue"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Due in days (e.g. 0, 3, 1-7):').then(function(x) { if (x !== null && x !== '') @post('/browse/setdue', {payload: {value: x}}); })"
        >
          {{ tr.actions_set_due_date() }}
        </button>
        <button
          id="btn-changedeck"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Move to deck:').then(function(x) { if (x !== null && x !== '') @post('/browse/changedeck', {payload: {deck: x}}); })"
        >
          {{ tr.browsing_change_deck() }}
        </button>
        <button
          id="btn-addtag"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Add tag:').then(function(x) { if (x !== null && x !== '') @post('/browse/addtag', {payload: {tag: x}}); })"
        >
          {{ tr.editing_tags_add() }}
        </button>
        <button
          id="btn-removetag"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="ankiwebPrompt('Remove tag:').then(function(x) { if (x !== null && x !== '') @post('/browse/removetag', {payload: {tag: x}}); })"
        >
          {{ tr.actions_remove_tag() }}
        </button>
        <button
          id="btn-delete"
          class="btn btn-sm btn-outline btn-error join-item hidden md:inline-flex"
          type="button"
          disabled
          data-on:click__prevent="ankiwebConfirm({{ (tr.browsing_delete_notes() ~ '?') | tojson | forceescape }}, {danger: true}).then(function(ok) { if (ok) @post('/browse/delete'); })"
        >
          {{ tr.actions_delete() }}
        </button>
        <button
          id="btn-cardinfo"
          class="btn btn-sm btn-outline join-item hidden md:inline-flex"
          type="button"
          disabled
          onclick="ankiwebCardInfo()"
        >
          {{ tr.actions_card_info() }}
        </button>

        <!-- Mobile dropdown collapsible -->
        <details id="mobile-actions-dropdown" class="dropdown dropdown-end md:hidden">
          <summary
            id="btn-actions-dropdown"
            class="btn btn-sm btn-outline"
            role="button"
          >
            {{ tr.studying_more() }}
          </summary>
          <ul class="dropdown-content menu bg-base-100 rounded-box shadow-sm z-50 p-2 w-48 text-sm">
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-suspend').click()">
                {{ tr.studying_suspend() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-unsuspend').click()">
                {{ tr.actions_unbury_unsuspend() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-forget').click()">
                {{ tr.actions_forget_card() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-setdue').click()">
                {{ tr.actions_set_due_date() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-changedeck').click()">
                {{ tr.browsing_change_deck() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-addtag').click()">
                {{ tr.editing_tags_add() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-removetag').click()">
                {{ tr.actions_remove_tag() }}
              </button>
            </li>
            <li><hr class="border-base-300 my-1"></li>
            <li>
              <button class="text-error" type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-delete').click()">
                {{ tr.actions_delete() }}
              </button>
            </li>
            <li>
              <button type="button" onclick="this.closest('details')?.removeAttribute('open'); document.getElementById('btn-cardinfo').click()">
                {{ tr.actions_card_info() }}
              </button>
            </li>
          </ul>
        </details>
      </div>
    </div>
  </div>

  <div id="browser-main">
    <!-- Sidebar in modal dialog on mobile, static pane on md+ -->
    <dialog
      id="sidebar-offcanvas"
      class="modal modal-bottom sm:modal-middle md:modal-open md:static md:h-full md:max-h-none md:bg-transparent md:border-0 md:p-0 md:shadow-none"
      aria-labelledby="sidebar-offcanvas-label"
    >
      <div class="modal-box p-0 md:max-w-none md:w-full md:h-full md:p-0 md:rounded-none md:shadow-none md:bg-transparent">
        <div class="flex justify-between items-center md:hidden border-b border-base-300 p-2">
          <h6 class="font-bold text-sm m-0" id="sidebar-offcanvas-label">{{ tr.browsing_sidebar_decks() }} &amp; {{ tr.browsing_sidebar_tags() }}</h6>
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button>
          </form>
        </div>
        <div class="p-0 overflow-y-auto">
          <div id="sidebar">{{ sidebar(decks, tags) }}</div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop md:hidden"><button>close</button></form>
    </dialog>
    <!-- Results table -->
    <div id="results-wrap">
      <table id="results" class="table table-sm mb-0">
        <thead class="sticky top-0 bg-base-100 z-10">
          <tr class="hidden md:table-row">
            <th class="cell-sortfield">{{ tr.browsing_sort_field() }}</th>
            <th class="cell-card">{{ tr.browsing_card() }}</th>
            <th class="cell-deck">{{ tr.decks_deck() }}</th>
            <th class="cell-due">{{ tr.statistics_due_date() }}</th>
            <th class="cell-tags hidden xl:table-cell">{{ tr.editing_tags() }}</th>
          </tr>
        </thead>
        <tbody id="results-body">{{ initial_rows | safe }}</tbody>
      </table>
    </div>
    <!-- Detail pane in modal dialog on mobile, static pane on md+ -->
    <dialog
      id="detail-offcanvas"
      class="modal modal-bottom sm:modal-middle md:modal-open md:static md:h-full md:max-h-none md:w-full md:bg-transparent md:border-0 md:p-0 md:shadow-none"
      aria-labelledby="detail-offcanvas-label"
    >
      <div class="modal-box p-0 max-w-full md:max-w-none md:w-full md:h-full md:p-0 md:rounded-none md:shadow-none md:bg-transparent">
        <div class="flex justify-between items-center md:hidden border-b border-base-300 p-2">
          <h6 class="font-bold text-sm m-0" id="detail-offcanvas-label">{{ tr.browsing_card() }} – {{ tr.importing_details() }}</h6>
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button>
          </form>
        </div>
        <div class="p-0 overflow-y-auto">
          <div id="detail"></div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop md:hidden"><button>close</button></form>
    </dialog>
  </div>
</div>
<script>
  (function() {
      window.__ankiwebOnOpchanges = function() {
          var btn = document.getElementById('refresh-trigger');
          if (btn) btn.click();
      };
      var _sel = [],
          _anchor = null;

      function _updateBulkButtons() {
          var count = _sel.length;
          var hasSel = count > 0;
          var actionIds = [
              'btn-suspend', 'btn-unsuspend', 'btn-forget', 'btn-setdue',
              'btn-changedeck', 'btn-addtag', 'btn-removetag', 'btn-delete',
              'btn-cardinfo'
          ];
          for (var i = 0; i < actionIds.length; i++) {
              var el = document.getElementById(actionIds[i]);
              if (el) el.disabled = !hasSel;
          }
          var moreSummary = document.getElementById('btn-actions-dropdown');
          var moreDetails = document.getElementById('mobile-actions-dropdown');
          if (moreSummary) {
              moreSummary.classList.toggle('btn-disabled', !hasSel);
              moreSummary.setAttribute('aria-disabled', !hasSel ? 'true' : 'false');
              if (!hasSel && moreDetails) {
                  moreDetails.removeAttribute('open');
              }
          }
          var selBadge = document.getElementById('browser-selected-status');
          if (selBadge) {
              if (hasSel) {
                  // Anki's window title "Browse (2 of 5480 cards selected)": take the parenthetical,
                  // substituting sentinel numbers so the text stays localized.
                  var tpl = {{ tr.browsing_window_title(total=987654, selected=123456) | tojson }};
                  var st = document.getElementById('browser-status');
                  var total = st ? parseInt(st.textContent, 10) : count;
                  var txt = tpl.replace(/[\u2068\u2069]/g, '')
                      .replace('123456', count).replace('987654', isNaN(total) ? count : total);
                  var m = txt.match(/\((.*)\)/);
                  selBadge.textContent = m ? m[1] : txt;
                  selBadge.style.display = 'inline-block';
              } else {
                  selBadge.style.display = 'none';
              }
          }
      }

      window.__ankiwebGetSel = function() {
          return _sel.map(function(x) { return parseInt(x); });
      };

      window.__ankiwebResetSel = function() {
          _sel = [];
          _anchor = null;
          _hl();
          _updateBulkButtons();
      };

      function _rows() {
          return Array.prototype.slice.call(
              document.querySelectorAll('#results-body tr[data-cid]'));
      }

      function _hl() {
          _rows().forEach(function(tr) {
              tr.classList.toggle('selected', _sel.indexOf(tr.dataset.cid) >= 0);
          });
      }

      function _selChanged() {
          _hl();
          _updateBulkButtons();
          var btn = document.getElementById('select-trigger');
          if (btn) btn.click();
      }

      function _openDetailOnMobile() {
          if (window.innerWidth < 768) {
              var panel = document.getElementById('detail-offcanvas');
              if (panel && typeof panel.showModal === 'function' && !panel.open) {
                  panel.showModal();
              }
          }
      }

      function _click(tr, e) {
          var cid = tr.dataset.cid,
              rs = _rows();
          if (e.shiftKey && _anchor !== null) {
              var i = rs.findIndex(function(r) {
                      return r.dataset.cid === _anchor;
                  }),
                  j = rs.findIndex(function(r) {
                      return r.dataset.cid === cid;
                  });
              if (i >= 0 && j >= 0) {
                  var lo = Math.min(i, j),
                      hi = Math.max(i, j);
                  _sel = rs.slice(lo, hi + 1).map(function(r) {
                      return r.dataset.cid;
                  });
              }
          } else if (e.ctrlKey || e.metaKey) {
              var k = _sel.indexOf(cid);
              if (k >= 0) _sel.splice(k, 1);
              else _sel.push(cid);
              _anchor = cid;
          } else {
              _sel = [cid];
              _anchor = cid;
          }
          _selChanged();
          if (_sel.length > 0) {
              _openDetailOnMobile();
          }
      }

      window.ankiwebCardInfo = function() {
          if (_sel.length) window.location.href = '/card-info/' + _sel[0];
      };

      document.getElementById('results-body').addEventListener('click', function(e) {
          var tr = e.target.closest('tr');
          if (tr && tr.dataset.cid) {
              _click(tr, e);
          }
      });

      document.getElementById('results-body').addEventListener('contextmenu', function(e) {
          if (e.ctrlKey) {
              e.preventDefault();
              var tr = e.target.closest('tr');
              if (tr && tr.dataset.cid) {
                  _click(tr, e);
              }
          }
      });

      // Close sidebar offcanvas on mobile when clicking an item
      var sidebarEl = document.getElementById('sidebar-offcanvas');
      if (sidebarEl) {
          sidebarEl.addEventListener('click', function(e) {
              if (e.target.closest('.side-item') && window.innerWidth < 768) {
                  if (typeof sidebarEl.close === 'function' && sidebarEl.open) {
                      sidebarEl.close();
                  }
              }
          });
      }

      // Close mobile dialogs when viewport crosses the md breakpoint
      if (window.matchMedia) {
          window.matchMedia('(min-width: 768px)').addEventListener('change', function(e) {
              if (e.matches) {
                  ['sidebar-offcanvas', 'detail-offcanvas'].forEach(function(id) {
                      var d = document.getElementById(id);
                      if (d && typeof d.close === 'function' && d.open) {
                          d.close();
                      }
                  });
              }
          });
      }

      // Initial state
      _updateBulkButtons();
  })();
</script>