<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/shell/static/app.css">
    <link rel="stylesheet" href="/shell/static/theme.css">
    <link rel="stylesheet" href="/shell/static/components.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <style>
      /* Anki's vendored SvelteKit editor bundle (editor.css/editor.js, untouched) sizes its
         internal scroll-area component via a `height: 100%` chain up to `html`/`body`; without
         an explicit height here that chain resolves to 0 (nested height:100% needs every
         ancestor sized), breaking the field scrollbar and rich-text-editable click activation
         on pages that embed the editor (/add, /editor). Harmless on every other page. */
      html, body {
        height: 100%;
      }
    </style>
    <script>
      /* night-mode: theme synchronized via the shell bootstrap.js and the daisyUI data-theme attribute */
      window.__ankiwebContext = {{ context | tojson }}
    </script>
    {% for c in css_files %}<link rel="stylesheet" href="/_anki/{{ c }}">{%
      endfor
    %}
    {% for j in js_files %}<script src="/_anki/{{ j }}"></script>{% endfor %}
    <script src="/shell/static/bootstrap.js"></script>
    <script src="/shell/static/dialogs.js"></script>
    <script type="module" src="/shell/static/datastar.js"></script>
  </head>
  <body class="context-{{ context }}">
    {% if toolbar %}{% include "_toolbar.html.jinja" %}{% endif %}{{
      body | safe
    }}
  </body>
</html>
