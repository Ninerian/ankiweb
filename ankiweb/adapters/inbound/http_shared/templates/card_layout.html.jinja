{% macro tmpl_block(tmpl) %}
  <div
    class="tmpl-block card p-3 mb-3"
    data-orig="{{ tmpl.ord }}"
  >
    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
      <label class="d-flex align-items-center gap-1 mb-0">
        <span class="small fw-semibold">{{ tr.actions_name() }}</span>
        <input type="text" class="tmpl-name form-control form-control-sm d-inline-block w-auto" value="{{ tmpl.name }}" size="24">
      </label>
      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="moveUp(this)">↑</button>
      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="moveDown(this)">↓</button>
      <button class="btn btn-sm btn-outline-danger" type="button" onclick="deleteBlock(this)">
        {{ tr.actions_delete() }}
      </button>
    </div>
    <div class="tmpl-label small fw-semibold mt-2 mb-1">
      {{ tr.card_templates_front_template() }}
    </div>
    <textarea class="tmpl-qfmt form-control font-monospace" rows="6"
    >{{ tmpl.qfmt }}</textarea>
    <div class="tmpl-label small fw-semibold mt-2 mb-1">
      {{ tr.card_templates_back_template() }}
    </div>
    <textarea class="tmpl-afmt form-control font-monospace" rows="6"
    >{{ tmpl.afmt }}</textarea>
  </div>
{% endmacro %}
<div class="card-layout container-fluid">
  <h3>Card Types</h3>
  <input type="hidden" id="ntid" value="{{ ntid }}">
  <form id="clf" onsubmit="return false">
    <div id="tmplblocks">
      {% for t in templates %}{{ tmpl_block(t) }}{% endfor %}
    </div>
    <div class="mt-2">
      <button class="btn btn-outline-secondary" type="button" id="addtmpl" onclick="addBlock()">
        {{ tr.card_templates_add_card_type() }}
      </button>
    </div>
    <div class="mt-3">
      <div class="tmpl-label small fw-semibold mb-1">{{ tr.card_templates_template_styling() }}</div>
      <textarea id="css" class="form-control font-monospace" rows="8">{{ css }}</textarea>
    </div>
    <div class="mt-3">
      <button class="btn btn-primary me-2" type="button" id="save" data-on:click__prevent="const payload = buildLayoutPayload(); @post('/card-layout/savelayout', {payload: payload})">
        {{ tr.actions_save() }}
      </button>
      <button class="btn btn-secondary me-2" type="button" data-on:click__prevent="@post('/card-layout/cancel')">
        {{ tr.actions_cancel() }}
      </button>
      <button
        class="btn btn-outline-secondary"
        type="button"
        id="preview"
        data-on:click__prevent="@post('/card-layout/previewlayout/' + document.getElementById('ntid').value)"
      >
        {{ tr.actions_preview() }}
      </button>
    </div>
    <div id="err" class="text-danger mt-2"></div>
  </form>
</div>
<template id="blankblock">{{
  tmpl_block({"ord": "new", "name": "", "qfmt": "", "afmt": ""})
}}</template>
<script>
  function addBlock() {
      var tpl = document.getElementById('blankblock');
      var block = tpl.content.firstElementChild.cloneNode(true);
      document.getElementById('tmplblocks').appendChild(block);
  }

  function deleteBlock(btn) {
      var b = btn.closest('.tmpl-block');
      b.parentNode.removeChild(b);
  }

  function moveUp(btn) {
      var b = btn.closest('.tmpl-block');
      var prev = b.previousElementSibling;
      if (prev) b.parentNode.insertBefore(prev, b);
  }

  function moveDown(btn) {
      var b = btn.closest('.tmpl-block');
      var next = b.nextElementSibling;
      if (next) b.parentNode.insertBefore(next, b);
  }

  function buildLayoutPayload() {
      document.getElementById('err').textContent = '';
      var blocks = Array.prototype.slice.call(
          document.querySelectorAll('#tmplblocks .tmpl-block'));
      var templates = blocks.map(function(b) {
          var orig = b.getAttribute('data-orig');
          return {
              orig: (orig === 'new') ? null : parseInt(orig),
              name: b.querySelector('.tmpl-name').value,
              qfmt: b.querySelector('.tmpl-qfmt').value,
              afmt: b.querySelector('.tmpl-afmt').value
          };
      });
      return {
          notetypeId: parseInt(document.getElementById('ntid').value),
          css: document.getElementById('css').value,
          templates: templates
      };
  }
</script>
