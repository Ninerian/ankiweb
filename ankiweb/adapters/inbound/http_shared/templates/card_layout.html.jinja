{% macro tmpl_block(tmpl) %}
  <div
    class="tmpl-block bg-base-100 border border-base-300 rounded-box p-4 mb-4 shadow-sm"
    data-orig="{{ tmpl.ord }}"
  >
    <div class="flex items-center flex-wrap gap-2 mb-3">
      <label class="flex items-center gap-2 mb-0">
        <span class="text-sm font-semibold">{{ tr.actions_name() }}</span>
        <input type="text" class="tmpl-name input input-sm inline-block w-auto" value="{{ tmpl.name }}" size="24">
      </label>
      <div class="join">
        <button class="btn btn-sm btn-outline join-item" type="button" onclick="moveUp(this)">↑</button>
        <button class="btn btn-sm btn-outline join-item" type="button" onclick="moveDown(this)">↓</button>
      </div>
      <button class="btn btn-sm btn-outline btn-error ms-auto sm:ms-0" type="button" onclick="deleteBlock(this)">
        {{ tr.actions_delete() }}
      </button>
    </div>
    <div class="tmpl-label text-sm font-semibold mt-2 mb-1">
      {{ tr.card_templates_front_template() }}
    </div>
    <textarea class="tmpl-qfmt textarea font-mono w-full" rows="6"
    >{{ tmpl.qfmt }}</textarea>
    <div class="tmpl-label text-sm font-semibold mt-2 mb-1">
      {{ tr.card_templates_back_template() }}
    </div>
    <textarea class="tmpl-afmt textarea font-mono w-full" rows="6"
    >{{ tmpl.afmt }}</textarea>
  </div>
{% endmacro %}
<div class="card-layout max-w-4xl mx-auto px-4 py-3">
  <h3 class="text-xl font-bold mb-3">Card Types</h3>
  <form id="clf" onsubmit="return false" data-signals='{{ {"notetypeId": ntid} | tojson }}'>
    <div id="tmplblocks">
      {% for t in templates %}{{ tmpl_block(t) }}{% endfor %}
    </div>
    <div class="mt-2">
      <button class="btn btn-outline" type="button" id="addtmpl" onclick="addBlock()">
        {{ tr.card_templates_add_card_type() }}
      </button>
    </div>
    <div class="mt-4">
      <div class="tmpl-label text-sm font-semibold mb-1">{{ tr.card_templates_template_styling() }}</div>
      <textarea id="css" class="textarea font-mono w-full" rows="8" data-bind="css">{{ css }}</textarea>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button class="btn btn-primary" type="button" id="save" data-on:click__prevent="const payload = buildLayoutPayload(); payload.notetypeId = $notetypeId; payload.css = $css; @post('/card-layout/savelayout', {payload: payload})">
        {{ tr.actions_save() }}
      </button>
      <button class="btn btn-neutral" type="button" data-on:click__prevent="@post('/card-layout/cancel')">
        {{ tr.actions_cancel() }}
      </button>
      <button
        class="btn btn-outline"
        type="button"
        id="preview"
        data-on:click__prevent="@post('/card-layout/previewlayout/' + $notetypeId)"
      >
        {{ tr.actions_preview() }}
      </button>
    </div>
    <div id="err" class="text-error text-sm font-semibold mt-2"></div>
  </form>
</div>
<template id="blankblock">{{
  tmpl_block({"ord": "new", "name": "", "qfmt": "", "afmt": ""})
}}</template>
<!-- Das Template-Array wird bewusst per Vanilla-JS/DOM gelesen, da Datastar v1.0.3 kein Listen-Rendering für dynamisch geklonte Templates bietet. -->
<script>
  function addBlock() {
      var tpl = document.getElementById('blankblock');
      var block = tpl.content.firstElementChild.cloneNode(true);
      document.getElementById('tmplblocks').appendChild(block);
  }

  function deleteBlock(btn) {
      var b = btn.closest('.tmpl-block');
      b.parentNode.removeChild(b);
  }

  function moveUp(btn) {
      var b = btn.closest('.tmpl-block');
      var prev = b.previousElementSibling;
      if (prev) b.parentNode.insertBefore(prev, b);
  }

  function moveDown(btn) {
      var b = btn.closest('.tmpl-block');
      var next = b.nextElementSibling;
      if (next) b.parentNode.insertBefore(next, b);
  }

  function buildLayoutPayload() {
      document.getElementById('err').textContent = '';
      var blocks = Array.prototype.slice.call(
          document.querySelectorAll('#tmplblocks .tmpl-block'));
      var templates = blocks.map(function(b) {
          var orig = b.getAttribute('data-orig');
          return {
              orig: (orig === 'new') ? null : parseInt(orig),
              name: b.querySelector('.tmpl-name').value,
              qfmt: b.querySelector('.tmpl-qfmt').value,
              afmt: b.querySelector('.tmpl-afmt').value
          };
      });
      return {
          templates: templates
      };
  }
</script>
