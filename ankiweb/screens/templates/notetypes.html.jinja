<div class="notetypes">
  <h3>{{ heading }}</h3>
  <table id="nttbl" border="1" cellpadding="6" cellspacing="0">
    <tbody id="ntrows">
      {% for r in rows %}
        <tr class="nt-row" data-id="{{ r.id }}" data-name="{{ r.name }}">
          <td class="nt-name">{{ r.name }}</td>
          <td class="nt-count">{{ r.count }} notes</td>
          <td><a href="/fields/{{ r.id }}">{{ L_fields }}</a></td>
          <td><a href="/card-layout/{{ r.id }}">{{ L_cards }}</a></td>
          <td>
            <button type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; const cur = this.closest('.nt-row').getAttribute('data-name'); const name = prompt('New name:', cur); if (name) @post('/notetypes/rename/{{ r.id }}', {payload: {name: name}})">
              {{ L_rename }}
            </button>
          </td>
          <td>
            <button type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; if (confirm('Delete this note type and its {{ r.count }} note(s)?')) @post('/notetypes/delete/{{ r.id }}')">
              {{ L_delete }}
            </button>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <div id="ntadd" style="margin-top:16px;">
    <h4>{{ L_add }}</h4>
    <label>
      {{ L_name }}
      <input type="text" id="ntnewname" size="24">
    </label>
    <select id="ntbase">
      {% for r in rows %}<option value="{{ r.id }}">{{ r.name }}</option>{%
        endfor
      %}
    </select>
    <button type="button" data-on:click__prevent="document.getElementById('err').textContent = ''; const name = document.getElementById('ntnewname').value; const base = document.getElementById('ntbase').value; if (name && base) @post('/notetypes/add/' + base, {payload: {name: name}})">{{ L_add }}</button>
  </div>
  <div id="err" style="color:#c00;margin-top:8px;"></div>
</div>
