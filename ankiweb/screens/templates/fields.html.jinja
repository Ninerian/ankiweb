{% macro field_row(field, sortf) %}
  <tr class="field-row" data-orig="{{ field.ord }}">
    <td>
      <label>
        {{ tr.actions_name() }}
        <input type="text" class="fld-name" value="{{ field.name }}" size="16">
      </label>
    </td>
    <td>
      <label>
        {{ tr.fields_editing_font() }}
        <input type="text" class="fld-font" value="{{ field.font }}" size="10">
      </label>
    </td>
    <td>
      <label>
        {{ tr.fields_size() }}
        <input
          type="number"
          class="fld-size"
          value="{{ field.size }}"
          min="1"
          style="width:5em"
        >
      </label>
    </td>
    <td>
      <label><input
          type="checkbox"
          class="fld-rtl"
          {% if field.rtl %}
            checked
          {% endif %}
        > {{ tr.fields_reverse_text_direction_rtl() }}</label>
    </td>
    <td>
      <label>
        {{ tr.fields_description() }}
        <input
          type="text"
          class="fld-desc"
          value="{{ field.description }}"
          size="16"
        >
      </label>
    </td>
    <td>
      <label><input
          type="radio"
          name="sortf"
          class="fld-sort"
          {% if field.ord == sortf %}
            checked
          {% endif %}
        > {{ tr.browsing_sort_field() }}</label>
    </td>
    <td>
      <button type="button" onclick="moveUp(this)">↑</button>
      <button type="button" onclick="moveDown(this)">↓</button>
      <button type="button" onclick="deleteRow(this)">
        {{ tr.actions_delete() }}
      </button>
    </td>
  </tr>
{% endmacro %}
<div class="fields">
  <h3>Fields</h3>
  <input type="hidden" id="ntid" value="{{ ntid }}">
  <form id="ff" onsubmit="return false">
    <table id="fieldtbl">
      <tbody id="fieldrows">
        {% for f in fields %}{{ field_row(f, sortf) }}{% endfor %}
      </tbody>
    </table>
    <div style="margin-top:8px;">
      <button type="button" id="addfield" onclick="addRow()">
        {{ add_label }}
      </button>
    </div>
    <div style="margin-top:10px;">
      <button type="button" id="save" data-on:click__prevent="const payload = buildFieldsPayload(); @post('/fields/savefields', {payload: payload})">
        {{ save_label }}
      </button>
      <button type="button" data-on:click__prevent="@post('/fields/cancel')">
        {{ cancel_label }}
      </button>
    </div>
    <div id="err" style="color:#c00;margin-top:8px;"></div>
  </form>
</div>
<template id="blankrow">{{
  field_row({'ord': 'new', 'name': '', 'font': 'Arial', 'size': 20, 'rtl': False, 'description': ''}, -1)
}}</template>
<script>
  function addRow() {
      var tpl = document.getElementById('blankrow');
      var tr = tpl.content.firstElementChild.cloneNode(true);
      document.getElementById('fieldrows').appendChild(tr);
  }

  function deleteRow(btn) {
      var tr = btn.closest('tr');
      tr.parentNode.removeChild(tr);
  }

  function moveUp(btn) {
      var tr = btn.closest('tr');
      var prev = tr.previousElementSibling;
      if (prev) tr.parentNode.insertBefore(tr, prev);
  }

  function moveDown(btn) {
      var tr = btn.closest('tr');
      var next = tr.nextElementSibling;
      if (next) tr.parentNode.insertBefore(next, tr);
  }

  function buildFieldsPayload() {
      document.getElementById('err').textContent = '';
      var rows = Array.prototype.slice.call(
          document.querySelectorAll('#fieldrows .field-row'));
      var sortf = 0;
      var fields = rows.map(function(tr, i) {
          if (tr.querySelector('.fld-sort').checked) sortf = i;
          var orig = tr.getAttribute('data-orig');
          return {
              orig: (orig === 'new') ? null : parseInt(orig),
              name: tr.querySelector('.fld-name').value,
              font: tr.querySelector('.fld-font').value,
              size: parseInt(tr.querySelector('.fld-size').value || '20'),
              rtl: tr.querySelector('.fld-rtl').checked,
              description: tr.querySelector('.fld-desc').value
          };
      });
      return {
          notetypeId: parseInt(document.getElementById('ntid').value),
          sortf: sortf,
          fields: fields
      };
  }
</script>
