<center class="congrats">
  <h1>{{ heading }}</h1>
  {% if learn_remaining_mins %}<p>
      The next learning card will be ready in {{ learn_remaining_mins }}
      minute(s).
    </p>{% endif %}
  {% if show_unbury %}<p>
      <button type="button" onclick='pycmd("unbury")'>
        {{ tr.studying_unbury() }}
      </button> buried cards.
    </p>{% endif %}
  <p><button type="button" onclick='pycmd("decks")'>Back to Decks</button></p>
</center>
