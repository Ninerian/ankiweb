<div class='tools'>
  <h3>Tools</h3>
  <section style='margin-bottom:16px;'>
    <button type='button' onclick="pycmd('checkdb')">{{ checkdb_label }}</button>
    <div id='res-db'></div>
  </section>
  <section style='margin-bottom:16px;'>
    <button type='button' onclick="pycmd('checkmedia')">{{ checkmedia_label }}</button>
    <div id='res-media'></div>
  </section>
  <section style='margin-bottom:16px;'>
    <button type='button' onclick="pycmd('emptycards')">{{ emptycards_label }}</button>
    <div id='res-empty'></div>
  </section>
  <p><a href='/notetypes'>{{ notetypes_label }}</a></p>
</div>
<script>
window.ankiwebToolsResult=function(which,html){var m={db:'res-db',media:'res-media',empty:'res-empty'};var d=document.getElementById(m[which]);if(d)d.innerHTML=html;};
</script>